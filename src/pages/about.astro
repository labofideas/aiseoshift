---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="AISEOShift covers AI visibility, answer engine optimization, and the editorial systems SEO teams need in the AI search era." />
		<style>
			.about-page {
				width: min(1080px, calc(100% - 2rem));
				margin: 0 auto;
				padding: var(--space-7) 0 var(--space-9);
			}

			.about-hero {
				padding: var(--space-7) 0 var(--space-8);
				border-bottom: 1px solid var(--line);
				display: grid;
				grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
				gap: var(--space-7);
				align-items: end;
			}

			.about-hero h1 {
				font-size: clamp(2.4rem, 4.6vw, 4rem);
				line-height: 1;
				letter-spacing: -0.03em;
				font-weight: 600;
				margin: var(--space-4) 0 0;
				max-width: 16ch;
			}

			.about-hero-lede p {
				font-size: 1.1rem;
				line-height: 1.6;
				color: rgba(var(--ink), 0.78);
				max-width: var(--measure);
				margin: 0;
			}

			.about-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
				gap: var(--space-7);
				padding: var(--space-8) 0;
				border-bottom: 1px solid var(--line);
			}

			.about-grid h2 {
				font-size: clamp(1.5rem, 2.2vw, 2rem);
				margin: 0 0 var(--space-4);
				letter-spacing: -0.022em;
				font-weight: 600;
			}

			.about-grid p {
				font-size: 1rem;
				line-height: 1.7;
				color: rgba(var(--ink), 0.82);
				margin: 0 0 var(--space-4);
				max-width: 38rem;
			}

			.about-grid aside ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.about-grid aside li {
				font-size: 0.95rem;
				line-height: 1.4;
				color: rgba(var(--ink), 0.82);
				padding: var(--space-3) 0;
				border-bottom: 1px solid var(--line);
			}

			.about-grid aside li:first-child {
				border-top: 1px solid var(--line);
			}

			.about-values {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--space-7);
				padding: var(--space-8) 0 0;
			}

			.about-values .value-block {
				padding-top: var(--space-4);
				border-top: 1px solid var(--line-strong);
			}

			.about-values h3 {
				font-size: 1.15rem;
				margin: 0 0 var(--space-3);
				letter-spacing: -0.012em;
				font-weight: 600;
			}

			.about-values p {
				font-size: 0.95rem;
				line-height: 1.6;
				color: var(--ink-muted);
				margin: 0;
				max-width: 28rem;
			}

			@media (max-width: 860px) {
				.about-hero,
				.about-grid,
				.about-values {
					grid-template-columns: 1fr;
					gap: var(--space-5);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="about-page">
			<section class="about-hero">
				<div>
					<p class="section-kicker">About</p>
					<h1>Covering the shift from rankings to AI visibility.</h1>
				</div>
				<div class="about-hero-lede">
					<p>
						AISEOShift is an editorial publication focused on how search is changing. We cover AI visibility,
						answer engine optimization, generative engine optimization, citation mechanics, and the practical
						strategies teams need as AI systems increasingly mediate how people discover information.
					</p>
				</div>
			</section>

			<section class="about-grid">
				<div>
					<h2>What we cover</h2>
					<p>
						Our coverage spans the full AI search landscape: from how Google AI Overviews select sources
						to how ChatGPT and Perplexity cite content differently. We publish strategy frameworks,
						research with real data, practical playbooks, and tool evaluations.
					</p>
					<p>
						Every article is written to be useful both for SEO practitioners adapting to AI search and
						for general audiences trying to understand how search is evolving. We avoid hype, focus on
						evidence, and publish only what we can back with data or direct analysis.
					</p>
				</div>
				<aside>
					<h2>Coverage areas</h2>
					<ul>
						<li>AI visibility and citation mechanics</li>
						<li>Answer Engine Optimization (AEO)</li>
						<li>Generative Engine Optimization (GEO)</li>
						<li>Google AI Overviews strategy</li>
						<li>Content structure for AI extraction</li>
						<li>SEO tools and workflow comparisons</li>
						<li>AI search trends and data</li>
					</ul>
				</aside>
			</section>

			<section class="about-values">
				<div class="value-block">
					<h3>Evidence first</h3>
					<p>Every claim is backed by data, research, or direct analysis. We cite our sources and show our reasoning.</p>
				</div>
				<div class="value-block">
					<h3>Practical focus</h3>
					<p>Strategy without action is theory. Every article includes actionable steps teams can implement immediately.</p>
				</div>
				<div class="value-block">
					<h3>No hype</h3>
					<p>We report what is actually changing in search, not what generates the most clicks. Direct language, honest analysis.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
