---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/tools.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free Image SEO Checker | ${SITE_TITLE}`}
			description="Audit every image on a page for alt text, width/height, lazy loading, and modern formats (WebP/AVIF). Free SEO and Core Web Vitals tool."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="tool-page">
			<a href="/tools" class="tool-back">← All Tools</a>
			<div class="tool-header">
				<p class="section-kicker">Performance + SEO</p>
				<h1>Image SEO Checker</h1>
				<p>Audit every <code>&lt;img&gt;</code> tag on a page for alt text, dimensions, lazy loading, and modern formats. Helps fix accessibility and Core Web Vitals issues.</p>
			</div>

			<div class="tool-input-card">
				<div class="input-tabs" role="tablist" aria-label="Input mode">
					<button class="tab-btn" role="tab" aria-selected="true" data-tab="url" type="button">URL</button>
					<button class="tab-btn" role="tab" aria-selected="false" data-tab="html" type="button">Paste HTML</button>
				</div>
				<div class="tab-panel active" id="tab-url" role="tabpanel">
					<div class="tool-field">
						<label for="url-input">Page URL</label>
						<input id="url-input" type="url" placeholder="https://example.com/page" autocomplete="url" />
					</div>
				</div>
				<div class="tab-panel" id="tab-html" role="tabpanel">
					<div class="tool-field">
						<label for="html-input">Raw HTML</label>
						<textarea id="html-input" placeholder="Paste the page's HTML source"></textarea>
					</div>
				</div>
				<div class="tool-actions">
					<button class="btn-primary" id="analyze-btn" type="button">Analyze</button>
					<button class="btn-secondary" id="clear-btn" type="button">Clear</button>
				</div>
				<div class="tool-status" id="tool-status" role="status" aria-live="polite"></div>
			</div>

			<section class="report" id="report" aria-live="polite"></section>
		</main>
		<Footer />

		<script>
			const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
			const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
			const urlInput = document.getElementById('url-input') as HTMLInputElement;
			const htmlInput = document.getElementById('html-input') as HTMLTextAreaElement;
			const analyzeBtn = document.getElementById('analyze-btn') as HTMLButtonElement;
			const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
			const statusEl = document.getElementById('tool-status')!;
			const reportEl = document.getElementById('report')!;
			let activeTab: 'url' | 'html' = 'url';

			tabBtns.forEach((b) =>
				b.addEventListener('click', () => {
					tabBtns.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
					tabPanels.forEach((p) => p.classList.toggle('active', p.id === `tab-${b.dataset.tab}`));
					activeTab = b.dataset.tab as 'url' | 'html';
					statusEl.textContent = '';
					statusEl.classList.remove('error');
				}),
			);

			const setStatus = (t: string, err = false) => { statusEl.textContent = t; statusEl.classList.toggle('error', err); };
			const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

			async function fetchPage(url: string) {
				const res = await fetch(`/api/fetch-page?url=${encodeURIComponent(url)}`);
				if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || `Fetch failed (${res.status})`); }
				return res.json();
			}

			function analyze(html: string) {
				const doc = new DOMParser().parseFromString(html, 'text/html');
				const imgs = Array.from(doc.querySelectorAll('img'));
				const issues: { label: string; status: 'pass' | 'warn' | 'fail'; detail: string }[] = [];

				if (imgs.length === 0) {
					issues.push({ label: 'No images found', status: 'warn', detail: 'This page has no <img> tags.' });
					return { total: 0, issues, images: [], stats: { noAlt: 0, noDim: 0, noLazy: 0, nonModern: 0 } };
				}

				let noAlt = 0, noDim = 0, noLazy = 0, nonModern = 0;
				const imageData = imgs.map((img, idx) => {
					const src = img.getAttribute('src') || '';
					const alt = img.getAttribute('alt');
					const width = img.getAttribute('width');
					const height = img.getAttribute('height');
					const loading = img.getAttribute('loading');
					const ext = (src.split('?')[0].split('#')[0].split('.').pop() || '').toLowerCase();
					const hasAlt = alt !== null && alt.trim() !== '';
					const hasDim = !!width && !!height;
					const hasLazy = loading === 'lazy';
					const isFirst = idx === 0;
					const isModern = ext === 'webp' || ext === 'avif' || ext === 'svg' || src.startsWith('data:');
					if (!hasAlt) noAlt++;
					if (!hasDim) noDim++;
					if (!hasLazy && !isFirst) noLazy++;
					if (!isModern && ext) nonModern++;
					return { src, alt: hasAlt, dim: hasDim, lazy: hasLazy, modern: isModern, format: ext || '?', isFirst };
				});

				issues.push(noAlt === 0
					? { label: 'Alt text', status: 'pass', detail: `All ${imgs.length} images have alt text.` }
					: { label: 'Alt text', status: 'fail', detail: `${noAlt} of ${imgs.length} images missing alt text. Critical for accessibility and SEO.` });

				issues.push(noDim === 0
					? { label: 'Dimensions', status: 'pass', detail: 'All images have width and height attributes.' }
					: { label: 'Dimensions', status: 'warn', detail: `${noDim} images missing width/height. Causes Cumulative Layout Shift.` });

				issues.push(noLazy === 0
					? { label: 'Lazy loading', status: 'pass', detail: 'Below-the-fold images use lazy loading.' }
					: { label: 'Lazy loading', status: 'warn', detail: `${noLazy} below-the-fold images without loading="lazy".` });

				issues.push(nonModern === 0
					? { label: 'Modern formats', status: 'pass', detail: 'All images use WebP, AVIF, SVG, or data URIs.' }
					: { label: 'Modern formats', status: 'warn', detail: `${nonModern} images use legacy formats. Convert to WebP/AVIF for better LCP.` });

				const firstImg = imageData[0];
				if (firstImg && !firstImg.lazy) issues.push({ label: 'Hero image (LCP)', status: 'pass', detail: 'First image loads eagerly — good for LCP.' });

				return { total: imgs.length, issues, images: imageData, stats: { noAlt, noDim, noLazy, nonModern } };
			}

			function score(stats: { noAlt: number; noDim: number; noLazy: number; nonModern: number }, total: number) {
				if (total === 0) return 0;
				const deductions = (stats.noAlt / total) * 50 + (stats.noDim / total) * 25 + (stats.noLazy / total) * 15 + (stats.nonModern / total) * 15;
				return Math.max(0, Math.round(100 - deductions));
			}

			function render(data: ReturnType<typeof analyze>, source: string) {
				const s = score(data.stats, data.total);
				const tier = s >= 80 ? 'good' : s >= 55 ? 'fair' : 'poor';
				const iconMap = { pass: '✓', warn: '!', fail: '✕' };

				let html = `
					<header class="report-header">
						<div class="score-badge score-${tier}" aria-label="Score ${s} out of 100">${data.total === 0 ? '–' : s}</div>
						<div class="report-title">
							<h2>Image SEO report</h2>
							<p>${escapeHtml(source)} · ${data.total} image${data.total === 1 ? '' : 's'} analyzed</p>
						</div>
					</header>

					<div class="stat-row">
						<div class="stat"><span class="stat-num">${data.total}</span><span class="stat-label">Images</span></div>
						<div class="stat"><span class="stat-num">${data.stats.noAlt}</span><span class="stat-label">Missing alt</span></div>
						<div class="stat"><span class="stat-num">${data.stats.noDim}</span><span class="stat-label">No dimensions</span></div>
						<div class="stat"><span class="stat-num">${data.stats.nonModern}</span><span class="stat-label">Legacy format</span></div>
					</div>

					<div class="report-section">
						<h3>Checks</h3>
						<ul class="issue-list">
							${data.issues.map((i) => `
								<li class="issue">
									<span class="issue-icon ${i.status}" aria-hidden="true">${iconMap[i.status]}</span>
									<div class="issue-body">
										<p class="issue-label">${escapeHtml(i.label)}</p>
										<p class="issue-detail">${escapeHtml(i.detail)}</p>
									</div>
								</li>
							`).join('')}
						</ul>
					</div>
				`;

				if (data.images.length > 0) {
					html += `
						<div class="report-section">
							<h3>Per-image details</h3>
							<table class="report-table">
								<thead><tr><th>#</th><th>Source</th><th>Alt</th><th>W×H</th><th>Lazy</th><th>Format</th></tr></thead>
								<tbody>
									${data.images.map((img, i) => `
										<tr>
											<td>${i + 1}</td>
											<td style="max-width:280px;word-break:break-all">${escapeHtml(img.src.length > 80 ? img.src.slice(0, 80) + '…' : img.src)}</td>
											<td class="${img.alt ? 'flag-pass' : 'flag-fail'}">${img.alt ? 'Yes' : 'No'}</td>
											<td class="${img.dim ? 'flag-pass' : 'flag-warn'}">${img.dim ? 'Yes' : 'No'}</td>
											<td class="${img.lazy || img.isFirst ? 'flag-pass' : 'flag-warn'}">${img.isFirst ? 'Eager (hero)' : img.lazy ? 'Yes' : 'No'}</td>
											<td class="${img.modern ? 'flag-pass' : 'flag-warn'}">${img.format}</td>
										</tr>
									`).join('')}
								</tbody>
							</table>
						</div>
					`;
				}

				reportEl.innerHTML = html;
				reportEl.classList.add('visible');
				reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			async function run() {
				analyzeBtn.disabled = true;
				try {
					let html: string;
					let source: string;
					if (activeTab === 'url') {
						const u = urlInput.value.trim();
						if (!u) { setStatus('Enter a URL to analyze.', true); return; }
						setStatus('Fetching page…');
						const r = await fetchPage(u);
						html = r.html;
						source = r.url;
					} else {
						html = htmlInput.value.trim();
						if (!html) { setStatus('Paste HTML to analyze.', true); return; }
						source = 'Pasted HTML';
					}
					setStatus('');
					render(analyze(html), source);
				} catch (err) {
					setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
					reportEl.classList.remove('visible'); reportEl.innerHTML = '';
				} finally {
					analyzeBtn.disabled = false;
				}
			}

			analyzeBtn.addEventListener('click', run);
			urlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); run(); } });
			clearBtn.addEventListener('click', () => {
				urlInput.value = ''; htmlInput.value = '';
				reportEl.innerHTML = ''; reportEl.classList.remove('visible'); setStatus('');
			});
		</script>
	</body>
</html>
