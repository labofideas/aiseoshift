---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_URL } from '../../consts';
import '../../styles/tools-polish.css';

const toolSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Image SEO Checker',
	url: `${SITE_URL}/tools/image-checker/`,
	applicationCategory: 'SEO Tool',
	operatingSystem: 'Any',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	featureList: 'Alt text audit, image format detection, lazy loading check, Core Web Vitals image analysis, WebP/AVIF detection',
	provider: { '@id': `${SITE_URL}/#organization` },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free Image SEO Checker | ${SITE_TITLE}`}
			description="Audit every image on a page for alt text, width/height, lazy loading, and modern formats (WebP/AVIF). Helps fix accessibility and Core Web Vitals issues."
			structuredData={toolSchema}
		/>
		<style is:global>
			:root {
				--ic-cream: rgba(var(--paper-strong), 0.6); --ic-cream-2: rgba(var(--paper-strong), 0.9); --ic-cream-3: rgba(var(--ink), 0.06);
				--ic-white: rgb(var(--paper)); --ic-paper: rgb(var(--paper));
				--ic-ink: rgb(var(--ink)); --ic-ink-2: rgba(var(--ink), 0.85); --ic-ink-3: rgba(var(--ink), 0.62); --ic-ink-4: rgba(var(--ink), 0.45);
				--ic-border: var(--line); --ic-border-2: rgba(var(--ink), 0.18);
				--ic-rust: var(--signal-deep); --ic-rust-2: var(--signal); --ic-rust-bg: color-mix(in srgb, var(--signal-deep) 10%, transparent);
				--ic-green: #1A7A4F; --ic-green-bg: rgba(26,122,79,0.12);
				--ic-amber: #B07A00; --ic-amber-bg: rgba(176,122,0,0.12);
				--ic-red: #B82828; --ic-red-bg: rgba(184,40,40,0.10);
				--ic-blue: #2A5B96; --ic-blue-bg: rgba(42,91,150,0.10);
				--ic-purple: #5A2796; --ic-purple-bg: rgba(90,39,150,0.10);
				--ic-teal: #0F4A52; --ic-teal-bg: rgba(15,74,82,0.10);
				--ic-gray: #5b5550; --ic-gray-bg: rgba(91,85,80,0.10);
				--ic-dark-card: rgb(var(--ink));
				--ic-webp: var(--ic-teal); --ic-webp-bg: var(--ic-teal-bg);
				--ic-avif: var(--ic-purple); --ic-avif-bg: var(--ic-purple-bg);
				--ic-svg: var(--ic-blue); --ic-svg-bg: var(--ic-blue-bg);
				--ic-jpg: var(--ic-amber); --ic-jpg-bg: var(--ic-amber-bg);
				--ic-png: var(--ic-gray); --ic-png-bg: var(--ic-gray-bg);
				--ic-gif: var(--ic-red); --ic-gif-bg: var(--ic-red-bg);
			}
			[data-theme="dark"] {
				--ic-green: #4ade80; --ic-amber: #fbbf24; --ic-red: #f87171; --ic-blue: #93c5fd; --ic-purple: #c4b5fd; --ic-teal: #5eead4; --ic-gray: #b9b3ad;
				--ic-webp: #5eead4; --ic-avif: #c4b5fd; --ic-svg: #93c5fd; --ic-jpg: #fbbf24; --ic-png: #b9b3ad; --ic-gif: #f87171;
			}

			.ic-page { font-family: 'Atkinson', 'Trebuchet MS', sans-serif; }

			.ic-header { background: var(--ic-cream-2); border-bottom: 1px solid var(--ic-border); padding: 2.5rem 2rem 2rem; }
			.ic-header-inner { width: min(1100px, 100%); margin: 0 auto; }
			.ic-breadcrumb { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ic-rust); font-weight: 700; margin-bottom: 0.5rem; }
			.ic-breadcrumb a { color: inherit; text-decoration: none; }
			.ic-breadcrumb a:hover { text-decoration: underline; }
			.ic-header h1 { font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; margin: 0 0 0.55rem; }
			.ic-header p { font-size: 0.97rem; color: var(--ic-ink-3); max-width: 620px; line-height: 1.65; margin: 0; }
			.ic-header p code { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.85rem; background: var(--ic-cream-3); padding: 0.05rem 0.35rem; border-radius: 4px; color: var(--ic-ink); }

			.ic-input-wrap { background: var(--ic-cream-2); border-bottom: 1px solid var(--ic-border); padding: 1.25rem 2rem 1.75rem; }
			.ic-input-card { width: min(720px, 100%); margin: 0 auto; background: var(--ic-cream); border: 1px solid var(--ic-border-2); border-radius: 14px; padding: 1.25rem; }
			.ic-input-tabs { display: flex; gap: 0.25rem; margin-bottom: 0.85rem; }
			.ic-tab-btn { background: transparent; border: 1px solid var(--ic-border); color: var(--ic-ink-3); font-size: 0.78rem; font-weight: 700; padding: 0.4rem 0.85rem; border-radius: 8px; cursor: pointer; font-family: inherit; }
			.ic-tab-btn[aria-selected="true"] { background: var(--ic-ink); color: var(--ic-paper); border-color: var(--ic-ink); }
			.ic-tab-panel { display: none; }
			.ic-tab-panel.active { display: block; }
			.ic-input-row { display: grid; grid-template-columns: 1fr auto auto; gap: 0.5rem; margin-bottom: 0.4rem; }
			@media (max-width: 720px) { .ic-input-row { grid-template-columns: 1fr; } }
			.ic-url-input { background: var(--ic-paper); border: 1.5px solid var(--ic-border-2); border-radius: 9px; padding: 0.65rem 0.95rem; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.84rem; color: var(--ic-ink); outline: none; }
			.ic-html-input { width: 100%; background: var(--ic-paper); border: 1.5px solid var(--ic-border-2); border-radius: 9px; padding: 0.65rem 0.95rem; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.8rem; color: var(--ic-ink); resize: vertical; min-height: 120px; box-sizing: border-box; margin-bottom: 0.7rem; }
			.ic-url-input:focus, .ic-html-input:focus { border-color: var(--ic-rust); outline: 2px solid color-mix(in srgb, var(--ic-rust) 35%, transparent); outline-offset: 1px; }
			.ic-btn-run { background: var(--ic-rust); color: #fff; border: none; border-radius: 9px; padding: 0.65rem 1.3rem; font-family: inherit; font-size: 0.88rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
			.ic-btn-run:hover { opacity: 0.92; }
			.ic-btn-run:disabled { opacity: 0.55; cursor: default; }
			.ic-btn-clear { background: transparent; border: 1.5px solid var(--ic-border-2); border-radius: 9px; padding: 0.65rem 1rem; font-family: inherit; font-size: 0.88rem; color: var(--ic-ink-3); font-weight: 600; cursor: pointer; white-space: nowrap; }
			.ic-status { margin-top: 0.7rem; font-size: 0.85rem; color: var(--ic-ink-3); min-height: 1.1em; }
			.ic-status.error { color: var(--ic-red); }
			.ic-status.loading::after { content: ''; display: inline-block; width: 0.5rem; height: 0.5rem; margin-left: 0.4rem; border-radius: 50%; background: var(--ic-rust); animation: ic-pulse 1.1s ease-in-out infinite; }
			@keyframes ic-pulse { 50% { opacity: 0.35; } }

			.ic-report { display: none; }
			.ic-report.visible { display: block; }

			.ic-report-toolbar { display: none; justify-content: flex-end; margin-top: 1.5rem; }
			.ic-report-toolbar.visible { display: flex; }
			.ic-btn-download {
				background: transparent;
				border: 1.5px solid var(--ic-border-2);
				border-radius: 9px;
				padding: 0.65rem 1.1rem;
				font-family: inherit;
				font-size: 0.88rem;
				color: var(--ic-ink-3);
				font-weight: 600;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
			}
			.ic-btn-download:hover { background: var(--ic-paper); }
			.ic-btn-download:disabled { opacity: 0.55; cursor: default; }

			.ic-stat-bar { background: var(--ic-white); border-bottom: 1px solid var(--ic-border); border-top: 1px solid var(--ic-border); }
			.ic-stat-inner { width: min(1100px, calc(100% - 2rem)); margin: 0 auto; display: grid; grid-template-columns: repeat(6, 1fr); gap: 0; }
			.ic-stat-tile { padding: 1rem 0.9rem; border-right: 1px solid var(--ic-border); }
			.ic-stat-tile:last-child { border-right: 0; }
			.ic-stat-val { font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-size: 1.75rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em; margin-bottom: 0.15rem; }
			.ic-stat-lbl { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ic-ink-3); font-weight: 700; }
			.ic-stat-val.ok { color: var(--ic-green); }
			.ic-stat-val.warn { color: var(--ic-amber); }
			.ic-stat-val.bad { color: var(--ic-red); }
			.ic-stat-val.ink { color: var(--ic-ink); }
			.ic-stat-val.rust { color: var(--ic-rust); }

			@media (max-width: 880px) {
				.ic-stat-inner { grid-template-columns: repeat(3, 1fr); }
				.ic-stat-tile { border-bottom: 1px solid var(--ic-border); }
				.ic-stat-tile:nth-child(3n) { border-right: 0; }
			}

			.ic-layout { width: min(1100px, calc(100% - 2rem)); margin: 0 auto; padding: 1.75rem 0 4rem; display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 1.25rem; align-items: start; }
			.ic-sidebar { position: sticky; top: 5rem; display: flex; flex-direction: column; gap: 0.85rem; }

			.ic-side-card { background: var(--ic-white); border: 1px solid var(--ic-border); border-radius: 14px; overflow: hidden; }
			.ic-side-head { padding: 0.7rem 1rem; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.13em; font-weight: 700; color: var(--ic-ink-4); background: var(--ic-cream); border-bottom: 1px solid var(--ic-border); }
			.ic-side-body { padding: 0.65rem 0.85rem; display: flex; flex-direction: column; gap: 0.4rem; }
			.ic-fmt-pill { display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0.6rem; border-radius: 7px; border: 1px solid; font-size: 0.76rem; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; }
			.ic-fmt-pill.webp { color: var(--ic-webp); background: var(--ic-webp-bg); border-color: color-mix(in srgb, var(--ic-webp) 28%, transparent); }
			.ic-fmt-pill.avif { color: var(--ic-avif); background: var(--ic-avif-bg); border-color: color-mix(in srgb, var(--ic-avif) 28%, transparent); }
			.ic-fmt-pill.svg { color: var(--ic-svg); background: var(--ic-svg-bg); border-color: color-mix(in srgb, var(--ic-svg) 28%, transparent); }
			.ic-fmt-pill.jpg { color: var(--ic-jpg); background: var(--ic-jpg-bg); border-color: color-mix(in srgb, var(--ic-jpg) 28%, transparent); }
			.ic-fmt-pill.png { color: var(--ic-png); background: var(--ic-png-bg); border-color: color-mix(in srgb, var(--ic-png) 25%, transparent); }
			.ic-fmt-pill.gif { color: var(--ic-gif); background: var(--ic-gif-bg); border-color: color-mix(in srgb, var(--ic-gif) 25%, transparent); }
			.ic-fmt-pill .ic-fmt-name { font-weight: 700; letter-spacing: 0.02em; }
			.ic-fmt-pill .ic-fmt-count { font-weight: 700; }
			.ic-fmt-sep { display: flex; align-items: center; gap: 0.45rem; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ic-ink-4); margin-top: 0.3rem; font-weight: 700; }
			.ic-fmt-sep::before, .ic-fmt-sep::after { content: ''; flex: 1; height: 1px; background: var(--ic-border); }

			.ic-side-stat { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1rem; border-bottom: 1px solid var(--ic-border); }
			.ic-side-stat:last-child { border-bottom: 0; }
			.ic-side-stat-left { display: flex; align-items: center; gap: 0.55rem; }
			.ic-side-stat-label { font-size: 0.78rem; color: var(--ic-ink-3); }
			.ic-side-stat-count { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.78rem; color: var(--ic-ink-2); font-weight: 600; }
			.ic-side-stat-count.bad { color: var(--ic-red); }
			.ic-side-stat-count.warn { color: var(--ic-amber); }
			.ic-side-stat-count.ok { color: var(--ic-green); }
			.ic-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
			.ic-dot.ok { background: var(--ic-green); }
			.ic-dot.warn { background: var(--ic-amber); }
			.ic-dot.bad { background: var(--ic-red); }

			.ic-jumplink { display: flex; align-items: center; justify-content: space-between; padding: 0.55rem 1rem; border-bottom: 1px solid var(--ic-border); font-size: 0.82rem; color: var(--ic-ink-3); text-decoration: none; cursor: pointer; }
			.ic-jumplink:last-child { border-bottom: 0; }
			.ic-jumplink:hover { background: var(--ic-cream); color: var(--ic-ink); }
			.ic-jumplink-left { display: flex; align-items: center; gap: 0.5rem; }
			.ic-badge { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.68rem; padding: 0.12rem 0.5rem; border-radius: 8px; background: var(--ic-cream-3); color: var(--ic-ink-3); }
			.ic-badge.bad { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-badge.warn { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-badge.ok { background: var(--ic-green-bg); color: var(--ic-green); }

			.ic-main { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }

			.ic-card { background: var(--ic-white); border: 1px solid var(--ic-border); border-radius: 14px; box-shadow: var(--ts-shadow-1, 0 1px 2px rgba(0,0,0,0.04)); overflow: hidden; }
			.ic-card-head { display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1.25rem; background: var(--ic-cream); border-bottom: 1px solid var(--ic-border); gap: 0.5rem; flex-wrap: wrap; }
			.ic-card-title { font-size: 0.88rem; font-weight: 700; color: var(--ic-ink); display: flex; align-items: center; gap: 0.55rem; }
			.ic-icon-tile { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.78rem; font-weight: 700; flex-shrink: 0; }
			.ic-icon-tile.rust { background: var(--ic-rust-bg); color: var(--ic-rust); }
			.ic-icon-tile.blue { background: var(--ic-blue-bg); color: var(--ic-blue); }
			.ic-icon-tile.green { background: var(--ic-green-bg); color: var(--ic-green); }
			.ic-icon-tile.amber { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-icon-tile.purple { background: var(--ic-purple-bg); color: var(--ic-purple); }
			.ic-icon-tile.red { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-icon-tile.teal { background: var(--ic-teal-bg); color: var(--ic-teal); }
			.ic-card-badge { font-size: 0.72rem; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; padding: 0.15rem 0.55rem; border-radius: 8px; background: var(--ic-cream-3); color: var(--ic-ink-3); }
			.ic-card-badge.pass { background: var(--ic-green-bg); color: var(--ic-green); }
			.ic-card-badge.fail { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-card-badge.warn { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-card-badge.info { background: var(--ic-blue-bg); color: var(--ic-blue); }

			.ic-issues-strip { display: grid; grid-template-columns: 1fr 1fr; }
			.ic-issue-tile { padding: 1rem 1.1rem; display: flex; gap: 0.7rem; align-items: flex-start; border-bottom: 1px solid var(--ic-border); border-right: 1px solid var(--ic-border); }
			.ic-issue-tile:nth-child(2n) { border-right: 0; }
			.ic-issue-tile:nth-last-child(-n+2) { border-bottom: 0; }
			.ic-issue-icon { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; flex-shrink: 0; }
			.ic-issue-icon.fail { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-issue-icon.warn { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-issue-icon.pass { background: var(--ic-green-bg); color: var(--ic-green); }
			.ic-issue-body strong { display: block; font-size: 0.88rem; font-weight: 700; color: var(--ic-ink); margin-bottom: 0.15rem; }
			.ic-issue-body span { font-size: 0.78rem; color: var(--ic-ink-3); line-height: 1.5; display: block; }
			.ic-issue-pill { display: inline-block; margin-top: 0.4rem; padding: 0.15rem 0.55rem; border-radius: 5px; font-size: 0.7rem; font-weight: 700; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; }
			.ic-issue-pill.fail { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-issue-pill.warn { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-issue-pill.pass { background: var(--ic-green-bg); color: var(--ic-green); }
			@media (max-width: 720px) {
				.ic-issues-strip { grid-template-columns: 1fr; }
				.ic-issue-tile { border-right: 0; }
				.ic-issue-tile:nth-last-child(-n+2) { border-bottom: 1px solid var(--ic-border); }
				.ic-issue-tile:last-child { border-bottom: 0; }
			}

			.ic-grid-wrap { padding: 1.1rem 1.25rem 1.25rem; }
			.ic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.85rem; }
			.ic-img-card { background: var(--ic-paper); border: 1px solid var(--ic-border); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; }
			.ic-img-thumb { position: relative; background: var(--ic-cream); height: 160px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
			.ic-img-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
			.ic-img-thumb.empty { color: var(--ic-ink-4); font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.7rem; }
			.ic-thumb-badge { position: absolute; right: 6px; bottom: 6px; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.62rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 5px; border: 1px solid; letter-spacing: 0.04em; background: rgba(255,255,255,0.92); }
			.ic-thumb-badge.webp { color: var(--ic-webp); border-color: color-mix(in srgb, var(--ic-webp) 35%, transparent); }
			.ic-thumb-badge.avif { color: var(--ic-avif); border-color: color-mix(in srgb, var(--ic-avif) 35%, transparent); }
			.ic-thumb-badge.svg { color: var(--ic-svg); border-color: color-mix(in srgb, var(--ic-svg) 35%, transparent); }
			.ic-thumb-badge.jpg { color: var(--ic-jpg); border-color: color-mix(in srgb, var(--ic-jpg) 35%, transparent); }
			.ic-thumb-badge.png { color: var(--ic-png); border-color: color-mix(in srgb, var(--ic-png) 30%, transparent); }
			.ic-thumb-badge.gif { color: var(--ic-gif); border-color: color-mix(in srgb, var(--ic-gif) 30%, transparent); }
			.ic-thumb-badge.other { color: var(--ic-ink-3); border-color: var(--ic-border); }
			.ic-thumb-hero { position: absolute; left: 6px; top: 6px; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.6rem; font-weight: 700; padding: 0.12rem 0.4rem; border-radius: 4px; background: var(--ic-rust); color: #fff; letter-spacing: 0.04em; }
			.ic-img-meta { padding: 0.55rem 0.7rem 0.6rem; }
			.ic-img-name { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.72rem; color: var(--ic-ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 0.35rem; }
			.ic-img-flags { display: flex; flex-wrap: wrap; gap: 0.25rem; }
			.ic-mini { display: inline-flex; align-items: center; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.62rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 4px; letter-spacing: 0.02em; }
			.ic-mini.pass { background: var(--ic-green-bg); color: var(--ic-green); }
			.ic-mini.fail { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-mini.warn { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-mini.info { background: var(--ic-blue-bg); color: var(--ic-blue); }
			.ic-grid-more { margin-top: 0.85rem; padding: 0.7rem 0.85rem; background: var(--ic-cream); border-radius: 8px; font-size: 0.78rem; color: var(--ic-ink-3); text-align: center; }

			.ic-table { width: 100%; border-collapse: collapse; }
			.ic-table th { text-align: left; padding: 0.65rem 1.25rem; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--ic-ink-4); background: var(--ic-cream); border-bottom: 1px solid var(--ic-border); }
			.ic-table td { padding: 0.65rem 1.25rem; border-bottom: 1px solid var(--ic-border); font-size: 0.82rem; vertical-align: middle; }
			.ic-table tr:last-child td { border-bottom: 0; }
			.ic-table tr:hover td { background: var(--ic-cream); }
			.ic-seq { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.76rem; color: var(--ic-ink-4); text-align: center; width: 36px; }
			.ic-src { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.76rem; color: var(--ic-ink-2); max-width: 380px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.ic-pill { display: inline-flex; align-items: center; padding: 0.15rem 0.55rem; border-radius: 5px; font-size: 0.7rem; font-weight: 700; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; white-space: nowrap; }
			.ic-pill.pass { background: var(--ic-green-bg); color: var(--ic-green); }
			.ic-pill.fail { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-pill.warn { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-pill.info { background: var(--ic-blue-bg); color: var(--ic-blue); }
			.ic-pill.webp { background: var(--ic-webp-bg); color: var(--ic-webp); }
			.ic-pill.avif { background: var(--ic-avif-bg); color: var(--ic-avif); }
			.ic-pill.svg { background: var(--ic-svg-bg); color: var(--ic-svg); }
			.ic-pill.jpg { background: var(--ic-jpg-bg); color: var(--ic-jpg); }
			.ic-pill.png { background: var(--ic-png-bg); color: var(--ic-png); }
			.ic-pill.gif { background: var(--ic-gif-bg); color: var(--ic-gif); }
			.ic-pill.other { background: var(--ic-cream-3); color: var(--ic-ink-3); }
			.ic-hero-flag { display: inline-block; margin-left: 0.3rem; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.6rem; font-weight: 700; padding: 0.05rem 0.35rem; border-radius: 4px; background: var(--ic-rust-bg); color: var(--ic-rust); }

			.ic-format-grid { display: grid; grid-template-columns: repeat(6, 1fr); }
			.ic-format-tile { padding: 0.95rem 0.9rem; border-right: 1px solid var(--ic-border); display: flex; flex-direction: column; gap: 0.4rem; }
			.ic-format-tile:last-child { border-right: 0; }
			.ic-format-name { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
			.ic-format-name.webp { color: var(--ic-webp); }
			.ic-format-name.avif { color: var(--ic-avif); }
			.ic-format-name.svg { color: var(--ic-svg); }
			.ic-format-name.jpg { color: var(--ic-jpg); }
			.ic-format-name.png { color: var(--ic-png); }
			.ic-format-name.gif { color: var(--ic-gif); }
			.ic-format-count { font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; color: var(--ic-ink); }
			.ic-format-track { height: 6px; background: var(--ic-cream-3); border-radius: 3px; overflow: hidden; }
			.ic-format-fill { height: 100%; border-radius: 3px; transition: width 0.6s ease; }
			.ic-format-fill.webp { background: var(--ic-webp); }
			.ic-format-fill.avif { background: var(--ic-avif); }
			.ic-format-fill.svg { background: var(--ic-svg); }
			.ic-format-fill.jpg { background: var(--ic-jpg); }
			.ic-format-fill.png { background: var(--ic-png); }
			.ic-format-fill.gif { background: var(--ic-gif); }
			.ic-format-pct { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.7rem; color: var(--ic-ink-4); }
			@media (max-width: 720px) {
				.ic-format-grid { grid-template-columns: repeat(3, 1fr); }
				.ic-format-tile { border-bottom: 1px solid var(--ic-border); }
				.ic-format-tile:nth-child(3n) { border-right: 0; }
				.ic-format-tile:nth-last-child(-n+3) { border-bottom: 0; }
			}

			.ic-perf-grid { display: grid; grid-template-columns: 1fr 1fr; }
			.ic-perf-tile { padding: 1.2rem 1.25rem; display: flex; gap: 0.95rem; align-items: flex-start; border-right: 1px solid var(--ic-border); border-bottom: 1px solid var(--ic-border); }
			.ic-perf-tile:nth-child(2n) { border-right: 0; }
			.ic-perf-tile:nth-last-child(-n+2) { border-bottom: 0; }
			.ic-perf-icon { width: 38px; height: 38px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 700; flex-shrink: 0; }
			.ic-perf-icon.pass { background: var(--ic-green-bg); color: var(--ic-green); }
			.ic-perf-icon.fail { background: var(--ic-red-bg); color: var(--ic-red); }
			.ic-perf-icon.warn { background: var(--ic-amber-bg); color: var(--ic-amber); }
			.ic-perf-body { flex: 1; min-width: 0; }
			.ic-perf-title { font-size: 0.92rem; font-weight: 700; color: var(--ic-ink); margin: 0 0 0.18rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
			.ic-perf-detail { font-size: 0.8rem; color: var(--ic-ink-3); line-height: 1.5; margin: 0; }
			@media (max-width: 720px) {
				.ic-perf-grid { grid-template-columns: 1fr; }
				.ic-perf-tile { border-right: 0; }
				.ic-perf-tile:nth-last-child(-n+2) { border-bottom: 1px solid var(--ic-border); }
				.ic-perf-tile:last-child { border-bottom: 0; }
			}

			.ic-recs-dark { background: var(--ic-dark-card); border: 0; color: #fff; padding: 1.4rem 1.5rem; }
			[data-theme="dark"] .ic-recs-dark { background: rgba(var(--paper-strong), 0.2); color: var(--ic-ink); border: 1px solid var(--ic-border); }
			.ic-recs-dark h3 { font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-size: 1.25rem; font-weight: 700; margin: 0 0 0.2rem; color: #fff; }
			[data-theme="dark"] .ic-recs-dark h3 { color: var(--ic-ink); }
			.ic-recs-sub { font-size: 0.85rem; color: rgba(255,255,255,0.6); margin-bottom: 1.1rem; }
			[data-theme="dark"] .ic-recs-sub { color: var(--ic-ink-3); }
			.ic-rec-item { display: flex; gap: 0.85rem; padding: 0.85rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); align-items: flex-start; }
			[data-theme="dark"] .ic-rec-item { border-bottom-color: var(--ic-border); }
			.ic-rec-item:last-child { border-bottom: 0; padding-bottom: 0; }
			.ic-rec-num { font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-size: 1.25rem; font-weight: 700; color: rgba(255,255,255,0.18); min-width: 1.5rem; line-height: 1.2; }
			[data-theme="dark"] .ic-rec-num { color: var(--ic-ink-4); }
			.ic-rec-body { flex: 1; min-width: 0; }
			.ic-rec-body strong { display: block; font-size: 0.92rem; color: #fff; margin-bottom: 0.15rem; }
			[data-theme="dark"] .ic-rec-body strong { color: var(--ic-ink); }
			.ic-rec-body span { font-size: 0.82rem; color: rgba(255,255,255,0.55); line-height: 1.55; }
			[data-theme="dark"] .ic-rec-body span { color: var(--ic-ink-3); }
			.ic-rec-body code { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; font-size: 0.78rem; background: rgba(255,255,255,0.08); padding: 0.05rem 0.4rem; border-radius: 4px; color: rgba(255,255,255,0.9); }
			[data-theme="dark"] .ic-rec-body code { background: var(--ic-cream-3); color: var(--ic-ink); }
			.ic-rec-sev { padding: 0.18rem 0.55rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; font-family: 'SFMono-Regular', Consolas, Menlo, monospace; flex-shrink: 0; white-space: nowrap; }
			.ic-rec-sev.fail { background: rgba(248,113,113,0.22); color: #ff8585; }
			.ic-rec-sev.warn { background: rgba(251,191,36,0.22); color: #f5c651; }
			.ic-rec-sev.info { background: rgba(147,197,253,0.22); color: #9dc7f5; }

			@media (max-width: 880px) {
				.ic-layout { grid-template-columns: 1fr; padding: 1.25rem 0 3rem; }
				.ic-sidebar { position: static; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="ic-page">
			<div class="ic-header">
				<div class="ic-header-inner">
					<div class="ic-breadcrumb"><a href="/ai-seo-tools">← AI SEO Tools</a> · Image Optimization</div>
					<h1>AI SEO Image Checker</h1>
					<p>Audit every <code>&lt;img&gt;</code> tag on a page for alt text, dimensions, lazy loading, and modern formats like WebP, AVIF, and SVG to improve image SEO, accessibility, and Core Web Vitals.</p>
				</div>
			</div>

			<div class="ic-input-wrap">
				<div class="ic-input-card">
					<div class="ic-input-tabs" role="tablist" aria-label="Input mode">
						<button class="ic-tab-btn" role="tab" aria-selected="true" data-tab="url" type="button">URL</button>
						<button class="ic-tab-btn" role="tab" aria-selected="false" data-tab="html" type="button">Paste HTML</button>
					</div>
					<div class="ic-tab-panel active" id="tab-url" role="tabpanel">
						<div class="ic-input-row">
							<input id="url-input" class="ic-url-input" type="url" placeholder="https://example.com/page" autocomplete="url" />
							<button class="ic-btn-run" id="analyze-btn" type="button">Analyze images</button>
							<button class="ic-btn-clear" id="clear-btn" type="button">Clear</button>
						</div>
					</div>
					<div class="ic-tab-panel" id="tab-html" role="tabpanel">
						<textarea id="html-input" class="ic-html-input" placeholder="Paste the page's HTML source"></textarea>
						<div class="ic-input-row">
							<div></div>
							<button class="ic-btn-run" id="analyze-btn-2" type="button">Analyze images</button>
							<button class="ic-btn-clear" id="clear-btn-2" type="button">Clear</button>
						</div>
					</div>
					<div class="ic-status" id="tool-status" role="status" aria-live="polite"></div>
				</div>
			</div>

			<div class="ic-report-toolbar" id="report-toolbar">
				<button class="ic-btn-download" id="download-pdf-btn" type="button">⬇ Download PDF</button>
			</div>
			<section class="ic-report" id="report" aria-live="polite"></section>
		</main>
		<Footer />

		<script>
			import { exportReportToPdf } from '../../lib/pdf-export';

			type Tier = 'good' | 'fair' | 'poor';
			type ImageRow = {
				src: string;
				alt: boolean;
				dim: boolean;
				lazy: boolean;
				modern: boolean;
				format: string;
				isFirst: boolean;
			};

			const tabBtns = document.querySelectorAll<HTMLButtonElement>('.ic-tab-btn');
			const tabPanels = document.querySelectorAll<HTMLElement>('.ic-tab-panel');
			const urlInput = document.getElementById('url-input') as HTMLInputElement;
			const htmlInput = document.getElementById('html-input') as HTMLTextAreaElement;
			const statusEl = document.getElementById('tool-status')!;
			const reportEl = document.getElementById('report')!;
			const reportToolbar = document.getElementById('report-toolbar')!;
			const downloadBtn = document.getElementById('download-pdf-btn') as HTMLButtonElement;
			let activeTab: 'url' | 'html' = 'url';
			let lastSource = '';

			tabBtns.forEach((b) =>
				b.addEventListener('click', () => {
					tabBtns.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
					tabPanels.forEach((p) => p.classList.toggle('active', p.id === `tab-${b.dataset.tab}`));
					activeTab = b.dataset.tab as 'url' | 'html';
					setStatus('');
				}),
			);

			const analyzeBtns = [document.getElementById('analyze-btn'), document.getElementById('analyze-btn-2')].filter(Boolean) as HTMLButtonElement[];
			const clearBtns = [document.getElementById('clear-btn'), document.getElementById('clear-btn-2')].filter(Boolean) as HTMLButtonElement[];

			function setStatus(t: string, error = false, loading = false) {
				statusEl.textContent = t;
				statusEl.classList.toggle('error', error);
				statusEl.classList.toggle('loading', loading);
			}
			const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
			const tierFor = (s: number): Tier => s >= 80 ? 'good' : s >= 55 ? 'fair' : 'poor';
			const KNOWN_FORMATS = ['webp', 'avif', 'svg', 'jpg', 'jpeg', 'png', 'gif'];
			const fmtKey = (f: string) => f === 'jpeg' ? 'jpg' : (KNOWN_FORMATS.includes(f) ? f : 'other');

			async function fetchPage(url: string) {
				const res = await fetch(`/api/fetch-page?url=${encodeURIComponent(url)}`);
				if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || `Fetch failed (${res.status})`); }
				return res.json();
			}

			function resolveSrc(src: string, baseUrl: string): string {
				if (!src) return '';
				try {
					const u = new URL(src, baseUrl);
					return u.href;
				} catch { return src; }
			}

			function analyze(html: string, baseUrl: string) {
				const doc = new DOMParser().parseFromString(html, 'text/html');
				const imgs = Array.from(doc.querySelectorAll('img'));

				if (imgs.length === 0) {
					return { total: 0, images: [] as ImageRow[], stats: { noAlt: 0, noDim: 0, noLazy: 0, nonModern: 0 }, score: 0 };
				}

				let noAlt = 0, noDim = 0, noLazy = 0, nonModern = 0;
				const imageData: ImageRow[] = imgs.map((img, idx) => {
					const rawSrc = img.getAttribute('src') || '';
					const src = resolveSrc(rawSrc, baseUrl);
					const alt = img.getAttribute('alt');
					const width = img.getAttribute('width');
					const height = img.getAttribute('height');
					const loading = img.getAttribute('loading');
					const ext = (rawSrc.split('?')[0].split('#')[0].split('.').pop() || '').toLowerCase();
					const hasAlt = alt !== null && alt.trim() !== '';
					const hasDim = !!width && !!height;
					const hasLazy = loading === 'lazy';
					const isFirst = idx === 0;
					const isModern = ext === 'webp' || ext === 'avif' || ext === 'svg' || rawSrc.startsWith('data:');
					if (!hasAlt) noAlt++;
					if (!hasDim) noDim++;
					if (!hasLazy && !isFirst) noLazy++;
					if (!isModern && ext) nonModern++;
					return { src, alt: hasAlt, dim: hasDim, lazy: hasLazy, modern: isModern, format: ext || '?', isFirst };
				});

				const score = Math.max(0, Math.round(
					100 - (
						(noAlt / imgs.length) * 50 +
						(noDim / imgs.length) * 25 +
						(noLazy / Math.max(1, imgs.length - 1)) * 15 +
						(nonModern / imgs.length) * 15
					)
				));
				return { total: imgs.length, images: imageData, stats: { noAlt, noDim, noLazy, nonModern }, score };
			}

			function formatCounts(images: ImageRow[]) {
				const counts: Record<string, number> = { webp: 0, avif: 0, svg: 0, jpg: 0, png: 0, gif: 0, other: 0 };
				images.forEach((i) => { counts[fmtKey(i.format)] = (counts[fmtKey(i.format)] || 0) + 1; });
				return counts;
			}

			function trimSrc(src: string, max = 90) {
				if (src.length <= max) return src;
				return src.slice(0, max) + '…';
			}

			function fileName(src: string) {
				try {
					const u = new URL(src);
					const p = u.pathname.split('/').filter(Boolean).pop() || src;
					return p.length > 30 ? p.slice(0, 27) + '…' : p;
				} catch {
					const p = src.split('/').pop() || src;
					return p.length > 30 ? p.slice(0, 27) + '…' : p;
				}
			}

			function render(data: ReturnType<typeof analyze>, source: string) {
				const tier = data.total === 0 ? 'fair' : tierFor(data.score);
				const tierLabel = { good: 'Good', fair: 'Needs work', poor: 'Poor' }[tier];
				const scoreCls = tier === 'good' ? 'ok' : tier === 'fair' ? 'warn' : 'bad';

				const fmts = formatCounts(data.images);
				const modern = fmts.webp + fmts.avif + fmts.svg;
				const legacy = fmts.jpg + fmts.png + fmts.gif;

				const altPass = data.stats.noAlt === 0;
				const dimPass = data.stats.noDim === 0;
				const lazyPass = data.stats.noLazy === 0;
				const fmtPass = data.stats.nonModern === 0;

				const issues = [
					{ icon: altPass ? 'pass' : 'fail', tile: 'red', title: altPass ? 'All images have alt text' : `Missing alt text (${data.stats.noAlt})`, detail: altPass ? `All ${data.total} images carry alt attributes. Good for accessibility and image search.` : `${data.stats.noAlt} of ${data.total} images have no alt text. Critical for accessibility and image SEO.`, pill: altPass ? 'Pass' : `${data.stats.noAlt} missing`, pillCls: altPass ? 'pass' : 'fail' },
					{ icon: dimPass ? 'pass' : 'warn', tile: 'amber', title: dimPass ? 'Dimensions declared' : `Missing width/height (${data.stats.noDim})`, detail: dimPass ? 'All images set explicit width and height, preventing layout shift.' : `${data.stats.noDim} images have no width/height attributes. Causes Cumulative Layout Shift (CLS).`, pill: dimPass ? 'Pass' : `${data.stats.noDim} no dim`, pillCls: dimPass ? 'pass' : 'warn' },
					{ icon: lazyPass ? 'pass' : 'warn', tile: 'blue', title: lazyPass ? 'Lazy loading set' : `Eager below-the-fold (${data.stats.noLazy})`, detail: lazyPass ? 'Below-the-fold images use loading="lazy", saving bandwidth on initial load.' : `${data.stats.noLazy} below-the-fold images load eagerly. Add loading="lazy" to defer them.`, pill: lazyPass ? 'Pass' : `${data.stats.noLazy} eager`, pillCls: lazyPass ? 'pass' : 'warn' },
					{ icon: fmtPass ? 'pass' : 'warn', tile: 'teal', title: fmtPass ? 'Modern formats only' : `Legacy formats (${data.stats.nonModern})`, detail: fmtPass ? 'Every image uses WebP, AVIF, SVG, or a data URI — already optimised for LCP.' : `${data.stats.nonModern} images use legacy formats (JPG/PNG/GIF). Convert to WebP/AVIF for faster LCP.`, pill: fmtPass ? 'Pass' : `${data.stats.nonModern} legacy`, pillCls: fmtPass ? 'pass' : 'warn' },
				];

				const failCount = issues.filter((i) => i.icon === 'fail').length;
				const warnCount = issues.filter((i) => i.icon === 'warn').length;

				const gridLimit = Math.min(data.images.length, 16);
				const gridImages = data.images.slice(0, gridLimit);

				const gridHtml = gridImages.map((img) => {
					const fkey = fmtKey(img.format);
					const safe = esc(img.src);
					const hasUsableSrc = img.src && !img.src.startsWith('data:') && /^https?:/i.test(img.src);
					return `
						<div class="ic-img-card">
							<div class="ic-img-thumb${hasUsableSrc ? '' : ' empty'}">
								${hasUsableSrc ? `<img src="${safe}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('empty');this.remove();" />` : 'no preview'}
								${img.isFirst ? '<span class="ic-thumb-hero">HERO</span>' : ''}
								<span class="ic-thumb-badge ${fkey}">${esc(img.format.toUpperCase())}</span>
							</div>
							<div class="ic-img-meta">
								<div class="ic-img-name" title="${safe}">${esc(fileName(img.src) || 'image')}</div>
								<div class="ic-img-flags">
									<span class="ic-mini ${img.alt ? 'pass' : 'fail'}">alt ${img.alt ? '✓' : '✕'}</span>
									<span class="ic-mini ${img.dim ? 'pass' : 'warn'}">dim ${img.dim ? '✓' : '✕'}</span>
									<span class="ic-mini ${img.isFirst ? 'info' : img.lazy ? 'pass' : 'warn'}">${img.isFirst ? 'eager' : img.lazy ? 'lazy' : 'no lazy'}</span>
									<span class="ic-mini ${img.modern ? 'pass' : 'warn'}">${img.modern ? 'modern' : 'legacy'}</span>
								</div>
							</div>
						</div>
					`;
				}).join('');

				const tableHtml = `
					<div class="ic-table-scroll">
					<table class="ic-table">
						<thead><tr>
							<th class="ic-seq">#</th>
							<th>Source</th>
							<th style="width:90px">Alt</th>
							<th style="width:90px">W×H</th>
							<th style="width:130px">Lazy</th>
							<th style="width:90px">Format</th>
						</tr></thead>
						<tbody>
							${data.images.map((img, i) => {
								const fkey = fmtKey(img.format);
								return `<tr>
									<td class="ic-seq">${i + 1}</td>
									<td><div class="ic-src" title="${esc(img.src)}">${esc(trimSrc(img.src))}</div></td>
									<td><span class="ic-pill ${img.alt ? 'pass' : 'fail'}">${img.alt ? '✓ Yes' : '✕ No'}</span></td>
									<td><span class="ic-pill ${img.dim ? 'pass' : 'warn'}">${img.dim ? '✓ Yes' : '✕ No'}</span></td>
									<td><span class="ic-pill ${img.isFirst ? 'info' : img.lazy ? 'pass' : 'warn'}">${img.isFirst ? 'Eager' : img.lazy ? '✓ Lazy' : '✕ No'}</span>${img.isFirst ? '<span class="ic-hero-flag">HERO</span>' : ''}</td>
									<td><span class="ic-pill ${fkey}">${esc(img.format)}</span></td>
								</tr>`;
							}).join('')}
						</tbody>
					</table>
					</div>
				`;

				const formatOrder: { key: 'webp' | 'avif' | 'svg' | 'jpg' | 'png' | 'gif'; label: string }[] = [
					{ key: 'webp', label: 'WebP' },
					{ key: 'avif', label: 'AVIF' },
					{ key: 'svg', label: 'SVG' },
					{ key: 'jpg', label: 'JPG' },
					{ key: 'png', label: 'PNG' },
					{ key: 'gif', label: 'GIF' },
				];

				const formatHtml = formatOrder.map((f) => {
					const c = fmts[f.key] || 0;
					const pct = data.total > 0 ? Math.round((c / data.total) * 100) : 0;
					return `
						<div class="ic-format-tile">
							<div class="ic-format-name ${f.key}">${f.label}</div>
							<div class="ic-format-count">${c}</div>
							<div class="ic-format-track"><div class="ic-format-fill ${f.key}" style="width:${pct}%"></div></div>
							<div class="ic-format-pct">${pct}% of total</div>
						</div>
					`;
				}).join('');

				const perfChecks = [
					{ key: 'alt', title: 'Alt text', icon: altPass ? 'pass' : 'fail', symbol: altPass ? '✓' : '✕', detail: altPass ? `Every <img> tag carries a non-empty alt attribute — screen readers and image-search bots get full context.` : `${data.stats.noAlt} of ${data.total} images are missing alt text. Add a short, descriptive alt for each — leave decorative images with <code>alt=""</code>.`, badge: altPass ? 'Pass' : 'Fail', badgeCls: altPass ? 'pass' : 'fail' },
					{ key: 'dim', title: 'Dimensions', icon: dimPass ? 'pass' : 'warn', symbol: dimPass ? '✓' : '!', detail: dimPass ? `All images declare width and height — the browser reserves space and avoids layout shift.` : `${data.stats.noDim} images have no width/height attributes. Add intrinsic dimensions to stop CLS hurting your Core Web Vitals.`, badge: dimPass ? 'Pass' : 'Warning', badgeCls: dimPass ? 'pass' : 'warn' },
					{ key: 'lazy', title: 'Lazy loading', icon: lazyPass ? 'pass' : 'warn', symbol: lazyPass ? '✓' : '!', detail: lazyPass ? `Below-the-fold images use <code>loading="lazy"</code>. The hero stays eager for LCP.` : `${data.stats.noLazy} below-the-fold images load eagerly. Add <code>loading="lazy"</code> to everything except the hero.`, badge: lazyPass ? 'Pass' : 'Warning', badgeCls: lazyPass ? 'pass' : 'warn' },
					{ key: 'fmt', title: 'Modern formats', icon: fmtPass ? 'pass' : 'warn', symbol: fmtPass ? '✓' : '!', detail: fmtPass ? `Every image is WebP, AVIF, SVG, or a data URI — already byte-efficient.` : `${data.stats.nonModern} images use legacy JPG/PNG/GIF. Convert them to WebP/AVIF for 30–60% smaller payloads.`, badge: fmtPass ? 'Pass' : 'Warning', badgeCls: fmtPass ? 'pass' : 'warn' },
				];

				const perfHtml = perfChecks.map((c) => `
					<div class="ic-perf-tile">
						<div class="ic-perf-icon ${c.icon}">${c.symbol}</div>
						<div class="ic-perf-body">
							<div class="ic-perf-title">${esc(c.title)} <span class="ic-card-badge ${c.badgeCls}">${c.badge}</span></div>
							<p class="ic-perf-detail">${c.detail}</p>
						</div>
					</div>
				`).join('');

				const recos: { title: string; detail: string; sev: 'fail' | 'warn' | 'info' }[] = [];
				if (data.total === 0) {
					recos.push({ title: 'No images detected on this page', detail: 'This page has no <code>&lt;img&gt;</code> tags. If it should have images (hero, illustrations, screenshots), add them with descriptive alt text, explicit dimensions, and modern formats from the start.', sev: 'info' });
				} else {
					if (data.stats.noAlt > 0) recos.push({ title: `Add alt text to ${data.stats.noAlt} image${data.stats.noAlt === 1 ? '' : 's'}`, detail: `Every meaningful image needs a short alt attribute, e.g. <code>alt="Heading checker dashboard screenshot"</code>. Decorative images should use <code>alt=""</code> rather than no alt at all.`, sev: 'fail' });
					if (data.stats.noDim > 0) recos.push({ title: `Declare width and height on ${data.stats.noDim} image${data.stats.noDim === 1 ? '' : 's'}`, detail: `Add explicit dimensions like <code>width="800" height="600"</code> so the browser reserves space. This is one of the cheapest fixes for Cumulative Layout Shift (CLS).`, sev: 'warn' });
					if (data.stats.nonModern > 0) recos.push({ title: `Convert ${data.stats.nonModern} legacy image${data.stats.nonModern === 1 ? '' : 's'} to WebP or AVIF`, detail: `Re-encode JPG/PNG to <code>.webp</code> or <code>.avif</code> — typically 30–60% smaller at the same quality. Use a <code>&lt;picture&gt;</code> element with fallbacks if you need broad browser support.`, sev: 'warn' });
					if (data.stats.noLazy > 0) recos.push({ title: `Add loading="lazy" to ${data.stats.noLazy} image${data.stats.noLazy === 1 ? '' : 's'}`, detail: `Only the hero image should load eagerly. Everything below the fold should use <code>loading="lazy"</code> to save bandwidth and improve LCP.`, sev: 'warn' });
					if (data.images[0] && data.images[0].lazy) recos.push({ title: 'Make the hero image eager', detail: `The first image on the page currently uses <code>loading="lazy"</code>. Remove that attribute (or set it to <code>"eager"</code>) so the LCP element starts downloading immediately.`, sev: 'warn' });
					if (recos.length === 0) recos.push({ title: 'Image setup looks healthy', detail: 'All images have alt text, declared dimensions, lazy loading on below-the-fold assets, and modern formats. Keep this discipline as new content is added.', sev: 'info' });
				}

				const summaryIssues = [
					altPass ? { dot: 'ok', label: 'Alt text', badge: 'Pass', badgeClass: 'ok' } : { dot: 'bad', label: 'Missing alt text', badge: `${data.stats.noAlt} found`, badgeClass: 'bad' },
					dimPass ? { dot: 'ok', label: 'Dimensions', badge: 'Pass', badgeClass: 'ok' } : { dot: 'warn', label: 'No dimensions', badge: `${data.stats.noDim} found`, badgeClass: 'warn' },
					lazyPass ? { dot: 'ok', label: 'Lazy loading', badge: 'Pass', badgeClass: 'ok' } : { dot: 'warn', label: 'Eager below fold', badge: `${data.stats.noLazy} found`, badgeClass: 'warn' },
					fmtPass ? { dot: 'ok', label: 'Modern formats', badge: 'Pass', badgeClass: 'ok' } : { dot: 'warn', label: 'Legacy formats', badge: `${data.stats.nonModern} found`, badgeClass: 'warn' },
				];

				const modernFormats: { key: 'webp' | 'avif' | 'svg'; label: string }[] = [
					{ key: 'webp', label: 'WebP' },
					{ key: 'avif', label: 'AVIF' },
					{ key: 'svg', label: 'SVG' },
				];
				const legacyFormats: { key: 'jpg' | 'png' | 'gif'; label: string }[] = [
					{ key: 'jpg', label: 'JPG' },
					{ key: 'png', label: 'PNG' },
					{ key: 'gif', label: 'GIF' },
				];

				let html = `
					<div class="ic-stat-bar">
						<div class="ic-stat-inner">
							<div class="ic-stat-tile"><div class="ic-stat-val ink">${data.total}</div><div class="ic-stat-lbl">Total images</div></div>
							<div class="ic-stat-tile"><div class="ic-stat-val ${altPass ? 'ok' : 'bad'}">${data.stats.noAlt}</div><div class="ic-stat-lbl">Missing alt</div></div>
							<div class="ic-stat-tile"><div class="ic-stat-val ${dimPass ? 'ok' : 'warn'}">${data.stats.noDim}</div><div class="ic-stat-lbl">No dimensions</div></div>
							<div class="ic-stat-tile"><div class="ic-stat-val ${lazyPass ? 'ok' : 'warn'}">${data.stats.noLazy}</div><div class="ic-stat-lbl">No lazy</div></div>
							<div class="ic-stat-tile"><div class="ic-stat-val ${fmtPass ? 'ok' : 'warn'}">${data.stats.nonModern}</div><div class="ic-stat-lbl">Legacy format</div></div>
							<div class="ic-stat-tile"><div class="ic-stat-val ${scoreCls}">${data.score}</div><div class="ic-stat-lbl">Score · ${tierLabel}</div></div>
						</div>
					</div>

					<div class="ic-layout">
						<aside class="ic-sidebar">
							<div class="ic-side-card">
								<div class="ic-side-head">Format legend</div>
								<div class="ic-side-body">
									${modernFormats.map((f) => `<div class="ic-fmt-pill ${f.key}"><span class="ic-fmt-name">${f.label}</span><span class="ic-fmt-count">${fmts[f.key] || 0}</span></div>`).join('')}
									<div class="ic-fmt-sep">Legacy</div>
									${legacyFormats.map((f) => `<div class="ic-fmt-pill ${f.key}"><span class="ic-fmt-name">${f.label}</span><span class="ic-fmt-count">${fmts[f.key] || 0}</span></div>`).join('')}
								</div>
							</div>

							<div class="ic-side-card">
								<div class="ic-side-head">Issues found</div>
								<div>
									${summaryIssues.map((s) => `
										<div class="ic-side-stat">
											<div class="ic-side-stat-left">
												<span class="ic-dot ${s.dot}"></span>
												<span class="ic-side-stat-label">${esc(s.label)}</span>
											</div>
											<span class="ic-badge ${s.badgeClass}">${esc(s.badge)}</span>
										</div>
									`).join('')}
								</div>
							</div>

							<div class="ic-side-card">
								<div class="ic-side-head">Jump to</div>
								<a class="ic-jumplink" href="#overview"><span class="ic-jumplink-left"><span class="ic-dot ${failCount > 0 ? 'bad' : warnCount > 0 ? 'warn' : 'ok'}"></span>Issues overview</span><span class="ic-badge ${failCount > 0 ? 'bad' : warnCount > 0 ? 'warn' : 'ok'}">${failCount + warnCount}</span></a>
								<a class="ic-jumplink" href="#grid"><span class="ic-jumplink-left"><span class="ic-dot ok"></span>Image grid</span><span class="ic-badge">${gridLimit}</span></a>
								<a class="ic-jumplink" href="#table"><span class="ic-jumplink-left"><span class="ic-dot ${data.stats.noAlt > 0 ? 'bad' : 'ok'}"></span>All images</span><span class="ic-badge">${data.total}</span></a>
								<a class="ic-jumplink" href="#format"><span class="ic-jumplink-left"><span class="ic-dot ${legacy > modern ? 'warn' : 'ok'}"></span>Format analysis</span></a>
								<a class="ic-jumplink" href="#perf"><span class="ic-jumplink-left"><span class="ic-dot ${failCount > 0 ? 'bad' : warnCount > 0 ? 'warn' : 'ok'}"></span>Performance checks</span></a>
								<a class="ic-jumplink" href="#recs"><span class="ic-jumplink-left"><span class="ic-dot ${recos.some((r) => r.sev === 'fail') ? 'bad' : recos.some((r) => r.sev === 'warn') ? 'warn' : 'ok'}"></span>Recommendations</span><span class="ic-badge ${recos.some((r) => r.sev === 'fail') ? 'bad' : ''}">${recos.length}</span></a>
							</div>
						</aside>

						<main class="ic-main">
							<div class="ic-card" id="overview">
								<div class="ic-card-head">
									<div class="ic-card-title"><span class="ic-icon-tile red">⚑</span>Issues Overview</div>
									<span class="ic-card-badge ${failCount > 0 ? 'fail' : warnCount > 0 ? 'warn' : 'pass'}">${failCount} errors · ${warnCount} warnings</span>
								</div>
								<div class="ic-issues-strip">
									${issues.map((it) => `
										<div class="ic-issue-tile">
											<div class="ic-issue-icon ${it.icon}">${it.icon === 'pass' ? '✓' : it.icon === 'warn' ? '!' : '✕'}</div>
											<div class="ic-issue-body">
												<strong>${esc(it.title)}</strong>
												<span>${esc(it.detail)}</span>
												<div><span class="ic-issue-pill ${it.pillCls}">${esc(it.pill)}</span></div>
											</div>
										</div>
									`).join('')}
								</div>
							</div>

							${data.total > 0 ? `
								<div class="ic-card" id="grid">
									<div class="ic-card-head">
										<div class="ic-card-title"><span class="ic-icon-tile rust">▦</span>Image Grid</div>
										<span class="ic-card-badge">${gridLimit === data.total ? `${data.total} image${data.total === 1 ? '' : 's'}` : `First ${gridLimit} of ${data.total}`}</span>
									</div>
									<div class="ic-grid-wrap">
										<div class="ic-grid">${gridHtml}</div>
										${data.total > gridLimit ? `<div class="ic-grid-more">Showing first ${gridLimit} images · see the full table below for all ${data.total}</div>` : ''}
									</div>
								</div>

								<div class="ic-card" id="table">
									<div class="ic-card-head">
										<div class="ic-card-title"><span class="ic-icon-tile blue">≣</span>All Images</div>
										<span class="ic-card-badge">${data.total} total</span>
									</div>
									${tableHtml}
								</div>

								<div class="ic-card" id="format">
									<div class="ic-card-head">
										<div class="ic-card-title"><span class="ic-icon-tile purple">◈</span>Format Analysis</div>
										<span class="ic-card-badge ${legacy > modern ? 'warn' : 'pass'}">${modern} modern · ${legacy} legacy</span>
									</div>
									<div class="ic-format-grid">${formatHtml}</div>
								</div>

								<div class="ic-card" id="perf">
									<div class="ic-card-head">
										<div class="ic-card-title"><span class="ic-icon-tile green">✓</span>Performance Checks</div>
										<span class="ic-card-badge ${failCount > 0 ? 'fail' : warnCount > 0 ? 'warn' : 'pass'}">${failCount + warnCount === 0 ? 'All passing' : `${failCount + warnCount} to fix`}</span>
									</div>
									<div class="ic-perf-grid">${perfHtml}</div>
								</div>
							` : `
								<div class="ic-card">
									<div class="ic-card-head">
										<div class="ic-card-title"><span class="ic-icon-tile amber">!</span>No images on this page</div>
										<span class="ic-card-badge warn">0 images</span>
									</div>
									<div style="padding:1.25rem;color:var(--ic-ink-3);font-size:0.88rem;line-height:1.6">This page has no <code>&lt;img&gt;</code> tags. If that's unexpected, check whether images are being injected after page load (in which case the static HTML scan can't see them).</div>
								</div>
							`}

							<div class="ic-card ic-recs-dark" id="recs">
								<h3>Recommendations</h3>
								<div class="ic-recs-sub">Ordered by SEO and Core Web Vitals impact. Fix the first item first.</div>
								${recos.map((r, i) => `
									<div class="ic-rec-item">
										<div class="ic-rec-num">${i + 1}</div>
										<div class="ic-rec-body"><strong>${esc(r.title)}</strong><span>${r.detail}</span></div>
										<span class="ic-rec-sev ${r.sev}">${r.sev === 'fail' ? 'Critical' : r.sev === 'warn' ? 'Medium' : 'Low'}</span>
									</div>
								`).join('')}
							</div>
						</main>
					</div>
				`;

				reportEl.innerHTML = html;
				reportEl.classList.add('visible');
				reportToolbar.classList.add('visible');
				reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			downloadBtn.addEventListener('click', async () => {
				downloadBtn.disabled = true;
				const original = downloadBtn.textContent;
				downloadBtn.textContent = 'Generating…';
				try {
					await exportReportToPdf({ reportEl, toolName: 'Image SEO Checker', source: lastSource, filenamePrefix: 'image-checker' });
				} catch (err) {
					setStatus(err instanceof Error ? err.message : 'Could not generate PDF.', true);
				} finally {
					downloadBtn.disabled = false;
					downloadBtn.textContent = original;
				}
			});

			async function run() {
				analyzeBtns.forEach((b) => b.disabled = true);
				try {
					let html: string; let source: string;
					if (activeTab === 'url') {
						const u = urlInput.value.trim();
						if (!u) { setStatus('Enter a URL to analyze.', true); return; }
						setStatus('Fetching page', false, true);
						const r = await fetchPage(u); html = r.html; source = r.url;
					} else {
						html = htmlInput.value.trim();
						if (!html) { setStatus('Paste HTML to analyze.', true); return; }
						source = 'Pasted HTML';
					}
					setStatus('');
					lastSource = source;
					render(analyze(html, source), source);
				} catch (err) {
					setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
					reportEl.classList.remove('visible'); reportEl.innerHTML = '';
					reportToolbar.classList.remove('visible');
				} finally { analyzeBtns.forEach((b) => b.disabled = false); }
			}

			analyzeBtns.forEach((b) => b.addEventListener('click', run));
			urlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); run(); } });
			clearBtns.forEach((b) => b.addEventListener('click', () => {
				urlInput.value = ''; htmlInput.value = '';
				reportEl.innerHTML = ''; reportEl.classList.remove('visible'); setStatus('');
				reportToolbar.classList.remove('visible');
			}));
		</script>
	</body>
</html>
