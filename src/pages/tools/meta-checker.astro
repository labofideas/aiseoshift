---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/tools.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free Meta Tag Checker | ${SITE_TITLE}`}
			description="Inspect any URL's title, meta description, Open Graph, Twitter Cards, canonical, and language tags. Free SEO tool with a SERP preview."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="tool-page">
			<a href="/tools" class="tool-back">← All Tools</a>
			<div class="tool-header">
				<p class="section-kicker">On-Page SEO</p>
				<h1>Meta Tag Checker</h1>
				<p>Audit title, description, Open Graph, Twitter Card, canonical, and other essential meta tags on any URL. Includes a SERP preview.</p>
			</div>

			<div class="tool-input-card">
				<div class="input-tabs" role="tablist" aria-label="Input mode">
					<button class="tab-btn" role="tab" aria-selected="true" aria-controls="tab-url" data-tab="url" type="button">URL</button>
					<button class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-html" data-tab="html" type="button">Paste HTML</button>
				</div>
				<div class="tab-panel active" id="tab-url" role="tabpanel">
					<div class="tool-field">
						<label for="url-input">Page URL</label>
						<input id="url-input" type="url" placeholder="https://example.com/page" autocomplete="url" />
					</div>
				</div>
				<div class="tab-panel" id="tab-html" role="tabpanel">
					<div class="tool-field">
						<label for="html-input">Raw HTML</label>
						<textarea id="html-input" placeholder="Paste the page's HTML source"></textarea>
					</div>
				</div>
				<div class="tool-actions">
					<button class="btn-primary" id="analyze-btn" type="button">Analyze</button>
					<button class="btn-secondary" id="clear-btn" type="button">Clear</button>
				</div>
				<div class="tool-status" id="tool-status" role="status" aria-live="polite"></div>
			</div>

			<section class="report" id="report" aria-live="polite"></section>
		</main>
		<Footer />

		<script>
			type Issue = { label: string; status: 'pass' | 'warn' | 'fail'; detail: string };
			type Group = { group: string; items: Issue[] };

			const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
			const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
			const urlInput = document.getElementById('url-input') as HTMLInputElement;
			const htmlInput = document.getElementById('html-input') as HTMLTextAreaElement;
			const analyzeBtn = document.getElementById('analyze-btn') as HTMLButtonElement;
			const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
			const statusEl = document.getElementById('tool-status')!;
			const reportEl = document.getElementById('report')!;
			let activeTab: 'url' | 'html' = 'url';

			tabBtns.forEach((b) =>
				b.addEventListener('click', () => {
					tabBtns.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
					tabPanels.forEach((p) => p.classList.toggle('active', p.id === `tab-${b.dataset.tab}`));
					activeTab = b.dataset.tab as 'url' | 'html';
					statusEl.textContent = '';
					statusEl.classList.remove('error');
				}),
			);

			const setStatus = (t: string, err = false) => { statusEl.textContent = t; statusEl.classList.toggle('error', err); };
			const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

			async function fetchPage(url: string) {
				const res = await fetch(`/api/fetch-page?url=${encodeURIComponent(url)}`);
				if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || `Fetch failed (${res.status})`); }
				return res.json();
			}

			function getMeta(doc: Document, name: string, attr = 'name') {
				return doc.querySelector(`meta[${attr}="${name}"]`)?.getAttribute('content')?.trim() || '';
			}

			function analyze(html: string) {
				const doc = new DOMParser().parseFromString(html, 'text/html');
				const checks: Group[] = [];
				let score = 0;
				let total = 0;

				const essential: Issue[] = [];
				total += 4;
				const title = doc.querySelector('title')?.textContent?.trim() || '';
				if (title) {
					const tlen = title.length;
					if (tlen < 30) essential.push({ label: 'Title tag', status: 'warn', detail: `"${title}" — ${tlen} chars. Aim for 50–60.` });
					else if (tlen > 65) essential.push({ label: 'Title tag', status: 'warn', detail: `"${title}" — ${tlen} chars. May truncate in SERPs.` });
					else essential.push({ label: 'Title tag', status: 'pass', detail: `"${title}" — ${tlen} chars.` });
					score++;
				} else essential.push({ label: 'Title tag', status: 'fail', detail: 'Missing. Every page needs a <title>.' });

				const desc = getMeta(doc, 'description');
				if (desc) {
					const dlen = desc.length;
					if (dlen < 120) essential.push({ label: 'Meta description', status: 'warn', detail: `${dlen} chars. Aim for 140–160.` });
					else if (dlen > 165) essential.push({ label: 'Meta description', status: 'warn', detail: `${dlen} chars. May truncate.` });
					else essential.push({ label: 'Meta description', status: 'pass', detail: `${dlen} chars.` });
					score++;
				} else essential.push({ label: 'Meta description', status: 'fail', detail: 'Missing.' });

				const viewport = getMeta(doc, 'viewport');
				if (viewport) { essential.push({ label: 'Viewport', status: 'pass', detail: viewport }); score++; }
				else essential.push({ label: 'Viewport', status: 'fail', detail: 'Missing. Page may not be mobile-friendly.' });

				const charset = doc.querySelector('meta[charset]');
				if (charset) { essential.push({ label: 'Charset', status: 'pass', detail: charset.getAttribute('charset') || 'set' }); score++; }
				else { essential.push({ label: 'Charset', status: 'warn', detail: 'No charset meta tag found.' }); score += 0.5; }
				checks.push({ group: 'Essential meta', items: essential });

				const og: Issue[] = [];
				total += 4;
				const ogTitle = getMeta(doc, 'og:title', 'property');
				if (ogTitle) { og.push({ label: 'og:title', status: 'pass', detail: `"${ogTitle}"` }); score++; }
				else og.push({ label: 'og:title', status: 'fail', detail: 'Missing. Required for social sharing.' });

				const ogDesc = getMeta(doc, 'og:description', 'property');
				if (ogDesc) { og.push({ label: 'og:description', status: 'pass', detail: `${ogDesc.length} chars` }); score++; }
				else og.push({ label: 'og:description', status: 'fail', detail: 'Missing.' });

				const ogImage = getMeta(doc, 'og:image', 'property');
				if (ogImage) { og.push({ label: 'og:image', status: 'pass', detail: ogImage.length > 80 ? ogImage.slice(0, 80) + '…' : ogImage }); score++; }
				else og.push({ label: 'og:image', status: 'fail', detail: 'Missing. Social shares will have no image.' });

				const ogType = getMeta(doc, 'og:type', 'property');
				if (ogType) { og.push({ label: 'og:type', status: 'pass', detail: ogType }); score++; }
				else { og.push({ label: 'og:type', status: 'warn', detail: 'Missing. Defaults to "website".' }); score += 0.5; }

				const ogUrl = getMeta(doc, 'og:url', 'property');
				og.push(ogUrl ? { label: 'og:url', status: 'pass', detail: ogUrl } : { label: 'og:url', status: 'warn', detail: 'Missing.' });
				checks.push({ group: 'Open Graph', items: og });

				const tw: Issue[] = [];
				total += 2;
				const twCard = getMeta(doc, 'twitter:card');
				if (twCard) { tw.push({ label: 'twitter:card', status: 'pass', detail: twCard }); score++; }
				else { tw.push({ label: 'twitter:card', status: 'warn', detail: 'Missing. Falls back to OG tags.' }); score += 0.5; }

				const twTitle = getMeta(doc, 'twitter:title');
				if (twTitle) { tw.push({ label: 'twitter:title', status: 'pass', detail: `"${twTitle}"` }); score++; }
				else { tw.push({ label: 'twitter:title', status: 'warn', detail: 'Missing. Falls back to og:title.' }); score += 0.5; }
				checks.push({ group: 'Twitter Card', items: tw });

				const tech: Issue[] = [];
				total += 2;
				const canonical = doc.querySelector('link[rel="canonical"]')?.getAttribute('href') || '';
				if (canonical) { tech.push({ label: 'Canonical URL', status: 'pass', detail: canonical }); score++; }
				else { tech.push({ label: 'Canonical URL', status: 'warn', detail: 'No canonical URL found.' }); score += 0.5; }

				const favicon = doc.querySelector('link[rel="icon"], link[rel="shortcut icon"]');
				if (favicon) { tech.push({ label: 'Favicon', status: 'pass', detail: favicon.getAttribute('href') || 'Set' }); score++; }
				else { tech.push({ label: 'Favicon', status: 'warn', detail: 'No favicon link found.' }); score += 0.5; }

				const lang = doc.documentElement.getAttribute('lang');
				tech.push(lang ? { label: 'Language attribute', status: 'pass', detail: `lang="${lang}"` } : { label: 'Language attribute', status: 'warn', detail: 'No lang attribute on <html>.' });
				checks.push({ group: 'Technical', items: tech });

				const finalScore = Math.round((score / total) * 100);
				const preview = { title: ogTitle || title, description: ogDesc || desc, image: ogImage, site: ogUrl ? new URL(ogUrl, 'http://x/').hostname : '' };
				return { score: finalScore, checks, preview };
			}

			function render(data: ReturnType<typeof analyze>, source: string) {
				const tier = data.score >= 80 ? 'good' : data.score >= 55 ? 'fair' : 'poor';
				const iconMap = { pass: '✓', warn: '!', fail: '✕' };

				let html = `
					<header class="report-header">
						<div class="score-badge score-${tier}" aria-label="Score ${data.score} out of 100">${data.score}</div>
						<div class="report-title">
							<h2>Meta tag report</h2>
							<p>${escapeHtml(source)}</p>
						</div>
					</header>
				`;

				if (data.preview.title) {
					html += `
						<div class="report-section">
							<h3>Search preview</h3>
							<div class="serp-preview">
								<div class="serp-url">${escapeHtml(data.preview.site || 'your-site.com')}</div>
								<div class="serp-title">${escapeHtml(data.preview.title)}</div>
								${data.preview.description ? `<p class="serp-desc">${escapeHtml(data.preview.description.slice(0, 160))}</p>` : ''}
							</div>
						</div>
					`;
				}

				for (const group of data.checks) {
					html += `
						<div class="report-section">
							<h3>${escapeHtml(group.group)}</h3>
							<ul class="issue-list">
								${group.items.map((i) => `
									<li class="issue">
										<span class="issue-icon ${i.status}" aria-hidden="true">${iconMap[i.status]}</span>
										<div class="issue-body">
											<p class="issue-label">${escapeHtml(i.label)}</p>
											<p class="issue-detail">${escapeHtml(i.detail)}</p>
										</div>
									</li>
								`).join('')}
							</ul>
						</div>
					`;
				}

				reportEl.innerHTML = html;
				reportEl.classList.add('visible');
				reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			async function run() {
				analyzeBtn.disabled = true;
				try {
					let html: string;
					let source: string;
					if (activeTab === 'url') {
						const u = urlInput.value.trim();
						if (!u) { setStatus('Enter a URL to analyze.', true); return; }
						setStatus('Fetching page…');
						const r = await fetchPage(u);
						html = r.html;
						source = r.url;
					} else {
						html = htmlInput.value.trim();
						if (!html) { setStatus('Paste HTML to analyze.', true); return; }
						source = 'Pasted HTML';
					}
					setStatus('');
					render(analyze(html), source);
				} catch (err) {
					setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
					reportEl.classList.remove('visible');
					reportEl.innerHTML = '';
				} finally {
					analyzeBtn.disabled = false;
				}
			}

			analyzeBtn.addEventListener('click', run);
			urlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); run(); } });
			clearBtn.addEventListener('click', () => {
				urlInput.value = ''; htmlInput.value = '';
				reportEl.innerHTML = ''; reportEl.classList.remove('visible'); setStatus('');
			});
		</script>
	</body>
</html>
