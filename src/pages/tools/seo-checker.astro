---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/tools.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free On-Page SEO Checker | ${SITE_TITLE}`}
			description="Comprehensive on-page SEO audit: title, meta, headings, images, links, content, mobile, and technical signals — scored out of 100. Free tool."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="tool-page">
			<a href="/tools" class="tool-back">← All Tools</a>
			<div class="tool-header">
				<p class="section-kicker">On-Page SEO</p>
				<h1>SEO Audit</h1>
				<p>Run a complete on-page SEO audit on any URL. Scores title, meta, headings, images, links, content depth, and technical signals — with prioritized fixes.</p>
			</div>

			<div class="tool-input-card">
				<div class="input-tabs" role="tablist" aria-label="Input mode">
					<button class="tab-btn" role="tab" aria-selected="true" data-tab="url" type="button">URL</button>
					<button class="tab-btn" role="tab" aria-selected="false" data-tab="html" type="button">Paste HTML</button>
				</div>
				<div class="tab-panel active" id="tab-url" role="tabpanel">
					<div class="tool-field">
						<label for="url-input">Page URL</label>
						<input id="url-input" type="url" placeholder="https://example.com/page" autocomplete="url" />
					</div>
				</div>
				<div class="tab-panel" id="tab-html" role="tabpanel">
					<div class="tool-field">
						<label for="html-input">Raw HTML</label>
						<textarea id="html-input" placeholder="Paste the page's HTML source"></textarea>
					</div>
				</div>
				<div class="tool-actions">
					<button class="btn-primary" id="analyze-btn" type="button">Run audit</button>
					<button class="btn-secondary" id="clear-btn" type="button">Clear</button>
				</div>
				<div class="tool-status" id="tool-status" role="status" aria-live="polite"></div>
			</div>

			<section class="report" id="report" aria-live="polite"></section>
		</main>
		<Footer />

		<script>
			type Issue = { label: string; status: 'pass' | 'warn' | 'fail'; detail: string };
			type Group = { group: string; items: Issue[] };

			const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
			const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
			const urlInput = document.getElementById('url-input') as HTMLInputElement;
			const htmlInput = document.getElementById('html-input') as HTMLTextAreaElement;
			const analyzeBtn = document.getElementById('analyze-btn') as HTMLButtonElement;
			const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
			const statusEl = document.getElementById('tool-status')!;
			const reportEl = document.getElementById('report')!;
			let activeTab: 'url' | 'html' = 'url';

			tabBtns.forEach((b) =>
				b.addEventListener('click', () => {
					tabBtns.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
					tabPanels.forEach((p) => p.classList.toggle('active', p.id === `tab-${b.dataset.tab}`));
					activeTab = b.dataset.tab as 'url' | 'html';
					statusEl.textContent = '';
					statusEl.classList.remove('error');
				}),
			);

			const setStatus = (t: string, err = false) => { statusEl.textContent = t; statusEl.classList.toggle('error', err); };
			const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

			async function fetchPage(url: string) {
				const res = await fetch(`/api/fetch-page?url=${encodeURIComponent(url)}`);
				if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || `Fetch failed (${res.status})`); }
				return res.json();
			}

			function analyze(html: string) {
				const doc = new DOMParser().parseFromString(html, 'text/html');
				const checks: Group[] = [];
				let score = 0, total = 0;

				const titleChecks: Issue[] = [];
				const title = doc.querySelector('title')?.textContent?.trim() || '';
				total += 2;
				if (!title) titleChecks.push({ label: 'Title tag', status: 'fail', detail: 'No title tag found.' });
				else if (title.length < 30) { titleChecks.push({ label: 'Title tag', status: 'warn', detail: `Short title (${title.length} chars). Aim for 50–60.` }); score += 0.5; }
				else if (title.length > 65) { titleChecks.push({ label: 'Title tag', status: 'warn', detail: `Long title (${title.length} chars). May truncate in search results.` }); score += 0.5; }
				else { titleChecks.push({ label: 'Title tag', status: 'pass', detail: `"${title}" (${title.length} chars)` }); score++; }

				const metaDesc = doc.querySelector('meta[name="description"]')?.getAttribute('content')?.trim() || '';
				if (!metaDesc) titleChecks.push({ label: 'Meta description', status: 'fail', detail: 'No meta description found.' });
				else if (metaDesc.length < 120) { titleChecks.push({ label: 'Meta description', status: 'warn', detail: `Short (${metaDesc.length} chars). Aim for 140–160.` }); score += 0.5; }
				else if (metaDesc.length > 170) { titleChecks.push({ label: 'Meta description', status: 'warn', detail: `Long (${metaDesc.length} chars). May truncate.` }); score += 0.5; }
				else { titleChecks.push({ label: 'Meta description', status: 'pass', detail: `${metaDesc.length} characters.` }); score++; }
				checks.push({ group: 'Title & meta', items: titleChecks });

				const headingChecks: Issue[] = [];
				const h1s = doc.querySelectorAll('h1');
				const h2s = doc.querySelectorAll('h2');
				total += 3;
				if (h1s.length === 0) headingChecks.push({ label: 'H1 tag', status: 'fail', detail: 'No H1 found. Every page needs exactly one H1.' });
				else if (h1s.length > 1) { headingChecks.push({ label: 'H1 tag', status: 'warn', detail: `Found ${h1s.length} H1 tags. Use exactly one.` }); score += 0.5; }
				else {
					const txt = h1s[0].textContent?.trim() || '';
					headingChecks.push({ label: 'H1 tag', status: 'pass', detail: `"${txt.length > 60 ? txt.slice(0, 60) + '…' : txt}"` });
					score++;
				}
				if (h2s.length === 0) headingChecks.push({ label: 'H2 sections', status: 'warn', detail: 'No H2 headings. Use H2s to break content into sections.' });
				else { headingChecks.push({ label: 'H2 sections', status: 'pass', detail: `${h2s.length} H2 heading${h2s.length === 1 ? '' : 's'}.` }); score++; }

				const allH = doc.querySelectorAll('h1, h2, h3, h4, h5, h6');
				let hierarchyOk = true, prev = 0;
				allH.forEach((h) => { const lvl = parseInt(h.tagName[1]); if (prev > 0 && lvl > prev + 1) hierarchyOk = false; prev = lvl; });
				if (hierarchyOk) { headingChecks.push({ label: 'Heading hierarchy', status: 'pass', detail: 'Headings follow a sequential order.' }); score++; }
				else { headingChecks.push({ label: 'Heading hierarchy', status: 'warn', detail: 'Heading levels are skipped. Keep them sequential (H1→H2→H3).' }); score += 0.5; }
				checks.push({ group: 'Headings', items: headingChecks });

				const imgChecks: Issue[] = [];
				const imgs = Array.from(doc.querySelectorAll('img'));
				total += 2;
				if (imgs.length === 0) { imgChecks.push({ label: 'Images', status: 'warn', detail: 'No images found. Images can improve engagement.' }); score += 0.5; }
				else {
					const noAlt = imgs.filter((img) => !img.getAttribute('alt')?.trim()).length;
					if (noAlt === 0) { imgChecks.push({ label: 'Alt text', status: 'pass', detail: `All ${imgs.length} images have alt text.` }); score++; }
					else imgChecks.push({ label: 'Alt text', status: 'fail', detail: `${noAlt} of ${imgs.length} images missing alt text.` });

					const noDim = imgs.filter((img) => !img.getAttribute('width') || !img.getAttribute('height')).length;
					if (noDim === 0) { imgChecks.push({ label: 'Image dimensions', status: 'pass', detail: 'All images have width and height set.' }); score++; }
					else { imgChecks.push({ label: 'Image dimensions', status: 'warn', detail: `${noDim} images missing dimensions. Causes layout shifts (CLS).` }); score += 0.5; }
				}
				checks.push({ group: 'Images', items: imgChecks });

				const linkChecks: Issue[] = [];
				const links = Array.from(doc.querySelectorAll('a[href]'));
				const internal = links.filter((a) => { const h = a.getAttribute('href') || ''; return h.startsWith('/') || h.startsWith('#'); }).length;
				const external = links.filter((a) => (a.getAttribute('href') || '').startsWith('http')).length;
				total += 1;
				linkChecks.push({ label: 'Total links', status: 'pass', detail: `${links.length} links — ${internal} internal, ${external} external.` });
				score++;
				if (internal < 2) linkChecks.push({ label: 'Internal links', status: 'warn', detail: 'Fewer than 2 internal links. Add more to strengthen site structure.' });
				else linkChecks.push({ label: 'Internal links', status: 'pass', detail: `${internal} internal links.` });
				checks.push({ group: 'Links', items: linkChecks });

				const contentChecks: Issue[] = [];
				const bodyText = doc.body?.textContent?.trim() || '';
				const wc = bodyText.split(/\s+/).filter(Boolean).length;
				total += 2;
				if (wc < 300) contentChecks.push({ label: 'Word count', status: 'fail', detail: `${wc} words. Below 300 underperforms in search.` });
				else if (wc < 1000) { contentChecks.push({ label: 'Word count', status: 'warn', detail: `${wc} words. Consider 1,000+ for competitive topics.` }); score += 0.5; }
				else { contentChecks.push({ label: 'Word count', status: 'pass', detail: `${wc.toLocaleString()} words.` }); score++; }

				const canonical = doc.querySelector('link[rel="canonical"]')?.getAttribute('href');
				if (canonical) { contentChecks.push({ label: 'Canonical URL', status: 'pass', detail: canonical }); score++; }
				else { contentChecks.push({ label: 'Canonical URL', status: 'warn', detail: 'No canonical URL. Add one to prevent duplicate-content issues.' }); score += 0.5; }

				const viewport = doc.querySelector('meta[name="viewport"]');
				contentChecks.push(viewport ? { label: 'Viewport meta', status: 'pass', detail: 'Mobile viewport configured.' } : { label: 'Viewport meta', status: 'fail', detail: 'No viewport meta tag. Page may not be mobile-friendly.' });

				const lang = doc.documentElement.getAttribute('lang');
				contentChecks.push(lang ? { label: 'Language attribute', status: 'pass', detail: `lang="${lang}"` } : { label: 'Language attribute', status: 'warn', detail: 'No lang attribute on <html>.' });

				const ogTitle = doc.querySelector('meta[property="og:title"]');
				const ogImage = doc.querySelector('meta[property="og:image"]');
				if (ogTitle && ogImage) contentChecks.push({ label: 'Open Graph', status: 'pass', detail: 'og:title and og:image present.' });
				else contentChecks.push({ label: 'Open Graph', status: 'warn', detail: 'Missing og:title or og:image. Social shares may look poor.' });

				const schemaScripts = doc.querySelectorAll('script[type="application/ld+json"]');
				contentChecks.push(schemaScripts.length > 0
					? { label: 'Structured data', status: 'pass', detail: `${schemaScripts.length} JSON-LD block${schemaScripts.length === 1 ? '' : 's'} found.` }
					: { label: 'Structured data', status: 'warn', detail: 'No JSON-LD schema found. Add Article/FAQPage/etc. for rich-result eligibility.' });

				checks.push({ group: 'Content & technical', items: contentChecks });

				const finalScore = Math.round((score / total) * 100);
				const summary = { wc, links: links.length, internal, external, imgs: imgs.length, h1: h1s.length, h2: h2s.length };
				return { score: finalScore, checks, summary };
			}

			function render(data: ReturnType<typeof analyze>, source: string) {
				const tier = data.score >= 80 ? 'good' : data.score >= 55 ? 'fair' : 'poor';
				const iconMap = { pass: '✓', warn: '!', fail: '✕' };
				const allIssues = data.checks.flatMap((g) => g.items);
				const fails = allIssues.filter((i) => i.status === 'fail');
				const warns = allIssues.filter((i) => i.status === 'warn');

				let html = `
					<header class="report-header">
						<div class="score-badge score-${tier}" aria-label="Score ${data.score} out of 100">${data.score}</div>
						<div class="report-title">
							<h2>On-page SEO report</h2>
							<p>${escapeHtml(source)} · ${data.summary.wc.toLocaleString()} words · ${data.summary.imgs} images · ${data.summary.links} links</p>
						</div>
					</header>

					<div class="stat-row">
						<div class="stat"><span class="stat-num">${fails.length}</span><span class="stat-label">Failing</span></div>
						<div class="stat"><span class="stat-num">${warns.length}</span><span class="stat-label">Warnings</span></div>
						<div class="stat"><span class="stat-num">${data.summary.h2}</span><span class="stat-label">H2 sections</span></div>
						<div class="stat"><span class="stat-num">${data.summary.internal}</span><span class="stat-label">Internal links</span></div>
					</div>
				`;

				if (fails.length || warns.length) {
					html += `
						<div class="report-section">
							<h3>Top fixes (sorted by impact)</h3>
							<ul class="issue-list">
								${[...fails, ...warns].slice(0, 6).map((i) => `
									<li class="issue">
										<span class="issue-icon ${i.status}" aria-hidden="true">${iconMap[i.status]}</span>
										<div class="issue-body">
											<p class="issue-label">${escapeHtml(i.label)}</p>
											<p class="issue-detail">${escapeHtml(i.detail)}</p>
										</div>
									</li>
								`).join('')}
							</ul>
						</div>
					`;
				}

				for (const group of data.checks) {
					html += `
						<div class="report-section">
							<h3>${escapeHtml(group.group)}</h3>
							<ul class="issue-list">
								${group.items.map((i) => `
									<li class="issue">
										<span class="issue-icon ${i.status}" aria-hidden="true">${iconMap[i.status]}</span>
										<div class="issue-body">
											<p class="issue-label">${escapeHtml(i.label)}</p>
											<p class="issue-detail">${escapeHtml(i.detail)}</p>
										</div>
									</li>
								`).join('')}
							</ul>
						</div>
					`;
				}

				reportEl.innerHTML = html;
				reportEl.classList.add('visible');
				reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			async function run() {
				analyzeBtn.disabled = true;
				try {
					let html: string;
					let source: string;
					if (activeTab === 'url') {
						const u = urlInput.value.trim();
						if (!u) { setStatus('Enter a URL to audit.', true); return; }
						setStatus('Fetching page…');
						const r = await fetchPage(u);
						html = r.html;
						source = r.url;
					} else {
						html = htmlInput.value.trim();
						if (!html) { setStatus('Paste HTML to audit.', true); return; }
						source = 'Pasted HTML';
					}
					setStatus('');
					render(analyze(html), source);
				} catch (err) {
					setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
					reportEl.classList.remove('visible'); reportEl.innerHTML = '';
				} finally {
					analyzeBtn.disabled = false;
				}
			}

			analyzeBtn.addEventListener('click', run);
			urlInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); run(); } });
			clearBtn.addEventListener('click', () => {
				urlInput.value = ''; htmlInput.value = '';
				reportEl.innerHTML = ''; reportEl.classList.remove('visible'); setStatus('');
			});
		</script>
	</body>
</html>
