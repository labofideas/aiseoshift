---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/tools.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free Heading Structure Checker | ${SITE_TITLE}`}
			description="Validate H1–H6 heading hierarchy on any URL. Checks H1 count, sequential nesting, duplicates, empty headings, and length. Free tool."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="tool-page">
			<a href="/tools" class="tool-back">← All Tools</a>
			<div class="tool-header">
				<p class="section-kicker">On-Page SEO</p>
				<h1>Heading Structure Checker</h1>
				<p>Validate your H1–H6 hierarchy for proper nesting, duplicate headings, empty tags, and length. Enter a URL or paste HTML source.</p>
			</div>

			<div class="tool-input-card">
				<div class="input-tabs" role="tablist" aria-label="Input mode">
					<button class="tab-btn" role="tab" aria-selected="true" aria-controls="tab-url" data-tab="url" type="button">URL</button>
					<button class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-html" data-tab="html" type="button">Paste HTML</button>
				</div>

				<div class="tab-panel active" id="tab-url" role="tabpanel">
					<div class="tool-field">
						<label for="url-input">Page URL</label>
						<input id="url-input" type="url" placeholder="https://example.com/page" autocomplete="url" />
						<span class="hint">We'll fetch the page server-side and analyze the rendered HTML.</span>
					</div>
				</div>

				<div class="tab-panel" id="tab-html" role="tabpanel">
					<div class="tool-field">
						<label for="html-input">Raw HTML</label>
						<textarea id="html-input" placeholder="Paste the page's HTML source code here"></textarea>
					</div>
				</div>

				<div class="tool-actions">
					<button class="btn-primary" id="analyze-btn" type="button">Analyze</button>
					<button class="btn-secondary" id="clear-btn" type="button">Clear</button>
				</div>
				<div class="tool-status" id="tool-status" role="status" aria-live="polite"></div>
			</div>

			<section class="report" id="report" aria-live="polite"></section>
		</main>
		<Footer />

		<script>
			type Issue = { label: string; status: 'pass' | 'warn' | 'fail'; detail: string };
			type Analysis = {
				counts: Record<string, number>;
				tree: { tag: string; text: string; level: number; error?: string }[];
				issues: Issue[];
				total: number;
			};

			const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
			const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
			const urlInput = document.getElementById('url-input') as HTMLInputElement;
			const htmlInput = document.getElementById('html-input') as HTMLTextAreaElement;
			const analyzeBtn = document.getElementById('analyze-btn') as HTMLButtonElement;
			const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
			const statusEl = document.getElementById('tool-status')!;
			const reportEl = document.getElementById('report')!;
			let activeTab: 'url' | 'html' = 'url';

			tabBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					tabBtns.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
					tabPanels.forEach((p) => p.classList.toggle('active', p.id === `tab-${btn.dataset.tab}`));
					activeTab = btn.dataset.tab as 'url' | 'html';
					statusEl.textContent = '';
					statusEl.classList.remove('error');
				});
			});

			function setStatus(text: string, error = false) {
				statusEl.textContent = text;
				statusEl.classList.toggle('error', error);
			}

			async function fetchPage(url: string): Promise<{ url: string; html: string }> {
				const res = await fetch(`/api/fetch-page?url=${encodeURIComponent(url)}`);
				if (!res.ok) {
					const data = await res.json().catch(() => ({}));
					throw new Error(data.error || `Fetch failed (${res.status})`);
				}
				return res.json();
			}

			function analyze(html: string): Analysis {
				const doc = new DOMParser().parseFromString(html, 'text/html');
				const headings = Array.from(doc.querySelectorAll('h1, h2, h3, h4, h5, h6'));
				const counts: Record<string, number> = { H1: 0, H2: 0, H3: 0, H4: 0, H5: 0, H6: 0 };
				const tree: Analysis['tree'] = [];
				const issues: Issue[] = [];
				let prevLevel = 0;
				let skippedLevels = false;
				headings.forEach((h) => {
					const tag = h.tagName;
					const level = parseInt(tag[1]);
					const raw = h.textContent?.trim() || '';
					const text = (raw.slice(0, 80) || '(empty)') + (raw.length > 80 ? '…' : '');
					counts[tag]++;
					let error: string | undefined;
					if (prevLevel > 0 && level > prevLevel + 1) {
						error = `Skipped H${prevLevel} → H${level}`;
						skippedLevels = true;
					}
					tree.push({ tag, text, level, error });
					prevLevel = level;
				});

				if (counts.H1 === 0) issues.push({ label: 'H1 tag', status: 'fail', detail: 'No H1 found. Every page needs exactly one H1.' });
				else if (counts.H1 === 1) issues.push({ label: 'H1 tag', status: 'pass', detail: 'Exactly one H1 found.' });
				else issues.push({ label: 'H1 tag', status: 'warn', detail: `Found ${counts.H1} H1 tags. Best practice is exactly one per page.` });

				if (counts.H2 === 0 && headings.length > 1) issues.push({ label: 'H2 sections', status: 'warn', detail: 'No H2 headings. Use H2s to break content into scannable sections.' });
				else if (counts.H2 > 0) issues.push({ label: 'H2 sections', status: 'pass', detail: `${counts.H2} H2 headings divide the page.` });

				if (skippedLevels) issues.push({ label: 'Hierarchy', status: 'fail', detail: 'Heading levels are skipped. Keep them sequential (H1 → H2 → H3) for accessibility and SEO.' });
				else if (headings.length > 0) issues.push({ label: 'Hierarchy', status: 'pass', detail: 'Headings follow a logical sequential order.' });

				const texts = headings.map((h) => h.textContent?.trim().toLowerCase() || '').filter(Boolean);
				const dupes = [...new Set(texts.filter((t, i) => texts.indexOf(t) !== i))];
				if (dupes.length > 0) issues.push({ label: 'Duplicate headings', status: 'warn', detail: `${dupes.length} duplicate heading text${dupes.length > 1 ? 's' : ''} found.` });
				else if (headings.length > 0) issues.push({ label: 'Duplicate headings', status: 'pass', detail: 'No duplicate heading text.' });

				const empty = headings.filter((h) => !h.textContent?.trim()).length;
				if (empty > 0) issues.push({ label: 'Empty headings', status: 'fail', detail: `${empty} heading${empty > 1 ? 's have' : ' has'} no text content.` });
				else if (headings.length > 0) issues.push({ label: 'Empty headings', status: 'pass', detail: 'All headings contain text.' });

				const longH = headings.filter((h) => (h.textContent?.trim().length || 0) > 70).length;
				if (longH > 0) issues.push({ label: 'Heading length', status: 'warn', detail: `${longH} heading${longH > 1 ? 's exceed' : ' exceeds'} 70 characters. Shorter headings scan better.` });
				else if (headings.length > 0) issues.push({ label: 'Heading length', status: 'pass', detail: 'All headings are 70 characters or fewer.' });

				return { counts, tree, issues, total: headings.length };
			}

			function calcScore(issues: Issue[]): { score: number; tier: 'good' | 'fair' | 'poor' } {
				let weight = 0;
				let lost = 0;
				for (const i of issues) {
					weight += 1;
					if (i.status === 'fail') lost += 1;
					else if (i.status === 'warn') lost += 0.45;
				}
				const score = weight === 0 ? 0 : Math.round((1 - lost / weight) * 100);
				const tier = score >= 80 ? 'good' : score >= 55 ? 'fair' : 'poor';
				return { score, tier };
			}

			function escapeHtml(s: string) {
				return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
			}

			function render(data: Analysis, source: string) {
				const { score, tier } = calcScore(data.issues);
				const iconMap = { pass: '✓', warn: '!', fail: '✕' };

				let html = `
					<header class="report-header">
						<div class="score-badge score-${tier}" aria-label="Score ${score} out of 100">${score}</div>
						<div class="report-title">
							<h2>Heading Structure Report</h2>
							<p>${escapeHtml(source)} · ${data.total} heading${data.total === 1 ? '' : 's'} found</p>
						</div>
					</header>

					<div class="stat-row">
						<div class="stat"><span class="stat-num">${data.total}</span><span class="stat-label">Total headings</span></div>
						<div class="stat"><span class="stat-num">${data.counts.H1}</span><span class="stat-label">H1</span></div>
						<div class="stat"><span class="stat-num">${data.counts.H2}</span><span class="stat-label">H2</span></div>
						<div class="stat"><span class="stat-num">${data.counts.H3 + data.counts.H4 + data.counts.H5 + data.counts.H6}</span><span class="stat-label">H3–H6</span></div>
					</div>

					<div class="report-section">
						<h3>Checks</h3>
						<ul class="issue-list">
							${data.issues.map((i) => `
								<li class="issue">
									<span class="issue-icon ${i.status}" aria-hidden="true">${iconMap[i.status]}</span>
									<div class="issue-body">
										<p class="issue-label">${escapeHtml(i.label)}</p>
										<p class="issue-detail">${escapeHtml(i.detail)}</p>
									</div>
								</li>
							`).join('')}
						</ul>
					</div>
				`;

				if (data.tree.length > 0) {
					html += `
						<div class="report-section">
							<h3>Heading tree</h3>
							<ul class="heading-tree">
								${data.tree.map((h) => `
									<li style="padding-left:${(h.level - 1) * 1.1}rem">
										<span class="h-tag">${h.tag}</span>
										<span class="h-text">${escapeHtml(h.text)}</span>
										${h.error ? `<span class="h-error">${escapeHtml(h.error)}</span>` : ''}
									</li>
								`).join('')}
							</ul>
						</div>
					`;
				} else {
					html += `<div class="report-section report-empty">No headings found in the source.</div>`;
				}

				reportEl.innerHTML = html;
				reportEl.classList.add('visible');
				reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			async function run() {
				analyzeBtn.disabled = true;
				try {
					let html: string;
					let source: string;
					if (activeTab === 'url') {
						const url = urlInput.value.trim();
						if (!url) { setStatus('Enter a URL to analyze.', true); return; }
						setStatus('Fetching page…');
						const result = await fetchPage(url);
						html = result.html;
						source = result.url;
					} else {
						html = htmlInput.value.trim();
						if (!html) { setStatus('Paste HTML to analyze.', true); return; }
						source = 'Pasted HTML';
					}
					setStatus('');
					render(analyze(html), source);
				} catch (err) {
					setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
					reportEl.classList.remove('visible');
					reportEl.innerHTML = '';
				} finally {
					analyzeBtn.disabled = false;
				}
			}

			analyzeBtn.addEventListener('click', run);
			[urlInput, htmlInput].forEach((el) => {
				el.addEventListener('keydown', (e) => {
					if ((e as KeyboardEvent).key === 'Enter' && (el.tagName === 'INPUT' || (e as KeyboardEvent).metaKey || (e as KeyboardEvent).ctrlKey)) {
						e.preventDefault();
						run();
					}
				});
			});
			clearBtn.addEventListener('click', () => {
				urlInput.value = '';
				htmlInput.value = '';
				reportEl.innerHTML = '';
				reportEl.classList.remove('visible');
				setStatus('');
			});
		</script>
	</body>
</html>
