---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/tools.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free Keyword Density Checker | ${SITE_TITLE}`}
			description="Analyze keyword density and prominence on any URL. Checks density vs target keyword, presence in title/H1/intro, and surfaces top related terms."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="tool-page">
			<a href="/tools" class="tool-back">← All Tools</a>
			<div class="tool-header">
				<p class="section-kicker">On-Page SEO</p>
				<h1>Keyword Density Checker</h1>
				<p>Measure how often your target keyword appears, where it shows up (title, H1, intro, meta), and which related terms dominate the page.</p>
			</div>

			<div class="tool-input-card">
				<div class="input-tabs" role="tablist" aria-label="Input mode">
					<button class="tab-btn" role="tab" aria-selected="true" data-tab="url" type="button">URL</button>
					<button class="tab-btn" role="tab" aria-selected="false" data-tab="html" type="button">Paste HTML or text</button>
				</div>
				<div class="tab-panel active" id="tab-url" role="tabpanel">
					<div class="tool-field">
						<label for="url-input">Page URL</label>
						<input id="url-input" type="url" placeholder="https://example.com/page" autocomplete="url" />
					</div>
				</div>
				<div class="tab-panel" id="tab-html" role="tabpanel">
					<div class="tool-field">
						<label for="html-input">HTML source or plain text</label>
						<textarea id="html-input" placeholder="Paste the full HTML source or just the body copy"></textarea>
					</div>
				</div>

				<div class="tool-field" style="margin-top: 1rem">
					<label for="keyword-input">Target keyword</label>
					<input id="keyword-input" type="text" placeholder="e.g. AI visibility" />
				</div>

				<div class="tool-actions">
					<button class="btn-primary" id="analyze-btn" type="button">Analyze</button>
					<button class="btn-secondary" id="clear-btn" type="button">Clear</button>
				</div>
				<div class="tool-status" id="tool-status" role="status" aria-live="polite"></div>
			</div>

			<section class="report" id="report" aria-live="polite"></section>
		</main>
		<Footer />

		<script>
			const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
			const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
			const urlInput = document.getElementById('url-input') as HTMLInputElement;
			const htmlInput = document.getElementById('html-input') as HTMLTextAreaElement;
			const keywordInput = document.getElementById('keyword-input') as HTMLInputElement;
			const analyzeBtn = document.getElementById('analyze-btn') as HTMLButtonElement;
			const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
			const statusEl = document.getElementById('tool-status')!;
			const reportEl = document.getElementById('report')!;
			let activeTab: 'url' | 'html' = 'url';

			tabBtns.forEach((b) =>
				b.addEventListener('click', () => {
					tabBtns.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
					tabPanels.forEach((p) => p.classList.toggle('active', p.id === `tab-${b.dataset.tab}`));
					activeTab = b.dataset.tab as 'url' | 'html';
					statusEl.textContent = '';
					statusEl.classList.remove('error');
				}),
			);

			const setStatus = (t: string, err = false) => { statusEl.textContent = t; statusEl.classList.toggle('error', err); };
			const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

			async function fetchPage(url: string) {
				const res = await fetch(`/api/fetch-page?url=${encodeURIComponent(url)}`);
				if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || `Fetch failed (${res.status})`); }
				return res.json();
			}

			function parseSource(raw: string) {
				const looksLikeHtml = raw.includes('<') && raw.includes('>');
				const doc = looksLikeHtml ? new DOMParser().parseFromString(raw, 'text/html') : null;
				const text = doc ? doc.body?.textContent?.trim() || raw : raw;
				return { doc, text };
			}

			function analyze(raw: string, keyword: string) {
				const { doc, text } = parseSource(raw);
				const words = text.split(/\s+/).filter(Boolean);
				const totalWords = words.length;
				const lowerText = text.toLowerCase();
				const kw = keyword.toLowerCase();

				const escaped = kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
				const regex = new RegExp(escaped, 'g');
				const kwCount = (lowerText.match(regex) || []).length;
				const kwWords = kw.split(/\s+/).filter(Boolean).length;
				const density = totalWords > 0 ? (kwCount * kwWords) / totalWords * 100 : 0;

				const inTitle = !!doc?.querySelector('title')?.textContent?.toLowerCase().includes(kw);
				const inH1 = !!(doc?.querySelector('h1')?.textContent?.toLowerCase() || '').includes(kw);
				const inFirstChunk = text.slice(0, 500).toLowerCase().includes(kw);
				const inMeta = !!doc?.querySelector('meta[name="description"]')?.getAttribute('content')?.toLowerCase().includes(kw);

				const sw = new Set('the,a,an,is,are,was,were,be,been,being,have,has,had,do,does,did,will,would,shall,should,may,might,must,can,could,to,of,in,for,on,with,at,by,from,as,into,through,during,before,after,above,below,between,and,but,or,nor,not,so,yet,both,either,neither,each,every,all,any,few,more,most,other,some,such,no,only,own,same,than,too,very,just,because,if,when,while,that,this,these,those,it,its,i,me,my,we,our,you,your,he,him,his,she,her,they,them,their,what,which,who,whom,how,where,why,also,about,up,out,then,there,here,new,one,two,like,well,back,even,us,much,get,go,make,many,way,use,over,take'.split(','));
				const freq = new Map<string, number>();
				words.forEach((w) => {
					const lw = w.toLowerCase().replace(/[^a-z0-9]/g, '');
					if (lw.length > 2 && !sw.has(lw)) freq.set(lw, (freq.get(lw) || 0) + 1);
				});
				const topWords = [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 15);

				let tier: 'good' | 'fair' | 'poor' = 'good';
				let densityMsg = 'Within the recommended 0.5–3% range. Looks natural and well-optimized.';
				if (kwCount === 0) { tier = 'poor'; densityMsg = `Keyword "${keyword}" not found in the content.`; }
				else if (density < 0.5) { tier = 'fair'; densityMsg = 'Below 0.5%. Consider using the keyword more naturally throughout.'; }
				else if (density > 3) { tier = 'poor'; densityMsg = 'Above 3%. Risks looking like keyword stuffing. Reduce usage.'; }

				const placements = [
					{ label: 'In title tag', pass: inTitle },
					{ label: 'In H1 heading', pass: inH1 },
					{ label: 'In first 500 characters', pass: inFirstChunk },
					{ label: 'In meta description', pass: inMeta },
				];

				let placementScore = placements.filter((p) => p.pass).length * 12;
				let densityScore = tier === 'good' ? 50 : tier === 'fair' ? 25 : 10;
				const score = Math.min(100, placementScore + densityScore);

				return { totalWords, kwCount, density, tier, densityMsg, placements, topWords, score, keyword };
			}

			function render(data: ReturnType<typeof analyze>, source: string) {
				const tier = data.score >= 80 ? 'good' : data.score >= 55 ? 'fair' : 'poor';
				const iconMap = { pass: '✓', warn: '!', fail: '✕' };

				let html = `
					<header class="report-header">
						<div class="score-badge score-${tier}" aria-label="Score ${data.score} out of 100">${data.score}</div>
						<div class="report-title">
							<h2>Keyword density report</h2>
							<p>${escapeHtml(source)} · target keyword <strong>"${escapeHtml(data.keyword)}"</strong></p>
						</div>
					</header>

					<div class="stat-row">
						<div class="stat"><span class="stat-num">${data.kwCount}</span><span class="stat-label">Occurrences</span></div>
						<div class="stat"><span class="stat-num">${data.density.toFixed(2)}%</span><span class="stat-label">Density</span></div>
						<div class="stat"><span class="stat-num">${data.totalWords.toLocaleString()}</span><span class="stat-label">Words</span></div>
					</div>

					<div class="report-section">
						<h3>Density assessment</h3>
						<p class="issue-detail" style="margin:0">${escapeHtml(data.densityMsg)}</p>
					</div>

					<div class="report-section">
						<h3>Keyword placement</h3>
						<ul class="issue-list">
							${data.placements.map((p) => `
								<li class="issue">
									<span class="issue-icon ${p.pass ? 'pass' : 'fail'}" aria-hidden="true">${iconMap[p.pass ? 'pass' : 'fail']}</span>
									<div class="issue-body">
										<p class="issue-label">${escapeHtml(p.label)}</p>
										<p class="issue-detail">${p.pass ? `"${escapeHtml(data.keyword)}" appears here.` : `Add "${escapeHtml(data.keyword)}" here for stronger relevance.`}</p>
									</div>
								</li>
							`).join('')}
						</ul>
					</div>
				`;

				if (data.topWords.length > 0) {
					const maxFreq = data.topWords[0][1];
					html += `
						<div class="report-section">
							<h3>Most-used terms (excluding stop words)</h3>
							<table class="report-table">
								<thead><tr><th>Term</th><th>Count</th><th>Density</th><th style="width:35%">Frequency</th></tr></thead>
								<tbody>
									${data.topWords.map(([word, count]) => `
										<tr>
											<td><strong>${escapeHtml(word)}</strong></td>
											<td>${count}</td>
											<td>${((count / data.totalWords) * 100).toFixed(2)}%</td>
											<td><div style="background:rgba(var(--signal-deep),0.18);height:8px;border-radius:4px;width:${Math.round((count / maxFreq) * 100)}%"></div></td>
										</tr>
									`).join('')}
								</tbody>
							</table>
						</div>
					`;
				}

				reportEl.innerHTML = html;
				reportEl.classList.add('visible');
				reportEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			async function run() {
				analyzeBtn.disabled = true;
				try {
					const keyword = keywordInput.value.trim();
					if (!keyword) { setStatus('Enter a target keyword to analyze.', true); return; }
					let raw: string;
					let source: string;
					if (activeTab === 'url') {
						const u = urlInput.value.trim();
						if (!u) { setStatus('Enter a URL to analyze.', true); return; }
						setStatus('Fetching page…');
						const r = await fetchPage(u);
						raw = r.html;
						source = r.url;
					} else {
						raw = htmlInput.value.trim();
						if (!raw) { setStatus('Paste content to analyze.', true); return; }
						source = 'Pasted content';
					}
					setStatus('');
					render(analyze(raw, keyword), source);
				} catch (err) {
					setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
					reportEl.classList.remove('visible'); reportEl.innerHTML = '';
				} finally {
					analyzeBtn.disabled = false;
				}
			}

			analyzeBtn.addEventListener('click', run);
			[urlInput, keywordInput].forEach((el) => el.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); run(); } }));
			clearBtn.addEventListener('click', () => {
				urlInput.value = ''; htmlInput.value = ''; keywordInput.value = '';
				reportEl.innerHTML = ''; reportEl.classList.remove('visible'); setStatus('');
			});
		</script>
	</body>
</html>
