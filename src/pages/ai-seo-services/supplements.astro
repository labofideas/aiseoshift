---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const CALENDLY_URL = 'https://calendly.com/shashank19/15min';
const WEB3FORMS_ACCESS_KEY = 'd165756b-c4fc-484f-9914-97af89d0421e';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	provider: { '@type': 'Organization', name: SITE_TITLE },
	areaServed: 'Worldwide',
	serviceType: 'AI SEO for Supplement Brands',
	description:
		'AI SEO services for supplement and nutraceutical brands that need claim-safe visibility in Google, AI Overviews, ChatGPT, and other AI search environments.',
};

const faqStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Do supplement brands need AI SEO?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Yes. Buyers now ask ChatGPT, Gemini, and Google AI Overviews which ingredients work, which products to trust, and which brand to choose, often before they ever land on a product page. Supplements are a YMYL category, so AI engines cite a narrow set of credible, claim-safe brands. If yours is not one of them, the recommendation goes to a competitor.',
			},
		},
		{
			'@type': 'Question',
			name: 'How do you keep supplement content compliant?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'We build content that educates and demonstrates expertise without crossing FTC or FDA lines on disease and efficacy claims. That means structure-function language done correctly, credentialed authors, cited evidence, and clear disclaimers. Compliance is not a tax on visibility here; the same signals that keep you legal are the ones that make AI engines trust and cite you.',
			},
		},
		{
			'@type': 'Question',
			name: 'Why is supplement SEO harder than normal ecommerce?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Supplements combine a YMYL trust bar, claim-compliance risk, ingredient-level buyer questions, and brutal competition from large brands and marketplaces. Generic ecommerce SEO ignores the trust and compliance layer, which is exactly the layer that decides whether an AI engine recommends you. It needs an approach built for regulated wellness products.',
			},
		},
		{
			'@type': 'Question',
			name: 'How much does supplement SEO cost?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Supplement and nutraceutical SEO typically ranges from $2,000 to $8,000 per month depending on catalog size, ingredient range, and competition, with one-time audits starting lower. The investment reflects the compliance complexity and the high lifetime value of subscription-driven supplement customers.',
			},
		},
		{
			'@type': 'Question',
			name: 'Can supplement brands get cited by ChatGPT and AI Overviews?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Yes, when the trust signals are there. AI engines pull from sources that demonstrate real expertise, cite evidence, and avoid overreaching claims. Brands earn citations through credentialed content, transparent testing and sourcing, Product and FAQ schema, and genuine reviews. We build those signals deliberately so your brand becomes the one the answer names.',
			},
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO for Supplement Brands | ${SITE_TITLE}`}
			description="Supplement and nutraceutical SEO powered by AI. Claim-safe content that gets your brand cited in Google, AI Overviews, and ChatGPT where buyers research."
			structuredData={structuredData}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
		<style>
			.svc-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }
			.svc-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.svc-kicker { display: inline-flex; padding: 0; color: var(--ink-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
			.svc-hero h1 { font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1; letter-spacing: -0.03em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 16ch; }
			.svc-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0; }
			.svc-cta-row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-5); }
			.svc-btn { display: inline-flex; align-items: center; padding: 0.85rem 1.4rem; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
			.svc-btn-primary { background: rgb(var(--ink)); color: rgb(var(--paper)); }
			.svc-btn-primary:hover { background: var(--signal-deep); }
			.svc-btn-secondary { background: transparent; color: rgb(var(--ink)); border: 1px solid var(--line-strong); }
			.svc-btn-secondary:hover { border-color: rgb(var(--ink)); }
			.svc-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.svc-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 18ch; }
			.svc-section > p { font-size: 1.05rem; line-height: 1.65; color: rgba(var(--ink), 0.82); max-width: var(--measure); margin: 0 0 var(--space-6); }
			.svc-list { list-style: none; margin: 0; padding: 0; }
			.svc-list li { margin: 0; }
			.svc-row { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-6); align-items: baseline; padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.svc-list li:last-child .svc-row { border-bottom: 1px solid var(--line); }
			.svc-row-num { font-family: 'Iowan Old Style', Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.1rem; color: var(--ink-muted); }
			.svc-row h3 { font-size: 1.3rem; line-height: 1.2; margin: 0 0 var(--space-2); letter-spacing: -0.018em; font-weight: 600; }
			.svc-row p { font-size: 0.95rem; line-height: 1.55; color: var(--ink-muted); margin: 0 0 var(--space-3); max-width: 52ch; }
			.svc-row ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
			.svc-row ul li { font-size: 0.82rem; color: var(--ink-muted); }
			.svc-row ul li + li::before { content: '·'; margin-right: var(--space-3); color: var(--line-strong); }
			.outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; }
			.outcome { padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
			.outcome strong { display: block; font-family: 'Iowan Old Style', Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.15rem; color: rgb(var(--ink)); margin-bottom: var(--space-3); }
			.outcome span { font-size: 0.95rem; color: var(--ink-muted); line-height: 1.55; }
			.contact-block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; align-items: start; }
			@media (max-width: 860px) { .svc-hero, .outcomes, .contact-block { grid-template-columns: 1fr; } .svc-row { grid-template-columns: 1fr; gap: var(--space-3); } }
			.contact-card { padding: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); }
			.contact-card h3 { font-size: 1.25rem; margin: 0 0 var(--space-3); letter-spacing: -0.015em; font-weight: 600; }
			.contact-card > p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); margin: 0 0 var(--space-5); }
			.contact-form { display: flex; flex-direction: column; gap: var(--space-3); }
			.contact-form label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; color: rgba(var(--ink), 0.85); text-transform: uppercase; }
			.contact-form .req { color: var(--signal-deep); margin-left: 0.15rem; }
			.contact-form input:focus-visible, .contact-form select:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; border-color: rgb(var(--ink)); }
			.contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 0.7rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font-size: 0.95rem; font-family: inherit; background: rgb(var(--paper)); color: rgb(var(--ink)); box-sizing: border-box; }
			.contact-form textarea { min-height: 120px; resize: vertical; }
			.contact-form button { margin-top: var(--space-3); padding: 0.85rem 1rem; background: rgb(var(--ink)); color: rgb(var(--paper)); font-weight: 600; font-size: 0.95rem; border: none; border-radius: var(--radius-sm); cursor: pointer; }
			.contact-form button:hover { background: var(--signal-deep); }
			.form-status { margin-top: var(--space-3); font-size: 0.9rem; display: none; }
			.form-status.success { display: block; color: #047857; }
			.form-status.error { display: block; color: #b91c1c; }
			.faq-list { margin: 0; padding: 0; list-style: none; }
			.faq-list li { padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.faq-list li:last-child { border-bottom: 1px solid var(--line); }
			.faq-list h3 { font-size: 1.1rem; margin: 0 0 var(--space-2); letter-spacing: -0.012em; font-weight: 600; }
			.faq-list p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); max-width: 56ch; }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="svc-page">
			<section class="svc-hero">
				<div>
					<span class="svc-kicker">AI SEO for Supplements</span>
					<h1>AI SEO for Supplement Brands</h1>
				</div>
				<div class="svc-hero-lede">
					<p>
						Buyers now ask AI which ingredients work, which products to trust, and which brand to pick, often before they reach a product page. Supplements sit in the <a href="/seo/eeat/">YMYL category</a>, so AI engines recommend a narrow set of credible, claim-safe brands and quietly skip the rest. We help supplement and nutraceutical brands build the trust signals that get them cited.
					</p>
					<div class="svc-cta-row">
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min call &rarr;</a>
						<a class="svc-btn svc-btn-secondary" href="#quote">Request a quote</a>
						<a class="svc-btn svc-btn-secondary" href="/sample-seo-audit/">See a sample audit &rarr;</a>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>The challenge: buyers research with AI first</h2>
				<p>
					Supplement shopping starts with a question, not a product page. People ask whether an ingredient works, what dose makes sense, and which brand is worth trusting. AI answers those questions now, and it answers them by naming a few brands it trusts.
				</p>
				<div class="outcomes">
					<div class="outcome"><strong>AI answers ingredient questions</strong><span>Does magnesium glycinate help sleep? Is creatine safe long term? AI Overviews and ChatGPT field these daily, citing a handful of sources. Brands outside that set never enter the buyer's consideration.</span></div>
					<div class="outcome"><strong>Claims are a trust test</strong><span>Overreaching on efficacy is both an FTC and FDA risk and a fast way to get filtered out of AI answers. Claim-safe, evidence-backed content is what earns citation in this category.</span></div>
					<div class="outcome"><strong>Trust concentrates</strong><span>Because supplements are <a href="/seo/eeat/">YMYL</a>, engines lean on brands that look credible and transparent. That concentration rewards brands that build real authority and sidelines everyone else.</span></div>
				</div>
			</section>

			<section class="svc-section">
				<h2>What we do</h2>
				<p>Three services built for supplement and nutraceutical brands: audit, claim-safe authority building, and ongoing AI search growth.</p>
				<ol class="svc-list">
					<li>
						<div class="svc-row">
							<span class="svc-row-num">01</span>
							<div>
								<h3>Supplement Visibility & Claim Audit</h3>
								<p>A full review of how your brand appears across Google Search, <a href="/ai-overviews-seo/">AI Overviews</a>, ChatGPT, and Perplexity for your ingredients and products, paired with a claim-compliance check and a prioritized plan.</p>
								<ul><li>AI citation analysis for ingredients and products</li><li>FTC and FDA claim-compliance review</li><li><a href="/seo/schema-markup/">Product and FAQ schema</a> audit</li><li>Trust-signal review (testing, sourcing, reviews)</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">02</span>
							<div>
								<h3>Claim-Safe Authority Building</h3>
								<p>Implementation that makes your brand citable: evidence-backed ingredient and product content, credentialed authors, and the structured data engines need to trust a regulated wellness product.</p>
								<ul><li>Evidence-backed, claim-safe content</li><li>Credentialed author <a href="/seo/eeat/">E-E-A-T</a> profiles</li><li>Product, Organization, and FAQ <a href="/seo/schema-markup/">schema</a></li><li>Ingredient and condition-adjacent topic depth</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">03</span>
							<div>
								<h3>Ongoing Supplement AI SEO</h3>
								<p>Monthly support that combines ingredient and product content, <a href="/geo/">generative engine optimization</a>, and AI visibility monitoring into one operating rhythm.</p>
								<ul><li>Ingredient, product, and education content</li><li><a href="/geo/">GEO</a> for AI citation</li><li>Review and reputation strategy</li><li>AI citation monitoring and monthly reporting</li></ul>
							</div>
						</div>
					</li>
				</ol>
			</section>

			<section class="svc-section">
				<h2>Why supplements need specialized AI SEO</h2>
				<p>
					Supplements are not generic ecommerce. The trust bar, the claim risk, and the ingredient-level way people search all demand an approach built for regulated wellness products.
				</p>
				<div class="outcomes">
					<div class="outcome"><strong>YMYL trust bar</strong><span>Health-adjacent products face the strictest evaluation from both Google's raters and <a href="/ai-seo-shift/">AI systems</a>. Weak trust signals mean exclusion, not just lower rankings.</span></div>
					<div class="outcome"><strong>Compliance and visibility are one job</strong><span>The claim-safe content that keeps you legal is the same content that earns AI citation. We treat them as a single discipline.</span></div>
					<div class="outcome"><strong>High lifetime value</strong><span>Supplement buyers subscribe and reorder. Winning the AI recommendation once can mean a customer for years, which makes citation worth the work.</span></div>
				</div>
			</section>

			<section class="svc-section" id="quote">
				<h2>Get a quote</h2>
				<p>Book a free 15-minute strategy call or send a quote request below. We respond within one business day.</p>
				<div class="contact-block">
					<div class="contact-card">
						<h3>Book a strategy call</h3>
						<p>We will review your brand's current visibility, your claim posture, and where supplement AI SEO can have the biggest impact.</p>
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Open Calendly &rarr;</a>
					</div>
					<div class="contact-card">
						<h3 id="quote-form-heading">Request a quote by form</h3>
						<p>Tell us about your brand and goals, and we will reply with a tailored plan and next steps.</p>
						<form class="contact-form" id="quote-form" aria-labelledby="quote-form-heading">
							<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
							<input type="hidden" name="subject" value="Supplement AI SEO quote request from aiseoshift.com" />
							<input type="hidden" name="from_name" value="AISEOShift Supplement Quote Form" />
							<input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
							<label for="q-name">Name <span class="req" aria-hidden="true">*</span></label>
							<input id="q-name" type="text" name="name" required aria-required="true" autocomplete="name" />
							<label for="q-email">Email <span class="req" aria-hidden="true">*</span></label>
							<input id="q-email" type="email" name="email" required aria-required="true" autocomplete="email" />
							<label for="q-company">Brand / website</label>
							<input id="q-company" type="text" name="company" autocomplete="organization" />
							<label for="q-service">Service interested in <span class="req" aria-hidden="true">*</span></label>
							<select id="q-service" name="service" required aria-required="true">
								<option value="">Select a service...</option>
								<option value="Supplement Visibility & Claim Audit">Supplement Visibility &amp; Claim Audit</option>
								<option value="Claim-Safe Authority Building">Claim-Safe Authority Building</option>
								<option value="Ongoing Supplement AI SEO">Ongoing Supplement AI SEO</option>
								<option value="Not sure yet">Not sure yet</option>
							</select>
							<label for="q-message">Tell us about your brand and goals <span class="req" aria-hidden="true">*</span></label>
							<textarea id="q-message" name="message" required aria-required="true" placeholder="What products and ingredients do you sell? What are your growth goals?"></textarea>
							<button type="submit">Send quote request</button>
							<div class="form-status" id="form-status" role="status" aria-live="polite"></div>
						</form>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>FAQs</h2>
				<ul class="faq-list">
					<li>
						<h3>Do supplement brands need AI SEO?</h3>
						<p>Yes. Buyers ask ChatGPT, Gemini, and Google AI Overviews which ingredients work and which brand to trust, often before they reach a product page. Supplements are a <a href="/seo/eeat/">YMYL</a> category, so AI engines cite a narrow set of credible, claim-safe brands. If yours is not one, the recommendation goes to a competitor.</p>
					</li>
					<li>
						<h3>How do you keep supplement content compliant?</h3>
						<p>We build content that educates and demonstrates expertise without crossing FTC or FDA lines on disease and efficacy claims: structure-function language done correctly, credentialed authors, cited evidence, and clear disclaimers. The same signals that keep you legal make AI engines trust and cite you.</p>
					</li>
					<li>
						<h3>Why is supplement SEO harder than normal ecommerce?</h3>
						<p>Supplements combine a YMYL trust bar, claim-compliance risk, ingredient-level buyer questions, and competition from large brands and marketplaces. Generic ecommerce SEO ignores the trust and compliance layer, which is the layer that decides whether an AI engine recommends you.</p>
					</li>
					<li>
						<h3>How much does supplement SEO cost?</h3>
						<p>Supplement and nutraceutical SEO typically ranges from $2,000 to $8,000 per month depending on catalog size, ingredient range, and competition, with one-time audits starting lower. The investment reflects compliance complexity and the high lifetime value of subscription-driven supplement customers.</p>
					</li>
					<li>
						<h3>Can supplement brands get cited by ChatGPT and AI Overviews?</h3>
						<p>Yes, when the trust signals are there. Engines pull from sources that show real expertise, cite evidence, and avoid overreaching claims. Brands earn citations through credentialed content, transparent testing and sourcing, <a href="/seo/schema-markup/">schema</a>, and genuine reviews. We build those signals so your brand becomes the one the answer names.</p>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				const form = document.getElementById('quote-form');
				const status = document.getElementById('form-status');
				if (!form || !status) return;
				form.addEventListener('submit', async function (e) {
					e.preventDefault();
					status.className = 'form-status';
					status.textContent = '';
					const accessKey = form.querySelector('input[name="access_key"]').value;
					if (!accessKey || accessKey === 'REPLACE_WITH_WEB3FORMS_KEY') {
						status.className = 'form-status error';
						status.textContent = 'Form not configured yet. Email hello@aiseoshift.com directly.';
						return;
					}
					const formData = new FormData(form);
					try {
						const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { Accept: 'application/json' }, body: formData });
						const data = await res.json();
						if (data.success) {
							status.className = 'form-status success';
							status.textContent = 'Thanks! We received your request and will reply within one business day.';
							form.reset();
						} else {
							status.className = 'form-status error';
							status.textContent = 'Something went wrong. Please email hello@aiseoshift.com directly.';
						}
					} catch {
						status.className = 'form-status error';
						status.textContent = 'Network error. Please try again or email hello@aiseoshift.com directly.';
					}
				});
			})();
		</script>
	</body>
</html>
