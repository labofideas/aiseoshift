---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const CALENDLY_URL = 'https://calendly.com/shashank19/15min';
const WEB3FORMS_ACCESS_KEY = 'd165756b-c4fc-484f-9914-97af89d0421e';

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		provider: { '@type': 'Organization', name: SITE_TITLE },
		areaServed: 'Worldwide',
		serviceType: 'AI SEO for Chiropractors',
		description:
			'AI SEO services for chiropractors and chiropractic clinics that need visibility in Google, AI Overviews, ChatGPT, Perplexity, and other AI search environments.',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'How much does SEO cost for chiropractors?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Chiropractic SEO typically ranges from $1,000 to $4,500 per month depending on market size, number of locations, and competition. Single-doctor clinics need less than multi-provider practices. One-time audits start lower. Many chiropractors get quick wins from Google Business Profile and review velocity work before any heavy content investment.',
				},
			},
			{
				'@type': 'Question',
				name: 'How long does chiropractic SEO take to work?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Most chiropractic clinics see measurable improvements in three to six months. Local pack and Google Business Profile work tends to show fastest results. Highly competitive metros for "chiropractor near me" can take longer, but condition-specific pages (sciatica, herniated disc, sports injuries) often rank faster.',
				},
			},
			{
				'@type': 'Question',
				name: 'Do chiropractors need AI SEO?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. Patients now ask ChatGPT about back pain, sciatica, and treatment options before they ever book an appointment. Google AI Overviews answer questions like "is a chiropractor safe for sciatica" directly. Chiropractic content is YMYL, so AI systems apply strict trust filters — clinics without proper authority signals are invisible in AI answers.',
				},
			},
			{
				'@type': 'Question',
				name: 'How important are reviews for chiropractor SEO?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Reviews are one of the most important ranking factors for chiropractors. They drive local pack rankings, influence Google Business Profile prominence, and are weighted heavily by AI systems when recommending healthcare providers. A clinic with high review volume and recent positive reviews dramatically outperforms competitors with stale or low review counts.',
				},
			},
			{
				'@type': 'Question',
				name: 'Should chiropractors write content for specific conditions?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. Condition-specific pages — sciatica, lower back pain, herniated disc, scoliosis, sports injuries, whiplash — are the highest-converting pages for chiropractic SEO. They map directly to how patients search and how AI systems classify treatment queries. Each condition page should include symptoms, treatment approach, and author attribution to a licensed chiropractor.',
				},
			},
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO for Chiropractors and Chiropractic Clinics | ${SITE_TITLE}`}
			description="Chiropractor SEO and AI visibility services. Win Google AI Overviews, ChatGPT recommendations, and the local pack for back pain and treatment queries."
			structuredData={structuredData}
		/>
		<style>
			.svc-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }

			.svc-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.svc-kicker { display: inline-flex; padding: 0; color: var(--ink-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
			.svc-hero h1 { font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1; letter-spacing: -0.03em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 16ch; }
			.svc-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0; }

			.svc-cta-row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-5); }
			.svc-btn { display: inline-flex; align-items: center; padding: 0.85rem 1.4rem; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
			.svc-btn-primary { background: rgb(var(--ink)); color: rgb(var(--paper)); }
			.svc-btn-primary:hover { background: var(--signal-deep); }
			.svc-btn-secondary { background: transparent; color: rgb(var(--ink)); border: 1px solid var(--line-strong); }
			.svc-btn-secondary:hover { border-color: rgb(var(--ink)); }

			.svc-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.svc-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 18ch; }
			.svc-section > p { font-size: 1.05rem; line-height: 1.65; color: rgba(var(--ink), 0.82); max-width: var(--measure); margin: 0 0 var(--space-6); }

			.svc-list { list-style: none; margin: 0; padding: 0; }
			.svc-list li { margin: 0; }
			.svc-row { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-6); align-items: baseline; padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.svc-list li:last-child .svc-row { border-bottom: 1px solid var(--line); }
			.svc-row-num { font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-style: italic; font-weight: 400; font-size: 1.1rem; color: var(--ink-muted); }
			.svc-row h3 { font-size: 1.3rem; line-height: 1.2; margin: 0 0 var(--space-2); letter-spacing: -0.018em; font-weight: 600; }
			.svc-row p { font-size: 0.95rem; line-height: 1.55; color: var(--ink-muted); margin: 0 0 var(--space-3); max-width: 52ch; }
			.svc-row ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
			.svc-row ul li { font-size: 0.82rem; color: var(--ink-muted); }
			.svc-row ul li + li::before { content: '·'; margin-right: var(--space-3); color: var(--line-strong); }

			.outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; }
			.outcome { padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
			.outcome strong { display: block; font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-style: italic; font-weight: 400; font-size: 1.15rem; color: rgb(var(--ink)); margin-bottom: var(--space-3); }
			.outcome span { font-size: 0.95rem; color: var(--ink-muted); line-height: 1.55; }

			.contact-block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; align-items: start; }
			@media (max-width: 860px) { .svc-hero, .outcomes, .contact-block { grid-template-columns: 1fr; } .svc-row { grid-template-columns: 1fr; gap: var(--space-3); } }

			.contact-card { padding: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); }
			.contact-card h3 { font-size: 1.25rem; margin: 0 0 var(--space-3); letter-spacing: -0.015em; font-weight: 600; }
			.contact-card > p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); margin: 0 0 var(--space-5); }
			.contact-form { display: flex; flex-direction: column; gap: var(--space-3); }
			.contact-form label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; color: rgba(var(--ink), 0.85); text-transform: uppercase; }
			.contact-form .req { color: var(--signal-deep); margin-left: 0.15rem; }
			.contact-form input:focus-visible, .contact-form select:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; border-color: rgb(var(--ink)); }
			.contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 0.7rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font-size: 0.95rem; font-family: inherit; background: rgb(var(--paper)); color: rgb(var(--ink)); box-sizing: border-box; }
			.contact-form textarea { min-height: 120px; resize: vertical; }
			.contact-form button { margin-top: var(--space-3); padding: 0.85rem 1rem; background: rgb(var(--ink)); color: rgb(var(--paper)); font-weight: 600; font-size: 0.95rem; border: none; border-radius: var(--radius-sm); cursor: pointer; }
			.contact-form button:hover { background: var(--signal-deep); }
			.form-status { margin-top: var(--space-3); font-size: 0.9rem; display: none; }
			.form-status.success { display: block; color: #047857; }
			.form-status.error { display: block; color: #b91c1c; }

			.faq-list { margin: 0; padding: 0; list-style: none; }
			.faq-list li { padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.faq-list li:last-child { border-bottom: 1px solid var(--line); }
			.faq-list h3 { font-size: 1.1rem; margin: 0 0 var(--space-2); letter-spacing: -0.012em; font-weight: 600; }
			.faq-list p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); max-width: 56ch; }

			.svc-figure { margin: var(--space-6) 0 0; padding: 0; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); overflow: hidden; }
			.svc-figure svg { display: block; width: 100%; height: auto; }
			.svc-figure figcaption { padding: 0.75rem 1rem; border-top: 1px solid var(--line); font-size: 0.85rem; line-height: 1.55; font-style: italic; color: var(--ink-muted); }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="svc-page">
			<section class="svc-hero">
				<div>
					<span class="svc-kicker">AI SEO for Chiropractors</span>
					<h1>AI SEO for Chiropractors and Chiropractic Clinics</h1>
				</div>
				<div class="svc-hero-lede">
					<p>
						Patients with back pain do not start with a phone call. They google their symptoms, ask
						ChatGPT whether a chiropractor can help, and look at AI-summarized "best chiropractor near
						me" lists. Chiropractic content is <a href="/seo/eeat/">YMYL</a>, the strictest trust class,
						so AI systems are ruthless about which clinics they recommend. We help chiropractors build
						the credentials, content, and local pack presence that gets them cited.
					</p>
					<div class="svc-cta-row">
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min call &rarr;</a>
						<a class="svc-btn svc-btn-secondary" href="#quote">Request a quote</a>
					</div>
				</div>
			</section>

			<figure class="svc-figure" aria-labelledby="svc-figure-caption">
				<svg viewBox="0 0 1080 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="How chiropractic clinics get cited by AI: Google Business Profile, condition-specific pages, doctor credentials schema, and review velocity flow into a cited clinic recommendation">
					<rect width="1080" height="360" fill="rgb(246,245,240)" />
					<g stroke="rgb(14,17,22)" stroke-opacity="0.06"><line x1="0" y1="48" x2="1080" y2="48" /><line x1="0" y1="312" x2="1080" y2="312" /></g>
					<text x="48" y="32" font-family="system-ui, sans-serif" font-size="12" letter-spacing="3" fill="rgb(14,17,22)" fill-opacity="0.6">INPUT SIGNALS</text>
					<text x="540" y="32" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" letter-spacing="3" fill="rgb(14,17,22)" fill-opacity="0.6">YMYL FILTER</text>
					<text x="1032" y="32" text-anchor="end" font-family="system-ui, sans-serif" font-size="12" letter-spacing="3" fill="rgb(184,85,46)">CITED OUTCOME</text>
					<g font-family="system-ui, sans-serif" font-size="13" fill="rgb(14,17,22)">
						<g transform="translate(48 80)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">Google Business Profile</text></g>
						<g transform="translate(48 132)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">Condition-specific pages</text></g>
						<g transform="translate(48 184)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">Doctor credentials schema</text></g>
						<g transform="translate(48 236)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">Recent review velocity</text></g>
					</g>
					<g stroke="rgb(14,17,22)" stroke-opacity="0.2" fill="none">
						<path d="M 288 100 C 360 100, 380 178, 440 178" /><path d="M 288 152 C 360 152, 380 178, 440 178" /><path d="M 288 204 C 360 204, 380 178, 440 178" /><path d="M 288 256 C 360 256, 380 178, 440 178" />
					</g>
					<g transform="translate(440 130)">
						<rect width="200" height="100" fill="rgb(14,17,22)" rx="6" />
						<text x="100" y="42" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" letter-spacing="2" fill="rgb(250,250,247)" fill-opacity="0.6">AI ENGINES · YMYL</text>
						<text x="100" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="rgb(250,250,247)">ChatGPT · Perplexity</text>
						<text x="100" y="86" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="rgb(250,250,247)">AI Overviews · Maps</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 640 180 C 700 180, 760 180, 820 180" />
						<polyline points="810,174 820,180 810,186" />
					</g>
					<g transform="translate(820 110)">
						<rect width="212" height="140" fill="rgb(250,250,247)" stroke="rgb(184,85,46)" stroke-width="1.5" rx="6" />
						<circle cx="32" cy="38" r="18" fill="rgb(184,85,46)" />
						<text x="32" y="44" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" font-weight="700" fill="rgb(250,250,247)">01</text>
						<text x="62" y="36" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="rgb(14,17,22)">Cited chiropractor</text>
						<text x="62" y="54" font-family="system-ui, sans-serif" font-size="11" fill="rgb(14,17,22)" fill-opacity="0.6">for sciatica relief</text>
						<rect x="20" y="76" width="172" height="6" rx="1" fill="rgb(14,17,22)" fill-opacity="0.75" />
						<rect x="20" y="88" width="140" height="4" rx="1" fill="rgb(14,17,22)" fill-opacity="0.35" />
						<rect x="20" y="98" width="156" height="4" rx="1" fill="rgb(14,17,22)" fill-opacity="0.35" />
						<rect x="20" y="108" width="120" height="4" rx="1" fill="rgb(14,17,22)" fill-opacity="0.35" />
					</g>
					<text id="svc-figure-caption" x="540" y="340" text-anchor="middle" font-family="Figtree, system-ui, sans-serif" font-style="italic" font-size="13" fill="rgb(14,17,22)" fill-opacity="0.7">Patients search by condition. AI engines recommend clinics with condition-specific depth and credentialed authorship.</text>
				</svg>
			</figure>

			<section class="svc-section">
				<h2>The challenge: pain searches are now AI-mediated</h2>
				<p>
					Back pain, sciatica, herniated disc, and whiplash queries are some of the most searched
					health topics on the internet. They are also among the most aggressively summarized by
					AI Overviews and answer engines, because the answers are well-bounded.
				</p>
				<div class="outcomes">
					<div class="outcome"><strong>Symptom queries get summarized</strong><span>Google AI Overviews answer "what causes lower back pain" or "is sciatica permanent" without sending the user to any clinic. Only clinics that are cited as sources benefit.</span></div>
					<div class="outcome"><strong>Patients self-research treatment</strong><span>People ask ChatGPT whether chiropractic care is safe, whether it works for sciatica, and how to choose between options. AI answers shape the appointment decision before the phone rings.</span></div>
					<div class="outcome"><strong>Local pack still decides bookings</strong><span>Once a patient decides on chiropractic, the local pack and Google Business Profile decide which clinic. Reviews, hours, and proximity dominate.</span></div>
				</div>
			</section>

			<section class="svc-section">
				<h2>What we do for chiropractors</h2>
				<p>Three services built for the local pack, condition-specific search, and the strict YMYL trust filters AI systems apply to healthcare.</p>
				<ol class="svc-list">
					<li>
						<div class="svc-row">
							<span class="svc-row-num">01</span>
							<div>
								<h3>Chiropractic Visibility Audit</h3>
								<p>A complete review of how your clinic appears across Google Search, the local pack, AI Overviews, ChatGPT, and Perplexity for the conditions you treat and the city you serve. You get a prioritized roadmap built around the searches that convert into appointments.</p>
								<ul><li>Google Business Profile audit</li><li>AI citation analysis by condition</li><li>Local pack and map rank tracking</li><li>Review velocity and sentiment review</li><li><a href="/seo/eeat/">E-E-A-T</a> and YMYL compliance review</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">02</span>
							<div>
								<h3>Condition and Authority Optimization</h3>
								<p>Implementation work that builds out the condition-specific pages, doctor author profiles, and structured data that AI systems need to trust and cite your clinic.</p>
								<ul><li>Condition-specific landing pages</li><li>Doctor author pages with credentials</li><li>Physician and LocalBusiness <a href="/seo/schema-markup/">schema</a></li><li>Review generation systems</li><li>NAP and citation cleanup</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">03</span>
							<div>
								<h3>Ongoing Chiropractic AI SEO</h3>
								<p>Monthly support combining condition content, patient education, Google Business Profile management, review systems, and AI citation monitoring so you stay the cited clinic for the conditions you treat.</p>
								<ul><li>Monthly condition and patient-education content</li><li>Google Business Profile management</li><li>Review velocity and response systems</li><li>AI citation monitoring and monthly reporting</li></ul>
							</div>
						</div>
					</li>
				</ol>
			</section>

			<section class="svc-section">
				<h2>Why chiropractors need AI SEO now</h2>
				<p>Patient lifetime value is high, the local pack still decides bookings, and AI is now the first place patients ask about treatment options.</p>
				<div class="outcomes">
					<div class="outcome"><strong>YMYL trust filters apply</strong><span>Chiropractic content is held to healthcare-grade <a href="/seo/eeat/">E-E-A-T standards</a>. Clinics with proper credentials markup and licensed author attribution are dramatically over-represented in AI answers.</span></div>
					<div class="outcome"><strong>Reviews dominate the local pack</strong><span>Recent five-star reviews are the single biggest local pack ranking factor for healthcare providers. Velocity matters as much as volume.</span></div>
					<div class="outcome"><strong>Condition pages compound</strong><span>A well-written sciatica or herniated disc page can generate appointments for years. Most clinics publish almost no condition-specific content, leaving the door open.</span></div>
				</div>
			</section>

			<section class="svc-section" id="quote">
				<h2>Get a quote for chiropractic SEO</h2>
				<p>Book a free 15-minute strategy call or send a quote request below. We respond within one business day.</p>
				<div class="contact-block">
					<div class="contact-card">
						<h3>Book a strategy call</h3>
						<p>We will review your clinic's current visibility, your target conditions, and where AI SEO can have the biggest impact on new patient bookings.</p>
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Open Calendly &rarr;</a>
					</div>
					<div class="contact-card">
						<h3 id="quote-form-heading">Request a quote by form</h3>
						<p>Tell us about your clinic, conditions you treat, and goals, and we will reply with a tailored plan.</p>
						<form class="contact-form" id="quote-form" aria-labelledby="quote-form-heading">
							<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
							<input type="hidden" name="subject" value="Chiropractor SEO quote request from aiseoshift.com" />
							<input type="hidden" name="from_name" value="AISEOShift Chiropractor SEO Quote Form" />
							<input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
							<label for="q-name">Name <span class="req" aria-hidden="true">*</span></label>
							<input id="q-name" type="text" name="name" required aria-required="true" autocomplete="name" />
							<label for="q-email">Email <span class="req" aria-hidden="true">*</span></label>
							<input id="q-email" type="email" name="email" required aria-required="true" autocomplete="email" />
							<label for="q-company">Clinic / website</label>
							<input id="q-company" type="text" name="company" autocomplete="organization" />
							<label for="q-service">Service interested in <span class="req" aria-hidden="true">*</span></label>
							<select id="q-service" name="service" required aria-required="true">
								<option value="">Select a service…</option>
								<option value="Chiropractic Visibility Audit">Chiropractic Visibility Audit</option>
								<option value="Condition and Authority Optimization">Condition and Authority Optimization</option>
								<option value="Ongoing Chiropractic AI SEO">Ongoing Chiropractic AI SEO</option>
								<option value="Not sure yet">Not sure yet</option>
							</select>
							<label for="q-message">Tell us about your clinic and goals <span class="req" aria-hidden="true">*</span></label>
							<textarea id="q-message" name="message" required aria-required="true" placeholder="Number of providers, city, conditions you specialize in, and what you are trying to achieve."></textarea>
							<button type="submit">Send quote request</button>
							<div class="form-status" id="form-status" role="status" aria-live="polite"></div>
						</form>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>Chiropractic SEO FAQs</h2>
				<ul class="faq-list">
					<li>
						<h3>How much does SEO cost for chiropractors?</h3>
