---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const CALENDLY_URL = 'https://calendly.com/shashank19/15min';
const WEB3FORMS_ACCESS_KEY = 'd165756b-c4fc-484f-9914-97af89d0421e';

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		provider: { '@type': 'Organization', name: SITE_TITLE },
		areaServed: 'Worldwide',
		serviceType: 'AI SEO for Accountants and CPA Firms',
		description:
			'AI SEO services for accountants, CPAs, bookkeepers, and tax firms that need visibility in Google, AI Overviews, ChatGPT, Perplexity, and other AI search environments.',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'How much does SEO cost for accountants and CPA firms?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Accountant and CPA SEO typically ranges from $1,500 to $7,000 per month depending on firm size, number of specialties, and competition. One-time audits start lower. Niche-specialty firms (crypto tax, R&D credits, expat tax) often achieve outsized returns because they target less competitive long-tail queries with high client value.',
				},
			},
			{
				'@type': 'Question',
				name: 'How long does SEO take for accounting firms?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Most accounting firms see measurable improvement in three to six months. Tax-season demand is highly seasonal, so the strongest results show up the season after work begins. Niche specialty pages (crypto tax, S-Corp election, R&D credits) often rank faster than generic "accountant near me" terms.',
				},
			},
			{
				'@type': 'Question',
				name: 'Do accountants need AI SEO?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. Business owners and individuals now ask ChatGPT tax and accounting questions before they ever call a firm. Google AI Overviews answer questions like "should I elect S-Corp status" directly in search. Financial content is YMYL, meaning AI systems apply the strictest scrutiny — only firms with clear credentialed authority get cited.',
				},
			},
			{
				'@type': 'Question',
				name: 'Is accounting content treated as YMYL?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. Tax, bookkeeping, financial planning, and business advisory content all fall under Google\'s Your Money or Your Life category. This means E-E-A-T signals — credentials, author attribution, accuracy, regulatory disclosures — are weighted more heavily than in non-YMYL verticals. AI answer engines inherit these filters.',
				},
			},
			{
				'@type': 'Question',
				name: 'What kind of content works best for accounting SEO?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'The best-performing accounting content combines evergreen tax explainers, industry-specific guides (real estate tax, e-commerce sales tax), and seasonal tax-deadline content — all authored or reviewed by a credentialed CPA. AI systems reward content that demonstrably comes from a licensed professional, so author bio pages with credentials matter as much as the content itself.',
				},
			},
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO for Accountants and CPA Firms | ${SITE_TITLE}`}
			description="Accounting and CPA SEO services built for AI search. Get cited by Google AI Overviews, ChatGPT, and Perplexity for tax and accounting queries."
			structuredData={structuredData}
		/>
		<style>
			.svc-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }

			.svc-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.svc-kicker { display: inline-flex; padding: 0; color: var(--ink-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
			.svc-hero h1 { font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1; letter-spacing: -0.03em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 16ch; }
			.svc-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0; }

			.svc-cta-row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-5); }
			.svc-btn { display: inline-flex; align-items: center; padding: 0.85rem 1.4rem; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
			.svc-btn-primary { background: rgb(var(--ink)); color: rgb(var(--paper)); }
			.svc-btn-primary:hover { background: var(--signal-deep); }
			.svc-btn-secondary { background: transparent; color: rgb(var(--ink)); border: 1px solid var(--line-strong); }
			.svc-btn-secondary:hover { border-color: rgb(var(--ink)); }

			.svc-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.svc-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 18ch; }
			.svc-section > p { font-size: 1.05rem; line-height: 1.65; color: rgba(var(--ink), 0.82); max-width: var(--measure); margin: 0 0 var(--space-6); }

			.svc-list { list-style: none; margin: 0; padding: 0; }
			.svc-list li { margin: 0; }
			.svc-row { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-6); align-items: baseline; padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.svc-list li:last-child .svc-row { border-bottom: 1px solid var(--line); }
			.svc-row-num { font-family: 'Iowan Old Style', Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.1rem; color: var(--ink-muted); }
			.svc-row h3 { font-size: 1.3rem; line-height: 1.2; margin: 0 0 var(--space-2); letter-spacing: -0.018em; font-weight: 600; }
			.svc-row p { font-size: 0.95rem; line-height: 1.55; color: var(--ink-muted); margin: 0 0 var(--space-3); max-width: 52ch; }
			.svc-row ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
			.svc-row ul li { font-size: 0.82rem; color: var(--ink-muted); }
			.svc-row ul li + li::before { content: '·'; margin-right: var(--space-3); color: var(--line-strong); }

			.outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; }
			.outcome { padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
			.outcome strong { display: block; font-family: 'Iowan Old Style', Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.15rem; color: rgb(var(--ink)); margin-bottom: var(--space-3); }
			.outcome span { font-size: 0.95rem; color: var(--ink-muted); line-height: 1.55; }

			.contact-block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; align-items: start; }
			@media (max-width: 860px) { .svc-hero, .outcomes, .contact-block { grid-template-columns: 1fr; } .svc-row { grid-template-columns: 1fr; gap: var(--space-3); } }

			.contact-card { padding: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); }
			.contact-card h3 { font-size: 1.25rem; margin: 0 0 var(--space-3); letter-spacing: -0.015em; font-weight: 600; }
			.contact-card > p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); margin: 0 0 var(--space-5); }
			.contact-form { display: flex; flex-direction: column; gap: var(--space-3); }
			.contact-form label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; color: rgba(var(--ink), 0.85); text-transform: uppercase; }
			.contact-form .req { color: var(--signal-deep); margin-left: 0.15rem; }
			.contact-form input:focus-visible, .contact-form select:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; border-color: rgb(var(--ink)); }
			.contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 0.7rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font-size: 0.95rem; font-family: inherit; background: rgb(var(--paper)); color: rgb(var(--ink)); box-sizing: border-box; }
			.contact-form textarea { min-height: 120px; resize: vertical; }
			.contact-form button { margin-top: var(--space-3); padding: 0.85rem 1rem; background: rgb(var(--ink)); color: rgb(var(--paper)); font-weight: 600; font-size: 0.95rem; border: none; border-radius: var(--radius-sm); cursor: pointer; }
			.contact-form button:hover { background: var(--signal-deep); }
			.form-status { margin-top: var(--space-3); font-size: 0.9rem; display: none; }
			.form-status.success { display: block; color: #047857; }
			.form-status.error { display: block; color: #b91c1c; }

			.faq-list { margin: 0; padding: 0; list-style: none; }
			.faq-list li { padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.faq-list li:last-child { border-bottom: 1px solid var(--line); }
			.faq-list h3 { font-size: 1.1rem; margin: 0 0 var(--space-2); letter-spacing: -0.012em; font-weight: 600; }
			.faq-list p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); max-width: 56ch; }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="svc-page">
			<section class="svc-hero">
				<div>
					<span class="svc-kicker">AI SEO for Accountants</span>
					<h1>AI SEO for Accountants and CPA Firms</h1>
				</div>
				<div class="svc-hero-lede">
					<p>
						Financial questions are now first asked to ChatGPT. "Should I elect S-Corp status?" "How does
						the R&D tax credit work?" "Do I need a CPA or a bookkeeper?" Google AI Overviews summarize
						these answers from a tiny list of credentialed sources. Accounting content is <a href="/seo/eeat/">YMYL</a>,
						the strictest scrutiny class in search. Firms without proper authority signals are invisible
						in the AI consideration set.
					</p>
					<div class="svc-cta-row">
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min call &rarr;</a>
						<a class="svc-btn svc-btn-secondary" href="#quote">Request a quote</a>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>The challenge: financial advice is YMYL by default</h2>
				<p>
					Accounting and tax content sits in the strictest category Google evaluates. The rules that
					already favored credentialed firms now apply twice over inside AI answer engines, where
					citation lists are short and ruthlessly filtered.
				</p>
				<div class="outcomes">
					<div class="outcome"><strong>Tax questions get answered directly</strong><span>Google AI Overviews and ChatGPT now answer the long tail of tax questions — quarterly estimates, deductions, entity selection — without sending clicks. Only the most authoritative firms get cited as the source.</span></div>
					<div class="outcome"><strong>Seasonal demand, evergreen prep</strong><span>The bulk of tax-related searches happen in March and April, but AI systems form their citation lists year-round. Firms that publish through the off-season win the season.</span></div>
					<div class="outcome"><strong>Credentials matter more than ever</strong><span>AI systems cross-reference licensing, firm affiliation, and publication history. Firms without CPA-attributed content, author bios, and credential markup are filtered out of YMYL answer sets.</span></div>
				</div>
			</section>

			<section class="svc-section">
				<h2>What we do for accounting firms</h2>
				<p>Three services built around YMYL compliance, niche specialty authority, and seasonal demand.</p>
				<ol class="svc-list">
					<li>
						<div class="svc-row">
							<span class="svc-row-num">01</span>
							<div>
								<h3>Accounting Firm Visibility Audit</h3>
								<p>A complete review of how your firm appears across Google Search, AI Overviews, ChatGPT, and Perplexity for your specialties, industries, and city. You get a prioritized roadmap built around <a href="/seo/eeat/">YMYL compliance</a> and the specialty queries that produce the highest-value clients.</p>
								<ul><li>AI citation audit by specialty and industry</li><li>E-E-A-T and YMYL compliance review</li><li>CPA credential and author markup audit</li><li>Competitor citation analysis</li><li><a href="/seo/schema-markup/">Schema</a> and structured data review</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">02</span>
							<div>
								<h3>CPA Authority Building</h3>
								<p>Implementation work that establishes your individual CPAs and the firm as recognized authorities in your specialties. The author bios, credentials markup, and topical depth that AI systems need to trust and cite your content.</p>
								<ul><li>Individual CPA author pages with credentials</li><li>AccountingService and Person <a href="/seo/schema-markup/">schema</a></li><li>Industry- and specialty-specific landing pages</li><li>Tax-deadline and seasonal landing pages</li><li>Topical authority maps by service area</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">03</span>
							<div>
								<h3>Ongoing Accounting AI SEO</h3>
								<p>Monthly support combining evergreen tax explainers, seasonal content, technical SEO, and AI citation monitoring so your firm stays the cited source as tax law evolves and competitors publish.</p>
								<ul><li>Monthly tax and accounting content</li><li>Seasonal tax-deadline content</li><li>Technical SEO and schema maintenance</li><li>AI citation monitoring and monthly reporting</li></ul>
							</div>
						</div>
					</li>
				</ol>
			</section>

			<section class="svc-section">
				<h2>Why accounting firms need AI SEO now</h2>
				<p>The CPC for accounting and tax keywords is high, the seasonal demand is sharp, and AI is becoming the default first place clients ask financial questions.</p>
				<div class="outcomes">
					<div class="outcome"><strong>Highest YMYL scrutiny</strong><span>Financial content is held to the strictest evaluation standards by both Google and AI systems. Firms that meet the bar are dramatically over-represented in answer sets.</span></div>
					<div class="outcome"><strong>Specialty depth wins</strong><span>"R&D tax credit" or "expat tax CPA" queries have orders of magnitude better economics than "accountant near me." AI systems reward firms that go deep on a few specialties.</span></div>
					<div class="outcome"><strong>Authority compounds</strong><span>Every credentialed CPA-bylined piece of content increases your firm's standing in AI citation lists. The work compounds, the moat widens.</span></div>
				</div>
			</section>

			<section class="svc-section" id="quote">
				<h2>Get a quote for accounting SEO</h2>
				<p>Book a free 15-minute strategy call or send a quote request below. We respond within one business day.</p>
				<div class="contact-block">
					<div class="contact-card">
						<h3>Book a strategy call</h3>
						<p>We will review your firm's current AI search visibility, identify the specialties with the biggest gaps, and outline next steps.</p>
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Open Calendly &rarr;</a>
					</div>
					<div class="contact-card">
						<h3 id="quote-form-heading">Request a quote by form</h3>
						<p>Tell us about your firm, specialties, and goals. We will reply with a tailored proposal.</p>
						<form class="contact-form" id="quote-form" aria-labelledby="quote-form-heading">
							<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
							<input type="hidden" name="subject" value="Accounting SEO quote request from aiseoshift.com" />
							<input type="hidden" name="from_name" value="AISEOShift Accounting SEO Quote Form" />
							<input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
							<label for="q-name">Name <span class="req" aria-hidden="true">*</span></label>
							<input id="q-name" type="text" name="name" required aria-required="true" autocomplete="name" />
							<label for="q-email">Email <span class="req" aria-hidden="true">*</span></label>
							<input id="q-email" type="email" name="email" required aria-required="true" autocomplete="email" />
							<label for="q-company">Firm name / website</label>
							<input id="q-company" type="text" name="company" autocomplete="organization" />
							<label for="q-service">Service interested in <span class="req" aria-hidden="true">*</span></label>
							<select id="q-service" name="service" required aria-required="true">
								<option value="">Select a service…</option>
								<option value="Accounting Firm Visibility Audit">Accounting Firm Visibility Audit</option>
								<option value="CPA Authority Building">CPA Authority Building</option>
								<option value="Ongoing Accounting AI SEO">Ongoing Accounting AI SEO</option>
								<option value="Not sure yet">Not sure yet</option>
							</select>
							<label for="q-message">Tell us about your firm and goals <span class="req" aria-hidden="true">*</span></label>
							<textarea id="q-message" name="message" required aria-required="true" placeholder="Specialties, industries served, firm size, and what you are trying to achieve."></textarea>
							<button type="submit">Send quote request</button>
							<div class="form-status" id="form-status" role="status" aria-live="polite"></div>
						</form>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>Accounting SEO FAQs</h2>
				<ul class="faq-list">
					<li>
						<h3>How much does SEO cost for accountants and CPA firms?</h3>
						<p>Accountant and CPA SEO typically ranges from $1,500 to $7,000 per month depending on firm size, number of specialties, and competition. One-time audits start lower. Niche-specialty firms (crypto tax, R&D credits, expat tax) often achieve outsized returns because they target less competitive long-tail queries with high client value.</p>
					</li>
					<li>
						<h3>How long does SEO take for accounting firms?</h3>
						<p>Most accounting firms see measurable improvement in three to six months. Tax-season demand is highly seasonal, so the strongest results show up the season after work begins. Niche specialty pages often rank faster than generic "accountant near me" terms.</p>
					</li>
					<li>
						<h3>Do accountants need AI SEO?</h3>
						<p>Yes. Business owners and individuals now ask ChatGPT tax and accounting questions before they ever call a firm. Google AI Overviews answer questions like "should I elect S-Corp status" directly in search. Financial content is <a href="/seo/eeat/">YMYL</a>, meaning AI systems apply the strictest scrutiny — only firms with clear credentialed authority get cited.</p>
					</li>
					<li>
						<h3>Is accounting content treated as YMYL?</h3>
						<p>Yes. Tax, bookkeeping, financial planning, and business advisory content all fall under Google's Your Money or Your Life category. This means <a href="/seo/eeat/">E-E-A-T signals</a> — credentials, author attribution, accuracy, regulatory disclosures — are weighted more heavily than in non-YMYL verticals. AI answer engines inherit these filters.</p>
					</li>
					<li>
						<h3>What kind of content works best for accounting SEO?</h3>
						<p>The best-performing accounting content combines evergreen tax explainers, industry-specific guides (real estate tax, e-commerce sales tax), and seasonal tax-deadline content — all authored or reviewed by a credentialed CPA. AI systems reward content that demonstrably comes from a licensed professional, so author bio pages with credentials matter as much as the content itself.</p>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				const form = document.getElementById('quote-form');
				const status = document.getElementById('form-status');
				if (!form || !status) return;
				form.addEventListener('submit', async function (e) {
					e.preventDefault();
					status.className = 'form-status';
					status.textContent = '';
					const accessKey = form.querySelector('input[name="access_key"]').value;
					if (!accessKey || accessKey === 'REPLACE_WITH_WEB3FORMS_KEY') {
						status.className = 'form-status error';
						status.textContent = 'Form not configured yet. Email hello@aiseoshift.com directly.';
						return;
					}
					const formData = new FormData(form);
					try {
						const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { Accept: 'application/json' }, body: formData });
						const data = await res.json();
						if (data.success) {
							status.className = 'form-status success';
							status.textContent = 'Thanks! We received your request and will reply within one business day.';
							form.reset();
						} else {
							status.className = 'form-status error';
							status.textContent = 'Something went wrong. Please email hello@aiseoshift.com directly.';
						}
					} catch {
						status.className = 'form-status error';
						status.textContent = 'Network error. Please try again or email hello@aiseoshift.com directly.';
					}
				});
			})();
		</script>
	</body>
</html>
