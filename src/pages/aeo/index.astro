---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../../consts';

const canonical = new URL('/aeo/', SITE_URL).toString();
const pubDate = new Date('2026-05-26');

const definedTermSchema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTerm',
	'@id': `${canonical}#defined-aeo`,
	name: 'Answer Engine Optimization (AEO)',
	alternateName: 'AEO',
	description:
		'Answer Engine Optimization (AEO) is the practice of structuring web content so AI answer engines like ChatGPT, Claude, Perplexity, and Google AI Overviews can extract, trust, and cite it inside their generated answers. AEO sits alongside classical SEO (for ranking) and GEO (for generative engines).',
	inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'AI Search Glossary', url: `${SITE_URL}/aeo/` },
};

const faqs = [
	{
		q: 'What is Answer Engine Optimization (AEO)?',
		a: 'Answer Engine Optimization (AEO) is the practice of structuring web content so that AI answer engines like ChatGPT, Claude, and Perplexity can extract, trust, and cite it inside their generated answers. Unlike SEO, which optimizes for ranking in a list of links, AEO optimizes for being the source an AI cites when it generates an answer.',
	},
	{
		q: "What's the difference between AEO and SEO?",
		a: 'SEO is about ranking in Google’s organic blue-link results. AEO is about being cited inside AI-generated answers from ChatGPT, Claude, Perplexity, and similar engines. The two disciplines share foundations like structured content, schema, and E-E-A-T, but they differ in format (lists vs. extracted answers), measurement (positions vs. citations), and ranking signals.',
	},
	{
		q: 'How is AEO different from GEO?',
		a: 'AEO focuses on retrieval-style answer engines (ChatGPT Search, Claude, Perplexity) that explicitly cite their sources. GEO (Generative Engine Optimization) focuses on generative search experiences like Google AI Overviews and Gemini that synthesize answers, often with less prominent attribution. AEO and GEO overlap heavily but optimize for different surfaces.',
	},
	{
		q: 'What schema markup matters most for AEO?',
		a: 'FAQPage, HowTo, Article (with @id-linked Organization and Person), DefinedTerm, BreadcrumbList, and Speakable. AI engines disproportionately cite pages with structured Q&A blocks, clear definitions, and machine-readable author/publisher attribution.',
	},
	{
		q: 'How do I know if AEO is working?',
		a: 'Measure citation frequency across AI engines (manual sampling, or tools like Profound, Otterly, and Peec), brand share-of-voice in AI answers for target queries, and zero-click value (impressions and brand recall from answers users see but do not click). Classical ranking position is a lagging indicator at best.',
	},
	{
		q: 'Which AI engines should I optimize for first?',
		a: 'Start with the three highest-volume answer engines: Google AI Mode + AI Overviews (largest reach), ChatGPT Search (largest direct consumer base), and Perplexity (most active citation behavior). Claude and Gemini share much of the same underlying retrieval, so optimizing for the first three covers most of the territory.',
	},
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': `${canonical}#article`,
	headline: 'AEO: Answer Engine Optimization Explained',
	description:
		'The complete definition of Answer Engine Optimization (AEO): what it is, how it differs from SEO and GEO, which schema matters, and how to get cited by ChatGPT, Claude, and Perplexity.',
	url: canonical,
	mainEntityOfPage: canonical,
	datePublished: pubDate.toISOString(),
	dateModified: pubDate.toISOString(),
	inLanguage: 'en-US',
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
	image: { '@id': `${SITE_URL}/#logo` },
	about: { '@id': `${canonical}#defined-aeo` },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${canonical}#faq`,
	isPartOf: { '@id': `${canonical}#article` },
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'AEO', item: canonical },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AEO: Answer Engine Optimization Explained (2026) | ${SITE_TITLE}`}
			description="AEO (Answer Engine Optimization) is the discipline of getting your content cited by ChatGPT, Claude, Perplexity, and other AI answer engines. Full guide: definition, vs. SEO, vs. GEO, schema, and the 2026 playbook."
			canonical={canonical}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={pubDate.toISOString()}
			structuredData={[articleSchema, definedTermSchema, faqSchema, breadcrumbSchema]}
		/>
		<style>
			.aeo-page {
				width: min(1080px, calc(100% - 2rem));
				margin: 0 auto;
				padding: var(--space-7) 0 var(--space-9);
			}

			.aeo-hero {
				padding: var(--space-7) 0 var(--space-8);
				border-bottom: 1px solid var(--line);
				display: grid;
				grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
				gap: var(--space-7);
				align-items: end;
			}

			.aeo-hero .kicker {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--ink-muted);
				margin: 0;
			}

			.aeo-hero h1 {
				font-size: clamp(2.4rem, 5vw, 4.4rem);
				line-height: 0.98;
				letter-spacing: -0.032em;
				font-weight: 600;
				margin: var(--space-4) 0 0;
				max-width: 14ch;
			}

			.aeo-hero h1 em {
				font-style: italic;
				font-weight: 400;
				color: var(--signal-deep);
			}

			.aeo-hero-lede p {
				font-size: 1.1rem;
				line-height: 1.6;
				color: rgba(var(--ink), 0.78);
				max-width: var(--measure);
				margin: 0 0 var(--space-4);
			}

			.aeo-hero-svg {
				margin: var(--space-7) 0 0;
				border: 1px solid var(--line);
				border-radius: var(--radius-md);
				background: rgb(var(--paper-strong));
				padding: 0;
				overflow: hidden;
			}

			.aeo-hero-svg svg { display: block; width: 100%; height: auto; }

			.aeo-section {
				padding: var(--space-8) 0;
				border-bottom: 1px solid var(--line);
			}

			.aeo-section h2 {
				font-size: clamp(1.85rem, 3vw, 2.6rem);
				line-height: 1.15;
				letter-spacing: -0.024em;
				font-weight: 600;
				margin: 0 0 var(--space-5);
				max-width: 22ch;
			}

			.aeo-section p {
				font-size: 1.05rem;
				line-height: 1.7;
				color: rgba(var(--ink), 0.85);
				margin: 0 0 var(--space-4);
				max-width: var(--measure);
			}

			.aeo-callout {
				margin: var(--space-6) 0;
				padding: var(--space-5) var(--space-6);
				background: rgb(var(--paper-strong));
				border: 1px solid var(--line);
				border-left: 3px solid var(--signal);
				border-radius: var(--radius-md);
			}

			.aeo-callout p {
				margin: 0;
				font-size: 1rem;
				line-height: 1.65;
			}

			.aeo-callout strong {
				font-weight: 700;
			}

			.cmp-mini {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: var(--space-6);
				margin: var(--space-6) 0 0;
			}

			.cmp-mini > div {
				padding-top: var(--space-4);
				border-top: 1px solid var(--line-strong);
			}

			.cmp-mini dt {
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				margin: 0 0 var(--space-2);
			}

			.cmp-mini dd {
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.55;
				color: var(--ink-muted);
			}

			.chapters-strip {
				margin: var(--space-5) 0 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 0.6rem;
				padding: 0;
				list-style: none;
			}

			.chapters-strip li { margin: 0; }

			.chapters-strip a {
				display: inline-flex;
				padding: 0.4rem 0.85rem;
				border-radius: 999px;
				border: 1px solid var(--line-strong);
				background: rgb(var(--paper));
				color: rgb(var(--ink));
				text-decoration: none;
				font-size: 0.82rem;
				font-weight: 600;
				line-height: 1;
			}

			.chapters-strip a:hover {
				color: var(--signal-deep);
				border-color: var(--signal);
			}

			.faq-shell {
				border-top: 1px solid var(--line-strong);
				margin-top: var(--space-4);
			}

			.faq-item {
				border-bottom: 1px solid var(--line);
				padding: var(--space-5) 0;
			}

			.faq-item summary {
				cursor: pointer;
				list-style: none;
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				font-size: 1.15rem;
				font-weight: 700;
				line-height: 1.3;
				letter-spacing: -0.012em;
				color: rgb(var(--ink));
			}

			.faq-item summary::-webkit-details-marker { display: none; }

			.faq-item summary::after {
				content: '+';
				font-size: 1.4rem;
				color: var(--signal-deep);
			}

			.faq-item[open] summary::after { content: '−'; }

			.faq-answer {
				margin: var(--space-3) 0 0;
				font-size: 1rem;
				line-height: 1.7;
				color: rgba(var(--ink), 0.85);
				max-width: 60ch;
			}

			.aeo-author {
				display: inline-flex;
				align-items: center;
				gap: 0.75rem;
				margin: var(--space-4) 0 0;
				padding: 0;
				text-decoration: none;
				color: rgb(var(--ink));
			}

			.aeo-author img {
				width: 40px;
				height: 40px;
				border-radius: 50%;
				border: 1px solid var(--line-strong);
			}

			.aeo-author-text {
				display: inline-flex;
				flex-direction: column;
				line-height: 1.25;
				font-size: 0.85rem;
			}

			.aeo-author-name { font-weight: 700; }
			.aeo-author-role { color: var(--ink-muted); font-size: 0.75rem; }

			@media (max-width: 860px) {
				.aeo-hero,
				.cmp-mini {
					grid-template-columns: 1fr;
					gap: var(--space-5);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="aeo-page">
			<section class="aeo-hero">
				<div>
					<p class="kicker">AISEOShift · Entity Hub</p>
					<h1>AEO. Answer Engine Optimization <em>explained.</em></h1>
				</div>
				<div class="aeo-hero-lede">
					<p>
						AEO is the discipline of structuring web content so that AI answer engines &mdash;
						ChatGPT, Claude, Perplexity, Google AI Overviews, Gemini &mdash; can extract,
						trust, and cite it inside their generated answers. SEO ranks. AEO gets cited.
					</p>
					<a class="aeo-author" href={AUTHOR_PROFILE_URL} rel="author">
						<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="40" height="40" />
						<span class="aeo-author-text">
							<span class="aeo-author-name">By {AUTHOR_NAME}</span>
							<span class="aeo-author-role">{AUTHOR_ROLE}</span>
						</span>
					</a>
				</div>
			</section>

			<div class="aeo-hero-svg" aria-hidden="true">
				<svg viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
					<rect width="800" height="220" fill="rgb(246,245,240)" />
					<g font-family="system-ui, sans-serif" font-size="10" letter-spacing="2.4" fill="rgb(14,17,22)" fill-opacity="0.6">
						<text x="60" y="36">USER QUESTION</text>
						<text x="370" y="36">ANSWER ENGINE</text>
						<text x="640" y="36">CITED SOURCE</text>
					</g>
					<g transform="translate(40 60)">
						<rect width="220" height="80" rx="3" fill="none" stroke="rgb(14,17,22)" stroke-opacity="0.45" />
						<text x="20" y="34" font-family="Iowan Old Style, Georgia, serif" font-style="italic" font-size="13" fill="rgb(14,17,22)">"what is the difference</text>
						<text x="20" y="54" font-family="Iowan Old Style, Georgia, serif" font-style="italic" font-size="13" fill="rgb(14,17,22)">between AEO and GEO?"</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 270 100 C 310 100, 320 100, 350 100" />
						<polyline points="340,94 350,100 340,106" />
					</g>
					<g transform="translate(360 60)">
						<rect width="180" height="80" rx="3" fill="rgb(14,17,22)" />
						<text x="90" y="36" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="rgb(250,250,247)">CHATGPT</text>
						<text x="90" y="56" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="rgb(250,250,247)">CLAUDE · PERPLEXITY</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 550 100 C 590 100, 600 100, 630 100" />
						<polyline points="620,94 630,100 620,106" />
					</g>
					<g transform="translate(640 60)">
						<rect width="120" height="80" rx="3" fill="rgb(184,85,46)" />
						<text x="60" y="36" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="rgb(250,250,247)">AISEOSHIFT</text>
						<text x="60" y="56" text-anchor="middle" font-family="Iowan Old Style, Georgia, serif" font-style="italic" font-size="11" fill="rgb(250,250,247)">.com/aeo/</text>
					</g>
					<text x="400" y="190" text-anchor="middle" font-family="Iowan Old Style, Georgia, serif" font-style="italic" font-size="13" fill="rgb(14,17,22)" fill-opacity="0.7">From user question to cited answer. The AEO loop.</text>
				</svg>
			</div>

			<section class="aeo-section">
				<h2>Definition: what AEO actually means</h2>
				<p>
					<strong>Answer Engine Optimization (AEO)</strong> is the practice of structuring web content so that AI answer engines &mdash; ChatGPT, Claude, Perplexity, Google AI Mode, Gemini &mdash; can extract, trust, and cite it inside their generated answers. The unit of optimization is no longer a blue link competing for a click. It is a paragraph, a definition, a stat, or a list that an AI can lift out of your page and present as the answer to a user&rsquo;s question.
				</p>
				<p>
					The shift is structural. Classical SEO optimizes for a ranked list. AEO optimizes for being the source an AI selects. The two share fundamentals (crawlable HTML, schema, E-E-A-T) but diverge sharply in content format, measurement, and the engines you have to design for.
				</p>
				<div class="aeo-callout">
					<p><strong>Working definition.</strong> If SEO is &ldquo;rank in Google,&rdquo; AEO is &ldquo;be the source ChatGPT cites.&rdquo; They are complementary disciplines, not competitors.</p>
				</div>
			</section>

			<section class="aeo-section">
				<h2>AEO vs SEO vs GEO at a glance</h2>
				<p>The three modern search disciplines overlap but are not interchangeable. Most brands need all three.</p>
				<dl class="cmp-mini">
					<div>
						<dt>SEO</dt>
						<dd>Rank in Google&rsquo;s organic blue-link results. Signals: backlinks, on-page relevance, E-E-A-T, Core Web Vitals.</dd>
					</div>
					<div>
						<dt>AEO</dt>
						<dd>Be cited inside ChatGPT, Claude, Perplexity answers. Signals: direct-answer formatting, schema, named entities, brand mentions, attributed stats.</dd>
					</div>
					<div>
						<dt>GEO</dt>
						<dd>Appear in Google AI Overviews, Gemini, Search Generative Experience. Signals: existing rank plus AI-friendly structure plus topical cluster depth.</dd>
					</div>
				</dl>
				<p style="margin-top: var(--space-6)">For the full comparison table with surfaces, crawlers, content format, and measurement metrics, see our chapter on <a href="/seo/ai-search-optimization/">AEO, GEO, and AI Overviews</a>.</p>
			</section>

			<section class="aeo-section">
				<h2>How AI answer engines pick the source they cite</h2>
				<p>Across ChatGPT Search, Claude, and Perplexity, the citation-selection mechanic looks roughly the same:</p>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Retrieve.</strong> Run multiple parallel searches against the engine&rsquo;s underlying index (Bing, partner web crawls, Google, or proprietary).</li>
					<li><strong>Rank candidate passages.</strong> Score retrieved passages on semantic match to the query, source authority, and structured-content signals.</li>
					<li><strong>Filter for trust.</strong> Down-weight passages with weak attribution, missing author, or low E-E-A-T signals.</li>
					<li><strong>Synthesize.</strong> Generate the answer from the top-ranked passages and emit citations for the sources it used.</li>
				</ol>
				<p style="margin-top: var(--space-5)">Every step is an AEO surface. Step 1 cares about whether your page is crawlable and recently indexed. Step 2 cares about whether you wrote a direct-answer paragraph the engine can lift. Step 3 cares about your Person/Organization schema, your sameAs links, and your byline. Step 4 cares about whether your sentence is concise enough to be quoted verbatim.</p>
			</section>

			<section class="aeo-section">
				<h2>The 2026 AEO playbook</h2>
				<p>Five practices doing the most work right now:</p>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Direct-answer openers.</strong> The first paragraph under every H2 should be a 1-3 sentence answer to the question implied by the H2. This is the unit AI engines lift.</li>
					<li><strong>FAQ + HowTo + DefinedTerm schema.</strong> Mark up everything that can plausibly carry one. Engines disproportionately cite structured content. See <a href="/seo/schema-markup/">Schema markup and structured data</a>.</li>
					<li><strong>Named-author bylines with Person schema.</strong> AI engines weight named-human authorship heavily. &ldquo;Editorial Desk&rdquo; bylines are nearly invisible to the trust layer. See <a href="/seo/eeat/">E-E-A-T</a>.</li>
					<li><strong>Attributed statistics.</strong> Cite primary sources inline. AI engines preferentially cite pages that themselves cite, because that is the citation pattern they themselves use.</li>
					<li><strong>llms.txt + bot allow rules.</strong> Make your site discoverable to assistant crawlers. Block training-only bots if you choose, but explicitly allow OAI-SearchBot, PerplexityBot, Claude-SearchBot. See <a href="/llms.txt">our llms.txt</a> for an example.</li>
				</ol>
			</section>

			<section class="aeo-section">
				<h2>Where AEO fits into the broader guide</h2>
				<p>AEO is one chapter of the full AI SEO Shift discipline. The supporting chapters that go deepest on the underlying mechanics:</p>
				<ul class="chapters-strip">
					<li><a href="/seo/ai-search-optimization/">AEO, GEO &amp; AI Overviews</a></li>
					<li><a href="/seo/ai-citation-building/">AI Citation Building</a></li>
					<li><a href="/seo/schema-markup/">Schema Markup</a></li>
					<li><a href="/seo/eeat/">E-E-A-T</a></li>
					<li><a href="/seo/content-strategy/">Content Strategy</a></li>
					<li><a href="/seo/measuring-seo/">Measuring SEO &amp; AI Visibility</a></li>
					<li><a href="/geo/">GEO entity hub</a></li>
				</ul>
			</section>

			<section class="aeo-section" id="faq">
				<h2>Frequently asked questions</h2>
				<div class="faq-shell">
					{faqs.map((f, i) => (
						<details class="faq-item" open={i === 0}>
							<summary>{f.q}</summary>
							<p class="faq-answer">{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
