---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../../consts';

const canonical = new URL('/ai-overviews-seo/', SITE_URL).toString();
const pubDate = new Date('2026-05-30');

const definedTermSchema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTerm',
	'@id': `${canonical}#defined`,
	name: 'Google AI Overviews SEO',
	description:
		"Google AI Overviews SEO is the practice of optimizing content so it appears as a cited source inside Google AI Overviews — the AI-generated answer box that appears above traditional search results. AI Overviews appear on 48% of all Google queries as of May 2026 and are seen by 2.5 billion monthly active users.",
	inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'AI SEO Glossary', url: `${SITE_URL}/glossary/` },
};

const faqs = [
	{
		q: 'What are Google AI Overviews?',
		a: "Google AI Overviews are AI-generated answer boxes that appear at the very top of Google search results, above all traditional blue-link rankings. They synthesize information from Google's indexed web pages, cite 3 to 8 sources with clickable links, and appear on 48% of all Google queries as of May 2026. They are powered by Gemini and seen by 2.5 billion monthly active users.",
	},
	{
		q: 'How do I get my content cited in AI Overviews?',
		a: 'The primary requirement is ranking in the top 10 to 20 organically on Google for the target query. From there, the key signals are: direct-answer paragraphs immediately under H2 headings, strong structured data (FAQPage, HowTo, Article, Person, Organization schema), named human authors with E-E-A-T credentials, and topical authority demonstrated through a cluster of related content on your site.',
	},
	{
		q: 'Do AI Overviews reduce my organic traffic?',
		a: "Yes, in aggregate. AI Overviews reduce click-through rates because users who get sufficient answers from the overview don't click through to the source pages. However, pages that are explicitly cited as a source within the AI Overview still earn clicks. Being the cited source is more valuable than ranking first without a citation.",
	},
	{
		q: 'Can I opt out of appearing in AI Overviews?',
		a: "There is no direct AI Overviews opt-out separate from Google Search. You can use nosnippet meta tags or data-nosnippet HTML attributes to prevent Google from using specific text passages in Overviews. Blocking Googlebot entirely would remove you from all Google surfaces including AI Overviews, but this is not recommended for most sites.",
	},
	{
		q: 'Does YouTube content appear in AI Overviews?',
		a: 'Yes, at a high rate. BrightEdge research found YouTube among the top three citation sources in AI Overviews across multiple query categories. Video content on YouTube that clearly answers specific questions, with an accurate transcript and structured metadata, has strong AI Overview citation potential alongside written content.',
	},
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': `${canonical}#article`,
	headline: 'Google AI Overviews SEO: How to Get Cited at the Top of Google',
	description:
		"Complete guide to Google AI Overviews SEO in 2026: how AI Overviews select citations from Google's index, the 48% query coverage figure, structured data requirements, and the full optimization playbook.",
	url: canonical,
	mainEntityOfPage: canonical,
	datePublished: pubDate.toISOString(),
	dateModified: pubDate.toISOString(),
	inLanguage: 'en-US',
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
	about: { '@id': `${canonical}#defined` },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${canonical}#faq`,
	isPartOf: { '@id': `${canonical}#article` },
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'AI Overviews SEO', item: canonical },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Google AI Overviews SEO: Get Cited Above Every Blue Link (2026) | ${SITE_TITLE}`}
			description="AI Overviews appear on 48% of Google queries and are seen by 2.5 billion users. Full guide: how AI Overviews select citations, FAQPage schema, YouTube signals, and the 2026 playbook."
			canonical={canonical}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={pubDate.toISOString()}
			structuredData={[articleSchema, definedTermSchema, faqSchema, breadcrumbSchema]}
		/>
		<style>
			.engine-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }
			.engine-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.engine-hero .kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); margin: 0; }
			.engine-hero h1 { font-size: clamp(2.4rem, 5vw, 4.4rem); line-height: 0.98; letter-spacing: -0.032em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 14ch; }
			.engine-hero h1 em { font-style: italic; font-weight: 400; color: var(--signal-deep); }
			.engine-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0 0 var(--space-4); }
			.engine-svg { margin: var(--space-7) 0 0; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); overflow: hidden; }
			.engine-svg svg { display: block; width: 100%; height: auto; }
			.engine-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.engine-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 22ch; }
			.engine-section p { font-size: 1.05rem; line-height: 1.7; color: rgba(var(--ink), 0.85); margin: 0 0 var(--space-4); max-width: var(--measure); }
			.engine-callout { margin: var(--space-6) 0; padding: var(--space-5) var(--space-6); background: rgb(var(--paper-strong)); border: 1px solid var(--line); border-left: 3px solid var(--signal); border-radius: var(--radius-md); }
			.engine-callout p { margin: 0; font-size: 1rem; line-height: 1.65; }
			.engine-callout strong { font-weight: 700; }
			.chapters-strip { margin: var(--space-5) 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; padding: 0; list-style: none; }
			.chapters-strip li { margin: 0; }
			.chapters-strip a { display: inline-flex; padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid var(--line-strong); background: rgb(var(--paper)); color: rgb(var(--ink)); text-decoration: none; font-size: 0.82rem; font-weight: 600; line-height: 1; }
			.chapters-strip a:hover { color: var(--signal-deep); border-color: var(--signal); }
			.faq-shell { border-top: 1px solid var(--line-strong); margin-top: var(--space-4); }
			.faq-item { border-bottom: 1px solid var(--line); padding: var(--space-5) 0; }
			.faq-item summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; font-size: 1.15rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.012em; color: rgb(var(--ink)); }
			.faq-item summary::-webkit-details-marker { display: none; }
			.faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--signal-deep); }
			.faq-item[open] summary::after { content: '−'; }
			.faq-answer { margin: var(--space-3) 0 0; font-size: 1rem; line-height: 1.7; color: rgba(var(--ink), 0.85); max-width: 60ch; }
			.engine-author { display: inline-flex; align-items: center; gap: 0.75rem; margin: var(--space-4) 0 0; text-decoration: none; color: rgb(var(--ink)); }
			.engine-author img { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); }
			.engine-author-text { display: inline-flex; flex-direction: column; line-height: 1.25; font-size: 0.85rem; }
			.engine-author-name { font-weight: 700; }
			.engine-author-role { color: var(--ink-muted); font-size: 0.75rem; }
			@media (max-width: 860px) { .engine-hero { grid-template-columns: 1fr; gap: var(--space-5); } }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="engine-page">
			<section class="engine-hero">
				<div>
					<p class="kicker">AISEOShift &middot; Engine Hub</p>
					<h1>AI Overviews SEO. Cited <em>above everything.</em></h1>
				</div>
				<div class="engine-hero-lede">
					<p>
						Google AI Overviews appear above every blue link on 48% of all Google queries.
						2.5 billion monthly active users see them. AI Overviews SEO is the discipline
						of being one of the 3 to 8 sources cited inside the answer box at the very top of Google.
					</p>
					<a class="engine-author" href={AUTHOR_PROFILE_URL} rel="author">
						<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="40" height="40" />
						<span class="engine-author-text">
							<span class="engine-author-name">By {AUTHOR_NAME}</span>
							<span class="engine-author-role">{AUTHOR_ROLE}</span>
						</span>
					</a>
				</div>
			</section>

			<div class="engine-svg" aria-hidden="true">
				<svg viewBox="0 0 800 240" xmlns="http://www.w3.org/2000/svg">
					<rect width="800" height="240" fill="rgb(246,245,240)" />
					<g font-family="system-ui,sans-serif" font-size="10" letter-spacing="2.4" fill="rgb(14,17,22)" fill-opacity="0.6">
						<text x="100" y="36" text-anchor="middle">GOOGLE RESULTS PAGE</text>
						<text x="560" y="36" text-anchor="middle">WHAT USER SEES</text>
					</g>
					<rect x="20" y="56" width="340" height="150" rx="6" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.2"/>
					<rect x="34" y="68" width="312" height="48" rx="4" fill="rgb(184,85,46)" fill-opacity="0.12" stroke="rgb(184,85,46)" stroke-width="1"/>
					<text x="190" y="88" font-family="Georgia,serif" font-size="11" font-weight="700" fill="rgb(184,85,46)" text-anchor="middle">AI Overview (cited sources inside)</text>
					<text x="190" y="106" font-family="Georgia,serif" font-size="10" fill="rgb(14,17,22)" fill-opacity="0.6" text-anchor="middle">Appears above all ranked results</text>
					<rect x="34" y="124" width="312" height="12" rx="2" fill="rgb(14,17,22)" fill-opacity="0.1"/>
					<rect x="34" y="142" width="312" height="12" rx="2" fill="rgb(14,17,22)" fill-opacity="0.08"/>
					<rect x="34" y="160" width="248" height="12" rx="2" fill="rgb(14,17,22)" fill-opacity="0.06"/>
					<text x="190" y="197" font-family="Georgia,serif" font-size="10" fill="rgb(14,17,22)" fill-opacity="0.4" text-anchor="middle">Traditional ranked results (below)</text>
					<line x1="360" y1="131" x2="428" y2="131" stroke="rgb(184,85,46)" stroke-width="2"/>
					<polygon points="422,125 434,131 422,137" fill="rgb(184,85,46)"/>
					<rect x="434" y="56" width="346" height="150" rx="6" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.2"/>
					<rect x="448" y="70" width="318" height="68" rx="4" fill="rgb(14,17,22)"/>
					<text x="607" y="97" font-family="Georgia,serif" font-size="11" font-weight="700" fill="rgb(250,250,247)" text-anchor="middle">AI Overview answer</text>
					<text x="607" y="115" font-family="Georgia,serif" font-size="10" fill="rgb(184,85,46)" text-anchor="middle">[source 1] [source 2] [source 3]</text>
					<text x="607" y="130" font-family="Georgia,serif" font-size="9" fill="rgb(250,250,247)" fill-opacity="0.6" text-anchor="middle">Cited sources earn clicks</text>
					<rect x="448" y="146" width="318" height="10" rx="2" fill="rgb(14,17,22)" fill-opacity="0.1"/>
					<rect x="448" y="162" width="318" height="10" rx="2" fill="rgb(14,17,22)" fill-opacity="0.07"/>
					<rect x="448" y="178" width="250" height="10" rx="2" fill="rgb(14,17,22)" fill-opacity="0.05"/>
					<text x="607" y="210" font-family="Georgia,serif" font-style="italic" font-size="11" fill="rgb(14,17,22)" fill-opacity="0.45" text-anchor="middle">48% of queries &bull; 2.5B users &bull; 3-8 citations per answer</text>
				</svg>
			</div>

			<section class="engine-section">
				<h2>Definition: what AI Overviews SEO means</h2>
				<p>
					<strong>Google AI Overviews SEO</strong> is the practice of optimizing content to appear as a cited source inside Google AI Overviews. An AI Overview is an AI-generated answer box that appears above all traditional blue-link results on the Google search results page. It cites 3 to 8 sources from Google&rsquo;s index with clickable links inside the answer text.
				</p>
				<p>
					AI Overviews appear on 48% of all Google queries as of May 2026, up from 34.5% in December 2025 — a 58% increase in five months. They are visible to 2.5 billion monthly active users. For informational queries, an AI Overview citation places your content in the most prominent position on the page, above every organic result, every ad, and every other feature.
				</p>
				<div class="engine-callout">
					<p><strong>The position zero evolution.</strong> Featured snippets were once called &ldquo;position zero.&rdquo; AI Overviews have replaced them as the definitive above-all-results placement. A cited AI Overview source earns more visible real estate than any other position on the page.</p>
				</div>
			</section>

			<section class="engine-section">
				<h2>How AI Overviews select their cited sources</h2>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Classical rank as the entry gate.</strong> AI Overviews select from pages already ranking in the top 10 to 20 organically. A page with no classical ranking has near-zero chance of being cited.</li>
					<li><strong>Direct-answer passage detection.</strong> The system scans candidate pages for passages that directly answer the query. The first 1-3 sentences after a relevant H2 heading are the most commonly lifted passages. Meandering openers are a citation liability.</li>
					<li><strong>Structured data signals.</strong> FAQPage, HowTo, Article, Person, and Organization schema all correlate with higher AI Overview citation rates. They make content machine-readable in ways that align with how the synthesis layer processes information.</li>
					<li><strong>E-E-A-T evaluation.</strong> Named authors with credentials, institutional backing, and primary-source citations raise the trust score. For health, legal, financial, and other YMYL queries, E-E-A-T signals are often the deciding factor between cited and not cited.</li>
					<li><strong>Topical authority across the site.</strong> A site with ten deeply interlinked posts on a subject area is more likely to have its pages cited in AI Overviews on that topic than a site with one strong post and nothing supporting it.</li>
				</ol>
			</section>

			<section class="engine-section">
				<h2>YouTube and AI Overviews: the video citation opportunity</h2>
				<p>
					BrightEdge research identified YouTube as a top-3 citation source in AI Overviews across multiple query categories in 2025 and 2026. Google owns YouTube, and the integration between YouTube video content and AI Overview answers is deeper than for any other video platform.
				</p>
				<ul style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Videos with accurate transcripts rank better.</strong> AI Overviews can extract quoted passages from YouTube video transcripts. Videos with auto-generated or manual transcripts that answer specific questions are eligible for AI Overview citation.</li>
					<li><strong>Title and description keyword alignment.</strong> YouTube videos that clearly signal their topic through title, description, and tags are more likely to be surfaced in AI Overviews for matching queries.</li>
					<li><strong>Dual citation surface.</strong> A piece of content covered in both a written page and a YouTube video creates two separate citation surfaces for the same topic, doubling the probability that one of them gets cited in a given AI Overview.</li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>The 2026 AI Overviews SEO playbook</h2>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Rank in the top 10 to 20 organically first.</strong> Nothing else on this list matters without classical Google rank. See <a href="/seo/technical-seo/">technical SEO</a>, <a href="/seo/keyword-research/">keyword research</a>, and <a href="/seo/eeat/">E-E-A-T</a>.</li>
					<li><strong>Write direct-answer openers under every H2.</strong> The first sentence after each H2 should be a complete, standalone answer to the implied question. No scene-setting. No &ldquo;in this section we will explore.&rdquo; Start with the answer.</li>
					<li><strong>Implement FAQPage schema on every page that answers questions.</strong> Structured Q&amp;A pairs are lifted into AI Overviews at disproportionately high rates. If your page answers questions, mark them up.</li>
					<li><strong>Add HowTo schema to process and tutorial content.</strong> Step-by-step content with HowTo schema is rendered by AI Overviews as structured steps with your source attribution intact.</li>
					<li><strong>Name your authors and link their credentials.</strong> Person schema with sameAs links to LinkedIn, author page, and professional profiles. Visible credential statement in the byline. For YMYL queries this is often the tiebreaker between cited and not cited.</li>
					<li><strong>Publish companion YouTube videos for your most important content.</strong> A matching YouTube video creates a second citation surface. Even a short 3-5 minute explainer video on the same topic doubles your AI Overview citation opportunity.</li>
					<li><strong>Build and interlink your topic clusters.</strong> Topical authority across a cluster of related pages is weighted by AI Overviews. Build the cluster, use descriptive internal anchor text, and keep the cluster pages interlinked. See <a href="/seo/content-strategy/">content strategy</a>.</li>
				</ol>
			</section>

			<section class="engine-section">
				<h2>From our blog: AI Overviews SEO in depth</h2>
				<ul class="chapters-strip">
					<li><a href="/blog/how-to-get-cited-by-ai-search-systems/">How to get cited by AI search systems</a></li>
					<li><a href="/blog/eeat-in-the-ai-era/">E-E-A-T in the AI era</a></li>
					<li><a href="/blog/what-is-answer-engine-optimization/">What is AEO?</a></li>
					<li><a href="/blog/gemini-omni-google-io-2026/">Gemini Omni and I/O 2026 analysis</a></li>
					<li><a href="/blog/ultimate-guide-ai-seo-2026/">Ultimate guide to AI SEO</a></li>
					<li><a href="/blog/ai-seo-social-media-guide/">Social media for AI citations</a></li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>Related engine hubs</h2>
				<ul class="chapters-strip">
					<li><a href="/gemini-seo/">Gemini SEO</a></li>
					<li><a href="/ai-mode-seo/">Google AI Mode SEO</a></li>
					<li><a href="/chatgpt-seo/">ChatGPT SEO</a></li>
					<li><a href="/perplexity-seo/">Perplexity SEO</a></li>
					<li><a href="/bing-seo/">Bing SEO</a></li>
					<li><a href="/copilot-seo/">Microsoft Copilot SEO</a></li>
					<li><a href="/aeo/">AEO entity hub</a></li>
					<li><a href="/glossary/">AI SEO Glossary</a></li>
				</ul>
			</section>

			<section class="engine-section" id="faq">
				<h2>Frequently asked questions</h2>
				<div class="faq-shell">
					{faqs.map((f, i) => (
						<details class="faq-item" open={i === 0}>
							<summary>{f.q}</summary>
							<p class="faq-answer">{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
