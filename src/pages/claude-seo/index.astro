---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../../consts';

const canonical = new URL('/claude-seo/', SITE_URL).toString();
const pubDate = new Date('2026-05-26');

const definedTermSchema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTerm',
	'@id': `${canonical}#defined`,
	name: 'Claude SEO',
	description:
		'Claude SEO is the practice of optimizing web content so Anthropic\'s Claude cites it inside generated answers. Claude uses Claude-SearchBot for index crawling and Claude-User for per-query page fetches, and cites more selectively than ChatGPT or Perplexity — favoring high-authority, well-attributed sources.',
	inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'AI SEO Glossary', url: `${SITE_URL}/glossary/` },
};

const faqs = [
	{
		q: 'What is Claude SEO?',
		a: 'Claude SEO is the practice of optimizing content so Claude (Anthropic\'s assistant) cites it inside answers. Claude is the most selective major AI engine for citations — it cites fewer sources per answer than ChatGPT or Perplexity, with a stronger preference for high-authority, well-attributed pages.',
	},
	{
		q: 'How does Claude retrieve content?',
		a: 'Claude uses two bots: Claude-SearchBot crawls the web for the long-term index, and Claude-User fetches pages live when a user asks Claude to look something up. ClaudeBot is the training-only crawler and is a separate decision from citation visibility.',
	},
	{
		q: 'Which Claude bots should I allow in robots.txt?',
		a: 'Claude-SearchBot and Claude-User are the retrieval bots — allow both for citation visibility. ClaudeBot is for training only; blocking it does not affect whether Claude can cite you, only whether Anthropic uses your content to train future models.',
	},
	{
		q: 'Why does Claude cite fewer sources than ChatGPT or Perplexity?',
		a: 'By design. Anthropic has tuned Claude to prefer fewer, higher-confidence citations over many lower-confidence ones. The practical effect is that Claude citations are more competitive — a smaller number of sources are picked per answer — but each citation carries more weight as a trust signal.',
	},
	{
		q: 'What content does Claude cite most?',
		a: 'Well-structured pages with named human authors, primary-source attribution, and a clear single answer to a clear question. Claude particularly weights pages with Person schema, sameAs links to authoritative profiles (Wikipedia, LinkedIn, ORCID), and content that itself cites its sources cleanly.',
	},
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': `${canonical}#article`,
	headline: 'Claude SEO: How to Get Cited by Anthropic\'s Claude',
	description: 'Complete guide to Claude SEO in 2026: how Claude retrieves content, which bots to allow, why Claude cites more selectively than other engines, and the optimization playbook.',
	url: canonical,
	mainEntityOfPage: canonical,
	datePublished: pubDate.toISOString(),
	dateModified: pubDate.toISOString(),
	inLanguage: 'en-US',
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
	about: { '@id': `${canonical}#defined` },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${canonical}#faq`,
	isPartOf: { '@id': `${canonical}#article` },
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'Claude SEO', item: canonical },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Claude SEO: How to Get Cited by Anthropic's Claude (2026) | ${SITE_TITLE}`}
			description="Claude SEO is how you get cited by Anthropic's Claude. Full guide: Claude-SearchBot retrieval, robots.txt rules, the selective citation behavior, and the 2026 playbook."
			canonical={canonical}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={pubDate.toISOString()}
			structuredData={[articleSchema, definedTermSchema, faqSchema, breadcrumbSchema]}
		/>
		<style>
			.engine-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }
			.engine-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.engine-hero .kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); margin: 0; }
			.engine-hero h1 { font-size: clamp(2.4rem, 5vw, 4.4rem); line-height: 0.98; letter-spacing: -0.032em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 14ch; }
			.engine-hero h1 em { font-style: italic; font-weight: 400; color: var(--signal-deep); }
			.engine-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0 0 var(--space-4); }
			.engine-svg { margin: var(--space-7) 0 0; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); overflow: hidden; }
			.engine-svg svg { display: block; width: 100%; height: auto; }
			.engine-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.engine-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 22ch; }
			.engine-section p { font-size: 1.05rem; line-height: 1.7; color: rgba(var(--ink), 0.85); margin: 0 0 var(--space-4); max-width: var(--measure); }
			.engine-callout { margin: var(--space-6) 0; padding: var(--space-5) var(--space-6); background: rgb(var(--paper-strong)); border: 1px solid var(--line); border-left: 3px solid var(--signal); border-radius: var(--radius-md); }
			.engine-callout p { margin: 0; font-size: 1rem; line-height: 1.65; }
			.engine-callout strong { font-weight: 700; }
			.chapters-strip { margin: var(--space-5) 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; padding: 0; list-style: none; }
			.chapters-strip li { margin: 0; }
			.chapters-strip a { display: inline-flex; padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid var(--line-strong); background: rgb(var(--paper)); color: rgb(var(--ink)); text-decoration: none; font-size: 0.82rem; font-weight: 600; line-height: 1; }
			.chapters-strip a:hover { color: var(--signal-deep); border-color: var(--signal); }
			.faq-shell { border-top: 1px solid var(--line-strong); margin-top: var(--space-4); }
			.faq-item { border-bottom: 1px solid var(--line); padding: var(--space-5) 0; }
			.faq-item summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; font-size: 1.15rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.012em; color: rgb(var(--ink)); }
			.faq-item summary::-webkit-details-marker { display: none; }
			.faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--signal-deep); }
			.faq-item[open] summary::after { content: '−'; }
			.faq-answer { margin: var(--space-3) 0 0; font-size: 1rem; line-height: 1.7; color: rgba(var(--ink), 0.85); max-width: 60ch; }
			.engine-author { display: inline-flex; align-items: center; gap: 0.75rem; margin: var(--space-4) 0 0; text-decoration: none; color: rgb(var(--ink)); }
			.engine-author img { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); }
			.engine-author-text { display: inline-flex; flex-direction: column; line-height: 1.25; font-size: 0.85rem; }
			.engine-author-name { font-weight: 700; }
			.engine-author-role { color: var(--ink-muted); font-size: 0.75rem; }
			@media (max-width: 860px) { .engine-hero { grid-template-columns: 1fr; gap: var(--space-5); } }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="engine-page">
			<section class="engine-hero">
				<div>
					<p class="kicker">AISEOShift · Engine Hub</p>
					<h1>Claude SEO. The <em>selective</em> citation.</h1>
				</div>
				<div class="engine-hero-lede">
					<p>
						Claude is the most selective of the major AI engines. It cites fewer sources per answer
						than ChatGPT or Perplexity, with a stronger bias toward high-authority pages. Claude SEO
						is the discipline of being one of those few sources.
					</p>
					<a class="engine-author" href={AUTHOR_PROFILE_URL} rel="author">
						<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="40" height="40" />
						<span class="engine-author-text">
							<span class="engine-author-name">By {AUTHOR_NAME}</span>
							<span class="engine-author-role">{AUTHOR_ROLE}</span>
						</span>
					</a>
				</div>
			</section>

			<div class="engine-svg" aria-hidden="true">
				<svg viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
					<rect width="800" height="220" fill="rgb(246,245,240)" />
					<g font-family="system-ui, sans-serif" font-size="10" letter-spacing="2.4" fill="rgb(14,17,22)" fill-opacity="0.6">
						<text x="60" y="36">USER QUESTION</text>
						<text x="320" y="36">CLAUDE</text>
						<text x="600" y="36">FEW HIGH-TRUST CITATIONS</text>
					</g>
					<g transform="translate(40 60)">
						<rect width="200" height="80" rx="3" fill="none" stroke="rgb(14,17,22)" stroke-opacity="0.45" />
						<text x="20" y="34" font-family="Iowan Old Style, Georgia, serif" font-style="italic" font-size="13" fill="rgb(14,17,22)">"explain Person schema</text>
						<text x="20" y="54" font-family="Iowan Old Style, Georgia, serif" font-style="italic" font-size="13" fill="rgb(14,17,22)">for E-E-A-T"</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 250 100 C 280 100, 290 100, 320 100" />
						<polyline points="310,94 320,100 310,106" />
					</g>
					<g transform="translate(320 60)">
						<rect width="220" height="80" rx="3" fill="rgb(14,17,22)" />
						<text x="110" y="34" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="rgb(250,250,247)">CLAUDE-SEARCHBOT</text>
						<text x="110" y="56" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="rgb(250,250,247)">CLAUDE-USER · STRICT FILTER</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 550 100 C 580 100, 590 100, 620 100" />
						<polyline points="610,94 620,100 610,106" />
					</g>
					<g transform="translate(620 60)" fill="rgb(184,85,46)">
						<rect width="140" height="22" rx="2" />
						<rect y="28" width="140" height="22" rx="2" />
					</g>
					<text x="400" y="190" text-anchor="middle" font-family="Iowan Old Style, Georgia, serif" font-style="italic" font-size="13" fill="rgb(14,17,22)" fill-opacity="0.7">Claude cites 2 to 5 sources per answer. Selection bar is high.</text>
				</svg>
			</div>

			<section class="engine-section">
				<h2>Definition: what Claude SEO means</h2>
				<p>
					<strong>Claude SEO</strong> is the practice of optimizing web content so it gets cited inside answers generated by Anthropic&rsquo;s Claude. Claude differs from ChatGPT and Perplexity in two ways: it runs its own retrieval stack rather than leaning on Bing or Google, and it cites more selectively. Where Perplexity might surface 10 footnotes and ChatGPT 5-8, Claude often cites 2-5 sources per answer.
				</p>
				<p>
					The selectivity is tuned in. Anthropic has built Claude to prefer fewer, higher-confidence citations. The result: fewer slots, more competition, and a stronger lift in brand authority when you do get cited. The pages that win are ones with clear named authorship, primary-source attribution, and high topical authority on the specific question being asked.
				</p>
				<div class="engine-callout">
					<p><strong>The shortest version.</strong> Claude rewards authoritative depth, not volume. One excellent page on your topic beats five mediocre ones.</p>
				</div>
			</section>

			<section class="engine-section">
				<h2>How Claude retrieves and cites</h2>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Index crawl: Claude-SearchBot.</strong> Continuously crawls the web building Anthropic&rsquo;s retrieval index.</li>
					<li><strong>Live fetch: Claude-User.</strong> Used when a user asks Claude to look up specific information, or when Claude needs current data not in the long-term index.</li>
					<li><strong>Rank candidates with strict trust filters.</strong> Claude weights Person schema, named authorship, sameAs links, and content that itself cites primary sources particularly heavily.</li>
					<li><strong>Synthesize sparingly.</strong> Generate the answer from the strongest 2-5 candidates rather than the broadest set of plausibly-relevant ones.</li>
					<li><strong>Cite explicitly.</strong> Inline source links appear in the answer; the user can click through to verify.</li>
				</ol>
			</section>

			<section class="engine-section">
				<h2>The 2026 Claude SEO playbook</h2>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Allow Claude-SearchBot and Claude-User.</strong> Both. ClaudeBot (training-only) is a separate decision.</li>
					<li><strong>Build topical authority depth, not breadth.</strong> Claude rewards 12 deep posts on one topic over 100 thin posts on twelve. Match the <a href="/seo/content-strategy/">topic cluster</a> model.</li>
					<li><strong>Implement Person and Organization schema with sameAs.</strong> Linked-data attribution to authoritative profiles (Wikipedia, LinkedIn, ORCID, Crossref) is the single biggest Claude-specific trust signal.</li>
					<li><strong>Cite primary sources inline.</strong> Claude pulls disproportionately from pages that demonstrate the citation pattern Claude itself uses. Reciprocity matters.</li>
					<li><strong>Write definitive answers.</strong> Claude favors pages that present one clear conclusion, not pages that hedge across many possibilities. The <a href="/glossary/">glossary</a> format is an example.</li>
				</ol>
			</section>

			<section class="engine-section">
				<h2>Why Claude&rsquo;s selectivity makes each citation more valuable</h2>
				<p>Claude cites 2 to 5 sources per answer. ChatGPT cites 3 to 8. Perplexity cites 5 to 15. The lower count has two direct consequences:</p>
				<ul style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Higher barrier to entry.</strong> A page that earns a citation from Perplexity may not earn one from Claude. Claude&rsquo;s trust filters are more stringent. Named authors, sameAs schema, and primary-source citations are threshold requirements, not optional extras.</li>
					<li><strong>Stronger authority signal when you appear.</strong> Being one of three sources Claude selected for an answer carries more credibility with readers than being one of twelve Perplexity footnotes. The scarcity creates perceived authority. Users who follow a Claude citation are more engaged because Claude cited fewer alternatives.</li>
				</ul>
				<div class="engine-callout">
					<p><strong>Strategy implication.</strong> If you are investing in AI SEO and must prioritize one engine, Claude sets the highest bar. The content quality required to earn Claude citations will also earn citations from every other AI engine. Build for Claude first.</p>
				</div>
			</section>

			<section class="engine-section">
				<h2>Content patterns Claude rewards</h2>
				<ul style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Single-question focus per page.</strong> A page that fully answers one specific question outperforms a page that partially answers five. Claude&rsquo;s synthesis prefers clean, quotable answers it can present without hedging.</li>
					<li><strong>Linked-data author attribution.</strong> Person schema with sameAs links to LinkedIn, personal site, ORCID (for researchers), and Wikipedia where applicable is the most impactful single technical signal for Claude citation eligibility. Claude treats the linked authority chain as a trust proxy.</li>
					<li><strong>Inline primary source citations.</strong> Claude pulls from pages that follow the same citation pattern Claude uses in its own answers. Cite your data sources explicitly within the body of the content, not just in a bibliography.</li>
					<li><strong>Topical depth over breadth.</strong> Ten comprehensive posts on one subject outperform one hundred thin posts across many subjects. Claude weights topical authority at the site level, not just the individual page. A site with deep coverage of one niche outranks a generalist site with one strong page on the topic.</li>
					<li><strong>Definitive conclusions.</strong> Claude favors pages that present a clear, well-reasoned conclusion rather than hedging across multiple possibilities. The glossary and definition format works particularly well.</li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>How to check if Claude is citing your content</h2>
				<ul style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Direct testing:</strong> Ask Claude questions your content answers. Use Claude.ai with web access enabled. Note whether your domain appears in citations for your 10 most important queries.</li>
					<li><strong>Referral traffic:</strong> Monitor claude.ai as a referral source in your analytics. Claude-generated traffic is identifiable in most analytics platforms when users click through on cited sources.</li>
					<li><strong>AI visibility tools:</strong> Profound, Otterly, and Peec are building Claude citation tracking alongside ChatGPT and Perplexity monitoring. Coverage is expanding as the tools mature.</li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>From our blog: Claude SEO in depth</h2>
				<ul class="chapters-strip">
					<li><a href="/blog/how-to-get-cited-by-ai-search-systems/">How to get cited by AI search systems</a></li>
					<li><a href="/blog/eeat-in-the-ai-era/">E-E-A-T in the AI era</a></li>
					<li><a href="/blog/what-is-answer-engine-optimization/">What is answer engine optimization?</a></li>
					<li><a href="/blog/ai-seo-glossary/">AI SEO glossary</a></li>
					<li><a href="/blog/ultimate-guide-ai-seo-2026/">Ultimate guide to AI SEO</a></li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>Related entity hubs and chapters</h2>
				<ul class="chapters-strip">
					<li><a href="/aeo/">AEO entity hub</a></li>
					<li><a href="/geo/">GEO entity hub</a></li>
					<li><a href="/chatgpt-seo/">ChatGPT SEO</a></li>
					<li><a href="/perplexity-seo/">Perplexity SEO</a></li>
					<li><a href="/gemini-seo/">Gemini SEO</a></li>
					<li><a href="/seo/ai-citation-building/">AI Citation Building</a></li>
					<li><a href="/seo/schema-markup/">Schema Markup</a></li>
					<li><a href="/seo/eeat/">E-E-A-T</a></li>
					<li><a href="/glossary/">AI SEO Glossary</a></li>
				</ul>
			</section>

			<section class="engine-section" id="faq">
				<h2>Frequently asked questions</h2>
				<div class="faq-shell">
					{faqs.map((f, i) => (
						<details class="faq-item" open={i === 0}>
							<summary>{f.q}</summary>
							<p class="faq-answer">{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
