---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import imageManifest from '../../data/image-manifest.json';
import { marketingHubs } from '../../data/marketing-hubs';
import { SITE_TITLE, SITE_URL } from '../../consts';
import { sortPostsByDate } from '../../utils/blog';

export const getStaticPaths = async () => {
	const now = new Date();
	const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= now);
	return marketingHubs.map((hub) => ({
		params: { hub: hub.slug },
		props: { hub, posts: sortPostsByDate(allPosts.filter((p) => p.data.tags.includes(hub.tag))) },
	}));
};

const { hub, posts } = Astro.props;
const canonicalUrl = `${SITE_URL}/marketing/${hub.slug}/`;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `${hub.title} | ${SITE_TITLE}`,
	description: hub.description,
	url: canonicalUrl,
	isPartOf: { '@id': `${SITE_URL}/#website` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	inLanguage: 'en-US',
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE_URL}/blog/${p.id}/`, name: p.data.title })),
	},
	breadcrumb: {
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
			{ '@type': 'ListItem', position: 2, name: 'Marketing', item: `${SITE_URL}/marketing/` },
			{ '@type': 'ListItem', position: 3, name: hub.title, item: canonicalUrl },
		],
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${hub.title} | ${SITE_TITLE}`} description={hub.description} canonical={canonicalUrl} structuredData={schema} />
		<style>
			.archive {
				width: min(1200px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 2rem 0 4rem;
			}

			.archive-header {
				margin-bottom: 2rem;
				max-width: 56rem;
				padding: 1.6rem 1.8rem;
				border-radius: 2rem;
				border: 1px solid rgba(var(--ink), 0.1);
				background: var(--panel);
				box-shadow: var(--shadow-soft);
			}

			.breadcrumbs {
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: rgba(var(--ink), 0.7);
				margin: 0 0 0.75rem;
			}

			.breadcrumbs a {
				text-decoration: none;
				color: inherit;
			}

			.breadcrumbs a:hover { color: var(--signal-deep); }

			.archive-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.archive-card {
				padding: 1.5rem;
				border: 1px solid rgba(var(--ink), 0.1);
				border-radius: 1.75rem;
				background: var(--panel);
				box-shadow: var(--shadow-tight);
			}

			.archive-card a {
				text-decoration: none;
				color: inherit;
			}

			.archive-card:hover { transform: translateY(-3px); }

			.archive-card h2 {
				font-size: 1.45rem;
				margin-bottom: 0.75rem;
			}

			.archive-thumb {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 1.25rem;
				margin-bottom: 1rem;
			}

			.archive-card p { margin-bottom: 0.75rem; }

			.meta {
				color: rgba(var(--ink), 0.68);
				font-size: 0.84rem;
			}

			.category {
				font-size: 0.68rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				font-weight: 700;
				color: var(--signal-deep);
			}

			@media (max-width: 900px) {
				.archive-grid { grid-template-columns: 1fr; }
			}

			.hub-intro p { max-width: 46rem; }

			.hub-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }

			.hub-nav a { display: inline-block; padding: 0.35rem 0.8rem; border-radius: 999px; border: 1px solid rgba(var(--ink), 0.15); text-decoration: none; color: inherit; font-size: 0.85rem; }

			.hub-nav a[aria-current='page'] { border-color: var(--signal-deep); color: var(--signal-deep); }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="archive">
			<header class="archive-header hub-intro">
				<p class="breadcrumbs"><a href="/">Home</a> / <a href="/marketing/">Marketing</a> / {hub.title}</p>
				<p class="category">Marketing hub</p>
				<h1>{hub.title}</h1>
				{hub.intro.map((para) => <p>{para}</p>)}
				<ul class="hub-nav" aria-label="Marketing hubs">
					{marketingHubs.map((h) => <li><a href={`/marketing/${h.slug}/`} aria-current={h.slug === hub.slug ? 'page' : undefined}>{h.title}</a></li>)}
				</ul>
			</header>
			<section aria-label={`${hub.title} articles`}>
				<ul class="archive-grid">
					{
						posts.map((post) => (
							<li class="archive-card">
								<a href={`/blog/${post.id}/`}>
									{imageManifest[post.id as keyof typeof imageManifest]?.hero && (
										<img
											class="archive-thumb"
											src={imageManifest[post.id as keyof typeof imageManifest].hero.src}
											alt={imageManifest[post.id as keyof typeof imageManifest].hero.alt}
											loading="lazy"
										/>
									)}
									<p class="category">{post.data.category}</p>
									<h2>{post.data.title}</h2>
									<p>{post.data.deck}</p>
									<div class="meta">
										<FormattedDate date={post.data.pubDate} /> · {post.data.author}
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
