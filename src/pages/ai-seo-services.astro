---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const CALENDLY_URL = 'https://calendly.com/shashank19/15min';
const WEB3FORMS_ACCESS_KEY = 'd165756b-c4fc-484f-9914-97af89d0421e';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	provider: { '@type': 'Organization', name: SITE_TITLE },
	areaServed: 'Worldwide',
	serviceType: 'AI SEO Services',
	description:
		'AI SEO services for businesses that need visibility in Google, ChatGPT, Perplexity, Claude, and other AI search environments.',
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'AI SEO services by industry',
		itemListElement: [
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Dentists', url: 'https://aiseoshift.com/ai-seo-services/dentists/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Doctors and Medical Practices', url: 'https://aiseoshift.com/ai-seo-services/doctors/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Chiropractors', url: 'https://aiseoshift.com/ai-seo-services/chiropractors/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Real Estate Agents', url: 'https://aiseoshift.com/ai-seo-services/real-estate-agents/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Home Services', url: 'https://aiseoshift.com/ai-seo-services/home-services/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Restaurants', url: 'https://aiseoshift.com/ai-seo-services/restaurants/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Auto Dealers', url: 'https://aiseoshift.com/ai-seo-services/auto-dealers/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Lawyers and Law Firms', url: 'https://aiseoshift.com/ai-seo-services/lawyers/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for Accountants and CPA Firms', url: 'https://aiseoshift.com/ai-seo-services/accountants/' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI SEO for SaaS Companies', url: 'https://aiseoshift.com/ai-seo-services/saas/' } },
		],
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO Services | ${SITE_TITLE}`}
			description="AI SEO services for businesses that want stronger visibility in Google Search, AI Overviews, ChatGPT, Claude, and Perplexity."
			structuredData={structuredData}
		/>
		<style>
			.svc-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }

			.svc-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.svc-kicker { display: inline-flex; padding: 0; color: var(--ink-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
			.svc-hero h1 { font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1; letter-spacing: -0.03em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 16ch; }
			.svc-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0; }

			.svc-cta-row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-5); }
			.svc-btn { display: inline-flex; align-items: center; padding: 0.85rem 1.4rem; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
			.svc-btn-primary { background: rgb(var(--ink)); color: rgb(var(--paper)); }
			.svc-btn-primary:hover { background: var(--signal-deep); }
			.svc-btn-secondary { background: transparent; color: rgb(var(--ink)); border: 1px solid var(--line-strong); }
			.svc-btn-secondary:hover { border-color: rgb(var(--ink)); }

			.svc-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.svc-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 18ch; }
			.svc-section > p { font-size: 1.05rem; line-height: 1.65; color: rgba(var(--ink), 0.82); max-width: var(--measure); margin: 0 0 var(--space-6); }

			.svc-list { list-style: none; margin: 0; padding: 0; }
			.svc-list li { margin: 0; }
			.svc-row { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-6); align-items: baseline; padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.svc-list li:last-child .svc-row { border-bottom: 1px solid var(--line); }
			.svc-row-num { font-family: 'Iowan Old Style', Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.1rem; color: var(--ink-muted); }
			.svc-row h3 { font-size: 1.3rem; line-height: 1.2; margin: 0 0 var(--space-2); letter-spacing: -0.018em; font-weight: 600; }
			.svc-row p { font-size: 0.95rem; line-height: 1.55; color: var(--ink-muted); margin: 0 0 var(--space-3); max-width: 52ch; }
			.svc-row ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
			.svc-row ul li { font-size: 0.82rem; color: var(--ink-muted); }
			.svc-row ul li + li::before { content: '·'; margin-right: var(--space-3); color: var(--line-strong); }

			.outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; }
			.outcome { padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
			.outcome strong { display: block; font-family: 'Iowan Old Style', Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.15rem; color: rgb(var(--ink)); margin-bottom: var(--space-3); }
			.outcome span { font-size: 0.95rem; color: var(--ink-muted); line-height: 1.55; }

			.contact-block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; align-items: start; }
			@media (max-width: 860px) { .svc-hero, .outcomes, .contact-block { grid-template-columns: 1fr; } .svc-row { grid-template-columns: 1fr; gap: var(--space-3); } }

			.contact-card { padding: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); }
			.contact-card h3 { font-size: 1.25rem; margin: 0 0 var(--space-3); letter-spacing: -0.015em; font-weight: 600; }
			.contact-card > p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); margin: 0 0 var(--space-5); }
			.contact-form { display: flex; flex-direction: column; gap: var(--space-3); }
			.contact-form label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; color: rgba(var(--ink), 0.85); text-transform: uppercase; }
			.contact-form .req { color: var(--signal-deep); margin-left: 0.15rem; }
			.contact-form input:focus-visible, .contact-form select:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; border-color: rgb(var(--ink)); }
			.contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 0.7rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font-size: 0.95rem; font-family: inherit; background: rgb(var(--paper)); color: rgb(var(--ink)); box-sizing: border-box; }
			.contact-form textarea { min-height: 120px; resize: vertical; }
			.contact-form button { margin-top: var(--space-3); padding: 0.85rem 1rem; background: rgb(var(--ink)); color: rgb(var(--paper)); font-weight: 600; font-size: 0.95rem; border: none; border-radius: var(--radius-sm); cursor: pointer; }
			.contact-form button:hover { background: var(--signal-deep); }
			.form-status { margin-top: var(--space-3); font-size: 0.9rem; display: none; }
			.form-status.success { display: block; color: #047857; }
			.form-status.error { display: block; color: #b91c1c; }

			.faq-list { margin: 0; padding: 0; list-style: none; }
			.faq-list li { padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.faq-list li:last-child { border-bottom: 1px solid var(--line); }
			.faq-list h3 { font-size: 1.1rem; margin: 0 0 var(--space-2); letter-spacing: -0.012em; font-weight: 600; }
			.faq-list p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); max-width: 56ch; }

			.industries { margin: var(--space-5) 0 0; display: flex; flex-direction: column; gap: var(--space-7); }
			.industry-group h3 { font-family: 'Iowan Old Style', Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.15rem; color: var(--ink-muted); margin: 0 0 var(--space-3); letter-spacing: 0; }
			.industry-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0; border-top: 1px solid var(--line); }
			.industry-card { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4) var(--space-5) var(--space-4) 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); text-decoration: none; color: inherit; transition: background 120ms ease; }
			.industry-card:hover { background: rgb(var(--paper-strong)); }
			.industry-card:hover .industry-name { color: var(--signal-deep); }
			.industry-card .industry-name { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.012em; padding-left: var(--space-5); }
			.industry-card .industry-name::after { content: ' →'; color: var(--ink-muted); font-weight: 400; }
			.industry-card .industry-desc { font-size: 0.88rem; line-height: 1.5; color: var(--ink-muted); padding-left: var(--space-5); max-width: 36ch; }
			@media (max-width: 540px) { .industry-card { border-right: none; } }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="svc-page">
			<section class="svc-hero">
				<div>
					<span class="svc-kicker">AI SEO Services</span>
					<h1>Visibility in search and inside AI answers.</h1>
				</div>
				<div class="svc-hero-lede">
					<p>
						Google AI Overviews, ChatGPT, Perplexity, and other answer engines now shape how people
						discover and trust businesses. We help you improve traditional search visibility while
						making your site easier to cite, summarize, and trust in AI-generated results.
					</p>
					<div class="svc-cta-row">
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min call &rarr;</a>
						<a class="svc-btn svc-btn-secondary" href="#industries">See by industry</a>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>What we do</h2>
				<p>Three services covering audits, implementation, and ongoing growth across traditional search and AI search surfaces.</p>
				<ol class="svc-list">
					<li>
						<div class="svc-row">
							<span class="svc-row-num">01</span>
							<div>
								<h3>AI Search Visibility Audit</h3>
								<p>One-time audit of how your site appears across Google Search, AI Overviews, ChatGPT, and Perplexity, with a prioritized action plan.</p>
								<ul><li>SERP and AI citation audit</li><li>E-E-A-T and schema review</li><li>Topic gap analysis</li><li>Action roadmap</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">02</span>
							<div>
								<h3>AI SEO Implementation</h3>
								<p>Project work to improve page structure, entity clarity, schema, internal linking, and content formatting so your site is easier for AI systems to understand and cite.</p>
								<ul><li>Page structure for answer extraction</li><li>Schema implementation</li><li>Content refresh and rewriting</li><li>Internal linking improvements</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">03</span>
							<div>
								<h3>Ongoing AI SEO Retainer</h3>
								<p>Monthly support that combines technical SEO, content strategy, topical growth, and AI visibility monitoring into one operating rhythm.</p>
								<ul><li>Monthly content production</li><li>Technical SEO maintenance</li><li>AI citation monitoring</li><li>Monthly reporting</li></ul>
							</div>
						</div>
					</li>
				</ol>
			</section>

			<section class="svc-section">
				<h2>Who we work with</h2>
				<p>Professional service businesses, SaaS companies, and expertise-driven brands that need to be found by people researching solutions in both search engines and AI answer engines.</p>
				<div class="outcomes">
					<div class="outcome"><strong>Both surfaces</strong><span>Optimization for Google rankings and AI answer visibility together.</span></div>
					<div class="outcome"><strong>Authority first</strong><span>Content and structure built around expertise, trust, and topical depth.</span></div>
					<div class="outcome"><strong>Measured</strong><span>Reporting that looks beyond rankings into citations, branded demand, and qualified traffic.</span></div>
				</div>
			</section>

			<section class="svc-section" id="industries">
				<h2>By industry</h2>
				<p>Dedicated AI SEO playbooks for the verticals we work in most often. Each industry page covers the audit, implementation, and ongoing retainer offers tailored to that business model — pricing ranges, schema patterns, and competitive realities included.</p>
				<div class="industries">
					<div class="industry-group">
						<h3>Healthcare</h3>
						<div class="industry-grid">
							<a class="industry-card" href="/ai-seo-services/dentists/">
								<span class="industry-name">AI SEO for Dentists</span>
								<span class="industry-desc">Patient discovery for dental practices. Local pack, review velocity, procedure pages, Dentist schema.</span>
							</a>
							<a class="industry-card" href="/ai-seo-services/doctors/">
								<span class="industry-name">AI SEO for Doctors</span>
								<span class="industry-desc">YMYL-grade visibility for medical practices. Physician E-E-A-T, condition pages, Physician schema.</span>
							</a>
							<a class="industry-card" href="/ai-seo-services/chiropractors/">
								<span class="industry-name">AI SEO for Chiropractors</span>
								<span class="industry-desc">Sciatica, herniated disc, sports injuries. Condition pages, GBP, and HIPAA-safe review systems.</span>
							</a>
						</div>
					</div>
					<div class="industry-group">
						<h3>Local services</h3>
						<div class="industry-grid">
							<a class="industry-card" href="/ai-seo-services/real-estate-agents/">
								<span class="industry-name">AI SEO for Real Estate</span>
								<span class="industry-desc">Hyperlocal authority for agents and brokerages. Neighborhood pages, RealEstateAgent schema, reviews.</span>
							</a>
							<a class="industry-card" href="/ai-seo-services/home-services/">
								<span class="industry-name">AI SEO for Home Services</span>
								<span class="industry-desc">Plumbers, electricians, HVAC, roofing. Local pack domination, service-area pages, review velocity.</span>
							</a>
							<a class="industry-card" href="/ai-seo-services/restaurants/">
								<span class="industry-name">AI SEO for Restaurants</span>
								<span class="industry-desc">Independents and restaurant groups. Menu schema with dietary tags, GBP, atmosphere content.</span>
							</a>
							<a class="industry-card" href="/ai-seo-services/auto-dealers/">
								<span class="industry-name">AI SEO for Auto Dealers</span>
								<span class="industry-desc">New and used dealerships. Vehicle schema on VDPs, model and trim content, multi-platform reviews.</span>
							</a>
						</div>
					</div>
					<div class="industry-group">
						<h3>Professional services and B2B</h3>
						<div class="industry-grid">
							<a class="industry-card" href="/ai-seo-services/lawyers/">
								<span class="industry-name">AI SEO for Lawyers</span>
								<span class="industry-desc">Practice area pages, attorney E-E-A-T, LegalService schema. Built for YMYL legal queries.</span>
							</a>
							<a class="industry-card" href="/ai-seo-services/accountants/">
								<span class="industry-name">AI SEO for Accountants</span>
								<span class="industry-desc">CPA firms and bookkeepers. Specialty depth, seasonal content cadence, AccountingService schema.</span>
							</a>
							<a class="industry-card" href="/ai-seo-services/saas/">
								<span class="industry-name">AI SEO for SaaS</span>
								<span class="industry-desc">B2B platforms and software. Comparison pages, programmatic SEO, SoftwareApplication schema.</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="svc-section" id="quote">
				<h2>Get a quote</h2>
				<p>Book a free 15-minute strategy call or send a quote request below. We respond within one business day.</p>
				<div class="contact-block">
					<div class="contact-card">
						<h3>Book a strategy call</h3>
						<p>We will review your current visibility, your goals, and where AI SEO can have the biggest impact.</p>
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Open Calendly &rarr;</a>
					</div>
					<div class="contact-card">
						<h3 id="quote-form-heading">Request a quote by form</h3>
						<p>Send a short description of your business and goals, and we will reply with next steps.</p>
						<form class="contact-form" id="quote-form" aria-labelledby="quote-form-heading">
							<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
							<input type="hidden" name="subject" value="New quote request from aiseoshift.com" />
							<input type="hidden" name="from_name" value="AISEOShift Quote Form" />
							<input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
							<label for="q-name">Name <span class="req" aria-hidden="true">*</span></label>
							<input id="q-name" type="text" name="name" required aria-required="true" autocomplete="name" />
							<label for="q-email">Email <span class="req" aria-hidden="true">*</span></label>
							<input id="q-email" type="email" name="email" required aria-required="true" autocomplete="email" />
							<label for="q-company">Company / website</label>
							<input id="q-company" type="text" name="company" autocomplete="organization" />
							<label for="q-service">Service interested in <span class="req" aria-hidden="true">*</span></label>
							<select id="q-service" name="service" required aria-required="true">
								<option value="">Select a service…</option>
								<option value="AI Search Visibility Audit">AI Search Visibility Audit</option>
								<option value="AI SEO Implementation">AI SEO Implementation</option>
								<option value="Ongoing AI SEO Retainer">Ongoing AI SEO Retainer</option>
								<option value="Not sure yet">Not sure yet</option>
							</select>
							<label for="q-message">What are you trying to achieve? <span class="req" aria-hidden="true">*</span></label>
							<textarea id="q-message" name="message" required aria-required="true" placeholder="Tell us about your business and goals."></textarea>
							<button type="submit">Send quote request</button>
							<div class="form-status" id="form-status" role="status" aria-live="polite"></div>
						</form>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>FAQs</h2>
				<ul class="faq-list">
					<li>
						<h3>What is AI SEO?</h3>
						<p>AI SEO is the practice of improving your site so it can perform better in both traditional search results and AI-generated answers, summaries, and citations.</p>
					</li>
					<li>
						<h3>How is AI SEO different from standard SEO?</h3>
						<p>Standard SEO focuses heavily on rankings and click-throughs. AI SEO also focuses on how pages are interpreted, summarized, and cited by systems like ChatGPT, Perplexity, Claude, and Google AI Overviews.</p>
					</li>
					<li>
						<h3>Do you only work with specific industries?</h3>
						<p>We work best with expertise-driven businesses where trust, authority, and organic discovery matter.</p>
					</li>
					<li>
						<h3>Do you offer one-time projects or only retainers?</h3>
						<p>Both. Audits and implementation projects can be one-time. Ongoing retainers are available for continued growth.</p>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				const form = document.getElementById('quote-form');
				const status = document.getElementById('form-status');
				if (!form || !status) return;
				form.addEventListener('submit', async function (e) {
					e.preventDefault();
					status.className = 'form-status';
					status.textContent = '';
					const accessKey = form.querySelector('input[name="access_key"]').value;
					if (!accessKey || accessKey === 'REPLACE_WITH_WEB3FORMS_KEY') {
						status.className = 'form-status error';
						status.textContent = 'Form not configured yet. Email hello@aiseoshift.com directly.';
						return;
					}
					const formData = new FormData(form);
					try {
						const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { Accept: 'application/json' }, body: formData });
						const data = await res.json();
						if (data.success) {
							status.className = 'form-status success';
							status.textContent = 'Thanks! We received your request and will reply within one business day.';
							form.reset();
						} else {
							status.className = 'form-status error';
							status.textContent = 'Something went wrong. Please email hello@aiseoshift.com directly.';
						}
					} catch {
						status.className = 'form-status error';
						status.textContent = 'Network error. Please try again or email hello@aiseoshift.com directly.';
					}
				});
			})();
		</script>
	</body>
</html>
