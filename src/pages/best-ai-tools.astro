---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../consts';

const canonical = new URL('/best-ai-tools/', SITE_URL).toString();
const pubDate = new Date('2026-06-15');
const now = new Date();

// Curated roundup clusters. Titles are pulled live from the blog collection,
// so they stay correct and only published (non-draft, past-dated) posts render.
const groups: { category: string; slugs: string[] }[] = [
	{
		category: 'AI SEO and visibility',
		slugs: [
			'best-ai-seo-tools',
			'best-ai-visibility-tools-2026',
			'best-aeo-geo-tools-2026',
			'best-ai-keyword-research-tools',
			'best-ai-rank-tracking-tools',
			'best-ai-mode-seo-tracking-tools',
			'best-surfer-seo-alternatives',
			'best-ai-link-building-tools',
			'best-ai-analytics-tools-seo',
			'best-google-indexing-tools',
			'best-seo-mcp-servers-github',
			'best-ai-writing-tools-for-seo',
			'ai-seo-tools-visibility-optimization',
		],
	},
	{
		category: 'AI writing and content',
		slugs: [
			'best-ai-writing-tools',
			'best-chatgpt-alternatives',
			'best-jasper-alternatives',
			'best-copy-ai-alternatives',
			'ai-content-humanizers',
			'ai-paraphrasing-tools',
			'ai-grammar-checkers',
			'ai-citation-generators',
			'plagiarism-checkers',
		],
	},
	{
		category: 'AI detection',
		slugs: ['ai-detection-tools-for-writers', 'ai-content-detection-tools', 'best-ai-image-detectors-2026'],
	},
	{
		category: 'AI image, video, and voice',
		slugs: [
			'ai-image-generators',
			'best-ai-video-generators',
			'best-ai-voice-generators',
			'best-ai-logo-makers',
			'best-ai-video-tools-content-marketing',
		],
	},
	{
		category: 'AI for business and productivity',
		slugs: [
			'best-ai-chatbots-for-websites',
			'best-ai-crm-tools-small-business',
			'best-ai-sales-tools-2026',
			'best-ai-email-marketing-tools',
			'best-ai-social-media-tools',
			'best-ai-transcription-tools',
			'best-ai-pdf-tools',
			'best-ai-resume-builders',
			'ai-presentation-tools',
			'25-best-ai-website-builders',
			'best-ai-coding-tools-2026',
			'best-web-scraping-proxy-tools-2026',
			'best-ai-tools-for-digital-marketers',
		],
	},
	{
		category: 'AI tools by profession',
		slugs: [
			'ai-tools-for-accountants',
			'ai-tools-for-lawyers',
			'ai-tools-for-doctors',
			'ai-tools-for-real-estate-agents',
			'ai-tools-for-recruiters',
			'ai-tools-for-sales-reps',
		],
	},
	{
		category: 'AI SEO agencies',
		slugs: ['best-ai-seo-agencies', 'best-ai-powered-local-seo-agency'],
	},
];

const posts = await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= now);
const byId = new Map(posts.map((p) => [p.id, p]));

const rendered = groups
	.map((g) => ({
		category: g.category,
		items: g.slugs
			.map((s) => byId.get(s))
			.filter((p): p is (typeof posts)[number] => Boolean(p))
			.map((p) => ({ slug: p.id, title: p.data.title, description: p.data.description })),
	}))
	.filter((g) => g.items.length > 0);

const total = rendered.reduce((n, g) => n + g.items.length, 0);

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'Best AI Tools', item: canonical },
	],
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	'@id': `${canonical}#tools`,
	name: 'Best AI Tools guides',
	itemListElement: rendered
		.flatMap((g) => g.items)
		.map((it, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: it.title,
			url: new URL(`/blog/${it.slug}/`, SITE_URL).toString(),
		})),
};

const collectionPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'@id': `${canonical}#page`,
	name: 'Best AI Tools',
	url: canonical,
	description:
		'A curated directory of AISEOShift’s best AI tools guides across SEO, writing, media, business, and professional workflows.',
	isPartOf: { '@id': `${SITE_URL}/#website` },
	datePublished: pubDate.toISOString(),
	dateModified: now.toISOString(),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Best AI Tools in 2026: ${total}+ Curated Guides | ${SITE_TITLE}`}
			description="A curated hub of the best AI tools across SEO, writing, image and video, voice, business, and professional workflows. Every guide compares named tools with pricing and use cases."
			canonical={canonical}
			ogType="website"
			structuredData={[collectionPageSchema, itemListSchema, breadcrumbSchema]}
		/>
		<style>
			.hub-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-6) 0 var(--space-9); }
			.hub-crumbs { display: flex; gap: 0.4rem; font-size: 0.8rem; color: var(--ink-muted); padding: var(--space-5) 0; }
			.hub-crumbs a { color: var(--ink-muted); text-decoration: none; }
			.hub-crumbs a:hover { color: var(--signal-deep); }
			.hub-hero { padding: var(--space-5) 0 var(--space-7); border-bottom: 1px solid var(--line); }
			.hub-hero .kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); margin: 0; }
			.hub-hero h1 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 600; margin: var(--space-3) 0 0; max-width: 18ch; }
			.hub-hero p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: var(--space-4) 0 0; }
			.hub-author { display: inline-flex; align-items: center; gap: 0.7rem; margin: var(--space-5) 0 0; text-decoration: none; color: rgb(var(--ink)); }
			.hub-author img { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line-strong); }
			.hub-author-text { display: inline-flex; flex-direction: column; line-height: 1.25; font-size: 0.82rem; }
			.hub-author-name { font-weight: 700; }
			.hub-author-role { color: var(--ink-muted); font-size: 0.72rem; }
			.hub-cat { padding: var(--space-6) 0; border-bottom: 1px solid var(--line); }
			.hub-cat h2 { font-size: clamp(1.4rem, 2.4vw, 1.85rem); letter-spacing: -0.02em; font-weight: 600; margin: 0 0 var(--space-4); }
			.hub-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-4); }
			.hub-grid a { display: flex; flex-direction: column; gap: 0.35rem; height: 100%; padding: var(--space-4); border: 1px solid var(--line-strong); border-radius: 8px; background: rgb(var(--paper)); text-decoration: none; color: rgb(var(--ink)); transition: border-color 0.15s ease; }
			.hub-grid a:hover { border-color: var(--signal); }
			.hub-grid .t { font-family: 'Iowan Old Style', Georgia, serif; font-size: 1.02rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; }
			.hub-grid .d { font-size: 0.85rem; line-height: 1.5; color: rgba(var(--ink), 0.72); }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="hub-page">
			<nav class="hub-crumbs" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Best AI Tools</span>
			</nav>

			<section class="hub-hero">
				<p class="kicker">AISEOShift · Tool Guides</p>
				<h1>Best AI tools, curated and compared.</h1>
				<p>
					{total}+ in-depth guides to the best AI tools across SEO, writing, image
					and video, voice, business workflows, and specific professions. Each guide
					compares named tools with pricing and the use case each one fits.
				</p>
				<a class="hub-author" href={AUTHOR_PROFILE_URL} rel="author">
					<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="38" height="38" />
					<span class="hub-author-text">
						<span class="hub-author-name">By {AUTHOR_NAME}</span>
						<span class="hub-author-role">{AUTHOR_ROLE}</span>
					</span>
				</a>
			</section>

			{rendered.map((g) => (
				<section class="hub-cat">
					<h2>{g.category}</h2>
					<ul class="hub-grid">
						{g.items.map((it) => (
							<li>
								<a href={`/blog/${it.slug}/`}>
									<span class="t">{it.title}</span>
									<span class="d">{it.description}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
