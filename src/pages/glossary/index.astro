---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../../consts';

const canonical = new URL('/glossary/', SITE_URL).toString();
const pubDate = new Date('2026-05-26');

// In-depth term pages (content collection), each rendered as its own subpage.
const deepTerms = (await getCollection('glossary', ({ data }) => !data.draft)).sort((a, b) =>
	a.data.term.localeCompare(b.data.term)
);

const catId = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Group terms by category for the hub layout, categories sorted alphabetically.
const termsByCategory = [
	...deepTerms.reduce((map, t) => {
		const list = map.get(t.data.category) ?? [];
		list.push(t);
		map.set(t.data.category, list);
		return map;
	}, new Map<string, typeof deepTerms>()),
].sort((a, b) => a[0].localeCompare(b[0]));

const definedTermSetSchema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTermSet',
	'@id': `${canonical}#glossary`,
	name: 'SEO and Digital Marketing Glossary',
	url: canonical,
	description:
		'Definitions of the SEO and digital marketing terms every practitioner should know, from backlinks and Core Web Vitals to AEO, GEO, and AI Overviews.',
	hasDefinedTerm: deepTerms.map((t) => ({
		'@type': 'DefinedTerm',
		'@id': `${canonical}#${t.id}`,
		name: t.data.term,
		...(t.data.abbreviation ? { alternateName: t.data.abbreviation } : {}),
		description: t.data.summary,
		inDefinedTermSet: { '@id': `${canonical}#glossary` },
		url: new URL(`/glossary/${t.id}/`, SITE_URL).toString(),
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'Glossary', item: canonical },
	],
};

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': `${canonical}#article`,
	headline: 'AI SEO Glossary: AEO, GEO, AI Overviews, Schema, and More',
	description:
		'A concise glossary of the terms that matter for AI search in 2026, defined for fast extraction by both human readers and AI answer engines.',
	url: canonical,
	mainEntityOfPage: canonical,
	datePublished: pubDate.toISOString(),
	dateModified: pubDate.toISOString(),
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`SEO and Digital Marketing Glossary | ${SITE_TITLE}`}
			description="Clear definitions of the SEO and digital marketing terms every practitioner should know, from backlinks and Core Web Vitals to AEO, GEO, and AI Overviews. In-depth term guides plus quick definitions."
			canonical={canonical}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={pubDate.toISOString()}
			structuredData={[articleSchema, definedTermSetSchema, breadcrumbSchema]}
		/>
		<style>
			.glossary-page {
				width: min(1080px, calc(100% - 2rem));
				margin: 0 auto;
				padding: var(--space-7) 0 var(--space-9);
			}

			.glossary-hero {
				padding: var(--space-7) 0 var(--space-8);
				border-bottom: 1px solid var(--line);
				display: grid;
				grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
				gap: var(--space-7);
				align-items: end;
			}

			.glossary-hero .kicker {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--ink-muted);
				margin: 0;
			}

			.glossary-hero h1 {
				font-size: clamp(2.4rem, 5vw, 4.4rem);
				line-height: 0.98;
				letter-spacing: -0.032em;
				font-weight: 600;
				margin: var(--space-4) 0 0;
				max-width: 14ch;
			}

			.glossary-hero-lede p {
				font-size: 1.1rem;
				line-height: 1.6;
				color: rgba(var(--ink), 0.78);
				max-width: var(--measure);
				margin: 0;
			}

			.glossary-index {
				padding: var(--space-6) 0;
				border-bottom: 1px solid var(--line);
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem 0.55rem;
			}

			.glossary-index a {
				display: inline-flex;
				padding: 0.4rem 0.85rem;
				border-radius: 999px;
				border: 1px solid var(--line-strong);
				background: rgb(var(--paper));
				color: rgb(var(--ink));
				text-decoration: none;
				font-size: 0.82rem;
				font-weight: 600;
				line-height: 1;
			}

			.glossary-index a:hover {
				color: var(--signal-deep);
				border-color: var(--signal);
			}

			.glossary-deep {
				padding: var(--space-6) 0;
				border-bottom: 1px solid var(--line);
			}

			.glossary-deep-head h2 {
				font-size: clamp(1.5rem, 2.6vw, 2rem);
				letter-spacing: -0.02em;
				font-weight: 600;
				margin: 0;
			}

			.glossary-deep-head p {
				margin: var(--space-2) 0 var(--space-5);
				color: rgba(var(--ink), 0.72);
				font-size: 1rem;
				max-width: var(--measure);
			}

			.glossary-deep-grid {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: var(--space-4);
			}

			.glossary-deep-grid a {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				height: 100%;
				padding: var(--space-4);
				border: 1px solid var(--line-strong);
				border-radius: 8px;
				background: rgb(var(--paper));
				text-decoration: none;
				color: rgb(var(--ink));
				transition: border-color 0.15s ease;
			}

			.glossary-deep-grid a:hover {
				border-color: var(--signal);
			}

			.glossary-deep-cat {
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--signal-deep);
			}

			.glossary-deep-term {
				font-family: 'Iowan Old Style', Georgia, serif;
				font-size: 1.15rem;
				font-weight: 600;
				letter-spacing: -0.015em;
			}

			.glossary-deep-abbr {
				font-style: italic;
				font-weight: 400;
				color: var(--ink-muted);
			}

			.glossary-deep-sum {
				font-size: 0.88rem;
				line-height: 1.5;
				color: rgba(var(--ink), 0.72);
			}

			.glossary-cat {
				padding: var(--space-6) 0;
				border-bottom: 1px solid var(--line);
			}

			.glossary-cat:last-of-type {
				border-bottom: none;
			}

			.glossary-cat-head {
				font-size: 0.78rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--ink-muted);
				margin: 0 0 var(--space-4);
				scroll-margin-top: 5rem;
			}

			.glossary-list {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.glossary-list > li {
				margin: 0;
				padding: var(--space-6) 0;
				border-top: 1px solid var(--line);
				scroll-margin-top: 5rem;
			}

			.glossary-list > li:last-child {
				border-bottom: 1px solid var(--line);
			}

			.glossary-row {
				display: grid;
				grid-template-columns: minmax(0, 0.35fr) minmax(0, 0.65fr);
				gap: var(--space-6);
				align-items: baseline;
			}

			.glossary-term {
				font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
				font-size: clamp(1.4rem, 2.4vw, 1.95rem);
				font-weight: 600;
				letter-spacing: -0.022em;
				line-height: 1.15;
				margin: 0;
				color: rgb(var(--ink));
				scroll-margin-top: 5rem;
			}

			.glossary-abbr {
				display: block;
				margin-top: var(--space-2);
				font-family: 'Iowan Old Style', Georgia, serif;
				font-style: italic;
				font-weight: 400;
				font-size: 0.95rem;
				color: var(--signal-deep);
				letter-spacing: 0.02em;
			}

			.glossary-def {
				margin: 0;
				font-size: 1.02rem;
				line-height: 1.65;
				color: rgba(var(--ink), 0.85);
				max-width: 56ch;
			}

			.glossary-def a {
				font-weight: 600;
			}

			.glossary-more {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				margin-top: var(--space-3);
				font-size: 0.85rem;
				font-weight: 600;
				text-decoration: none;
				color: rgb(var(--ink));
				border-bottom: 1px solid var(--line-strong);
				padding-bottom: 2px;
			}

			.glossary-more:hover {
				color: var(--signal-deep);
				border-color: var(--signal);
			}

			.glossary-author {
				display: inline-flex;
				align-items: center;
				gap: 0.75rem;
				margin: var(--space-4) 0 0;
				text-decoration: none;
				color: rgb(var(--ink));
			}

			.glossary-author img {
				width: 40px;
				height: 40px;
				border-radius: 50%;
				border: 1px solid var(--line-strong);
			}

			.glossary-author-text {
				display: inline-flex;
				flex-direction: column;
				line-height: 1.25;
				font-size: 0.85rem;
			}

			.glossary-author-name { font-weight: 700; }
			.glossary-author-role { color: var(--ink-muted); font-size: 0.75rem; }

			@media (max-width: 860px) {
				.glossary-hero,
				.glossary-row {
					grid-template-columns: 1fr;
					gap: var(--space-3);
					align-items: start;
				}

				.glossary-hero { gap: var(--space-5); }
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="glossary-page">
			<section class="glossary-hero">
				<div>
					<p class="kicker">AISEOShift · Reference</p>
					<h1>SEO and Marketing Glossary.</h1>
				</div>
				<div class="glossary-hero-lede">
					<p>
						The terms every SEO and digital marketer should know, from classical
						fundamentals to the vocabulary of AI search. In-depth guides explain the
						core terms on their own pages, and quick definitions cover the rest,
						written to be quoted verbatim by AI answer engines.
					</p>
					<a class="glossary-author" href={AUTHOR_PROFILE_URL} rel="author">
						<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="40" height="40" />
						<span class="glossary-author-text">
							<span class="glossary-author-name">By {AUTHOR_NAME}</span>
							<span class="glossary-author-role">{AUTHOR_ROLE}</span>
						</span>
					</a>
				</div>
			</section>

			<nav class="glossary-index" aria-label="Glossary categories">
				{termsByCategory.map(([cat]) => (
					<a href={`#${catId(cat)}`}>{cat}</a>
				))}
			</nav>

			{termsByCategory.map(([cat, items]) => (
				<section class="glossary-cat" id={catId(cat)}>
					<h2 class="glossary-cat-head">{cat}</h2>
					<ul class="glossary-deep-grid">
						{items.map((t) => (
							<li>
								<a href={`/glossary/${t.id}/`}>
									<span class="glossary-deep-term">{t.data.term}{t.data.abbreviation && <span class="glossary-deep-abbr"> ({t.data.abbreviation})</span>}</span>
									<span class="glossary-deep-sum">{t.data.summary}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
