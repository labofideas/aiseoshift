---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../../consts';

const canonical = new URL('/glossary/', SITE_URL).toString();
const pubDate = new Date('2026-05-26');

type Term = {
	id: string;
	term: string;
	abbreviation?: string;
	definition: string;
	link?: string;
};

// Editorial order: alphabetical by primary term
const terms: Term[] = [
	{
		id: 'aeo',
		term: 'Answer Engine Optimization',
		abbreviation: 'AEO',
		definition:
			'The practice of structuring web content so AI answer engines like ChatGPT, Claude, and Perplexity can extract, trust, and cite it inside their generated answers. AEO sits alongside classical SEO (for ranking) and GEO (for generative search).',
		link: '/aeo/',
	},
	{
		id: 'ai-citation',
		term: 'AI Citation',
		definition:
			'A reference, link, or attribution that an AI answer engine emits when it uses your content to generate an answer. AI citations replace traditional clicks as the unit of value in AEO. Engines that cite explicitly include ChatGPT Search, Perplexity, and Claude.',
		link: '/seo/ai-citation-building/',
	},
	{
		id: 'ai-mode',
		term: 'AI Mode',
		definition:
			'Google’s conversational AI search experience launched at I/O 2025 and expanded throughout 2026. AI Mode runs multiple parallel searches, applies filters, and compresses retrieval into a synthesized answer with citations. The successor to the classical Google Search box for many query types.',
	},
	{
		id: 'ai-overviews',
		term: 'AI Overviews',
		definition:
			'Google’s AI-synthesized answer boxes that appear above classical organic results for an increasing share of queries. AI Overviews predominantly pull from pages that already rank in the top 10-20 organic results, then synthesize a summary with attributed source links.',
		link: '/seo/ai-search-optimization/',
	},
	{
		id: 'ai-seo-shift',
		term: 'AI SEO Shift',
		definition:
			'The structural move from optimizing for blue-link rankings to optimizing for AI answer citations. Coined by AISEOShift, the term describes the combined discipline of classical SEO + AEO + GEO that brands need in 2026 as AI assistants mediate a growing share of search.',
		link: '/ai-seo-shift/',
	},
	{
		id: 'e-e-a-t',
		term: 'E-E-A-T',
		definition:
			'Experience, Expertise, Authoritativeness, and Trustworthiness. Google’s framework for evaluating content quality, expanded from E-A-T in 2022 to add Experience. AI engines weight E-E-A-T signals heavily when selecting sources to cite, especially for high-trust verticals (medical, legal, financial).',
		link: '/seo/eeat/',
	},
	{
		id: 'featured-snippet',
		term: 'Featured Snippet',
		definition:
			'A direct answer extracted by Google from a ranking page and shown at the top of the results, usually as a paragraph, list, or table. Featured snippets are the classical-SEO predecessor to AI Overviews: same lifting mechanic, fewer engines doing it.',
	},
	{
		id: 'geo',
		term: 'Generative Engine Optimization',
		abbreviation: 'GEO',
		definition:
			'The practice of optimizing web content so generative AI search experiences — Google AI Overviews, Gemini, Search Generative Experience — synthesize answers from your content. Where AEO is about earning a citation, GEO is about being the substrate the generative engine builds its answer from.',
		link: '/geo/',
	},
	{
		id: 'hyperlocal-seo',
		term: 'Hyperlocal SEO',
		definition:
			'Optimization at the neighborhood and street level, not the city level. In 2026 hyperlocal SEO is the discipline of being the business an AI assistant cites when it answers a constraint-rich local query like "dentist that takes Aetna, open after 6pm, near Logan Square."',
		link: '/blog/hyperlocal-seo-2026-ai-local-discovery/',
	},
	{
		id: 'knowledge-graph',
		term: 'Knowledge Graph',
		definition:
			'Google’s structured database of entities (people, places, organizations, concepts) and their relationships. The Knowledge Graph powers the entity panels you see on Google Search and is a core input to how AI search systems verify identity and authority for citation.',
	},
	{
		id: 'llms-txt',
		term: 'llms.txt',
		definition:
			'A plain-text file at /llms.txt that lists the most important pages on a site with one-line descriptions, formatted for AI consumers. Functions as the AI-citation equivalent of robots.txt or sitemap.xml. Proposed by llmstxt.org in 2024 and adopted by Yoast, Rank Math, and a growing number of publishers.',
		link: '/llms.txt',
	},
	{
		id: 'map-pack',
		term: 'Map Pack',
		definition:
			'Google’s local-results block showing three nearby businesses with a map, also called the Local 3-Pack. Historically the dominant local-discovery surface; in 2026 increasingly compressed into AI Mode and Gemini recommendations that surface 1-3 results instead of a ranked list.',
	},
	{
		id: 'schema-markup',
		term: 'Schema Markup',
		definition:
			'Structured-data annotations (usually JSON-LD) that describe a page’s content in a machine-readable vocabulary. Common types: Organization, Person, Article, FAQPage, HowTo, LocalBusiness, DefinedTerm. AI engines preferentially cite pages with rich schema because it eliminates parsing ambiguity.',
		link: '/seo/schema-markup/',
	},
	{
		id: 'speakable',
		term: 'Speakable Schema',
		definition:
			'A schema.org type (SpeakableSpecification) that marks specific page sections as appropriate for voice or audio reading by AI assistants. Useful for TL;DR blocks and definition paragraphs — signals to Google Assistant and similar systems which content to read aloud.',
	},
	{
		id: 'topic-cluster',
		term: 'Topic Cluster',
		definition:
			'A pillar page (broad topic) interlinked with multiple supporting articles (subtopics) all covering the same entity from different angles. Topic clusters signal topical authority to both Google and AI engines, and are the canonical content architecture for AEO and GEO at scale.',
		link: '/seo/content-strategy/',
	},
	{
		id: 'zero-click',
		term: 'Zero-Click Search',
		definition:
			'A search that ends without a click to any external website because the user got the answer directly inside the search results (featured snippet, AI Overview, Knowledge Panel). Roughly 65% of Google searches were zero-click as of 2024, a number AI Overviews has continued to push higher.',
	},
];

const definedTermSetSchema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTermSet',
	'@id': `${canonical}#glossary`,
	name: 'AI SEO Glossary',
	url: canonical,
	description:
		'A concise glossary of the terms that matter for AI search in 2026: AEO, GEO, AI Overviews, schema markup, E-E-A-T, llms.txt, and more.',
	hasDefinedTerm: terms.map((t) => ({
		'@type': 'DefinedTerm',
		'@id': `${canonical}#${t.id}`,
		name: t.term,
		...(t.abbreviation ? { alternateName: t.abbreviation } : {}),
		description: t.definition,
		inDefinedTermSet: { '@id': `${canonical}#glossary` },
		...(t.link ? { url: new URL(t.link, SITE_URL).toString() } : {}),
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'Glossary', item: canonical },
	],
};

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': `${canonical}#article`,
	headline: 'AI SEO Glossary: AEO, GEO, AI Overviews, Schema, and More',
	description:
		'A concise glossary of the terms that matter for AI search in 2026, defined for fast extraction by both human readers and AI answer engines.',
	url: canonical,
	mainEntityOfPage: canonical,
	datePublished: pubDate.toISOString(),
	dateModified: pubDate.toISOString(),
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO Glossary: AEO, GEO, AI Overviews and More | ${SITE_TITLE}`}
			description="Concise definitions of the 16 terms that matter for AI search in 2026 — AEO, GEO, AI Overviews, schema, E-E-A-T, llms.txt, and more. Built for fast extraction by AI answer engines."
			canonical={canonical}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={pubDate.toISOString()}
			structuredData={[articleSchema, definedTermSetSchema, breadcrumbSchema]}
		/>
		<style>
			.glossary-page {
				width: min(1080px, calc(100% - 2rem));
				margin: 0 auto;
				padding: var(--space-7) 0 var(--space-9);
			}

			.glossary-hero {
				padding: var(--space-7) 0 var(--space-8);
				border-bottom: 1px solid var(--line);
				display: grid;
				grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
				gap: var(--space-7);
				align-items: end;
			}

			.glossary-hero .kicker {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--ink-muted);
				margin: 0;
			}

			.glossary-hero h1 {
				font-size: clamp(2.4rem, 5vw, 4.4rem);
				line-height: 0.98;
				letter-spacing: -0.032em;
				font-weight: 600;
				margin: var(--space-4) 0 0;
				max-width: 14ch;
			}

			.glossary-hero-lede p {
				font-size: 1.1rem;
				line-height: 1.6;
				color: rgba(var(--ink), 0.78);
				max-width: var(--measure);
				margin: 0;
			}

			.glossary-index {
				padding: var(--space-6) 0;
				border-bottom: 1px solid var(--line);
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem 0.55rem;
			}

			.glossary-index a {
				display: inline-flex;
				padding: 0.4rem 0.85rem;
				border-radius: 999px;
				border: 1px solid var(--line-strong);
				background: rgb(var(--paper));
				color: rgb(var(--ink));
				text-decoration: none;
				font-size: 0.82rem;
				font-weight: 600;
				line-height: 1;
			}

			.glossary-index a:hover {
				color: var(--signal-deep);
				border-color: var(--signal);
			}

			.glossary-list {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.glossary-list > li {
				margin: 0;
				padding: var(--space-6) 0;
				border-top: 1px solid var(--line);
				scroll-margin-top: 5rem;
			}

			.glossary-list > li:last-child {
				border-bottom: 1px solid var(--line);
			}

			.glossary-row {
				display: grid;
				grid-template-columns: minmax(0, 0.35fr) minmax(0, 0.65fr);
				gap: var(--space-6);
				align-items: baseline;
			}

			.glossary-term {
				font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
				font-size: clamp(1.4rem, 2.4vw, 1.95rem);
				font-weight: 600;
				letter-spacing: -0.022em;
				line-height: 1.15;
				margin: 0;
				color: rgb(var(--ink));
				scroll-margin-top: 5rem;
			}

			.glossary-abbr {
				display: block;
				margin-top: var(--space-2);
				font-family: 'Iowan Old Style', Georgia, serif;
				font-style: italic;
				font-weight: 400;
				font-size: 0.95rem;
				color: var(--signal-deep);
				letter-spacing: 0.02em;
			}

			.glossary-def {
				margin: 0;
				font-size: 1.02rem;
				line-height: 1.65;
				color: rgba(var(--ink), 0.85);
				max-width: 56ch;
			}

			.glossary-def a {
				font-weight: 600;
			}

			.glossary-more {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				margin-top: var(--space-3);
				font-size: 0.85rem;
				font-weight: 600;
				text-decoration: none;
				color: rgb(var(--ink));
				border-bottom: 1px solid var(--line-strong);
				padding-bottom: 2px;
			}

			.glossary-more:hover {
				color: var(--signal-deep);
				border-color: var(--signal);
			}

			.glossary-author {
				display: inline-flex;
				align-items: center;
				gap: 0.75rem;
				margin: var(--space-4) 0 0;
				text-decoration: none;
				color: rgb(var(--ink));
			}

			.glossary-author img {
				width: 40px;
				height: 40px;
				border-radius: 50%;
				border: 1px solid var(--line-strong);
			}

			.glossary-author-text {
				display: inline-flex;
				flex-direction: column;
				line-height: 1.25;
				font-size: 0.85rem;
			}

			.glossary-author-name { font-weight: 700; }
			.glossary-author-role { color: var(--ink-muted); font-size: 0.75rem; }

			@media (max-width: 860px) {
				.glossary-hero,
				.glossary-row {
					grid-template-columns: 1fr;
					gap: var(--space-3);
					align-items: start;
				}

				.glossary-hero { gap: var(--space-5); }
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="glossary-page">
			<section class="glossary-hero">
				<div>
					<p class="kicker">AISEOShift · Reference</p>
					<h1>AI SEO Glossary.</h1>
				</div>
				<div class="glossary-hero-lede">
					<p>
						Concise definitions of the 16 terms that matter most for AI search in 2026.
						Each entry is short on purpose — built to be quoted verbatim by AI answer engines
						and to give human readers a fast mental model.
					</p>
					<a class="glossary-author" href={AUTHOR_PROFILE_URL} rel="author">
						<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="40" height="40" />
						<span class="glossary-author-text">
							<span class="glossary-author-name">By {AUTHOR_NAME}</span>
							<span class="glossary-author-role">{AUTHOR_ROLE}</span>
						</span>
					</a>
				</div>
			</section>

			<nav class="glossary-index" aria-label="Glossary index">
				{terms.map((t) => (
					<a href={`#${t.id}`}>{t.abbreviation ?? t.term}</a>
				))}
			</nav>

			<ol class="glossary-list">
				{terms.map((t) => (
					<li id={t.id}>
						<div class="glossary-row">
							<div>
								<h2 class="glossary-term">{t.term}</h2>
								{t.abbreviation && <span class="glossary-abbr">{t.abbreviation}</span>}
							</div>
							<div>
								<p class="glossary-def">{t.definition}</p>
								{t.link && (
									<a class="glossary-more" href={t.link}>Read the full coverage &rarr;</a>
								)}
							</div>
						</div>
					</li>
				))}
			</ol>
		</main>
		<Footer />
	</body>
</html>
