---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../../consts';

const canonical = new URL('/perplexity-seo/', SITE_URL).toString();
const pubDate = new Date('2026-05-26');

const definedTermSchema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTerm',
	'@id': `${canonical}#defined`,
	name: 'Perplexity SEO',
	description:
		'Perplexity SEO is the practice of optimizing web content so Perplexity cites it inside generated answers. Perplexity runs its own retrieval stack with PerplexityBot for crawling and Perplexity-User for per-query page fetches, and shows numbered footnote citations more prominently than any other major AI engine.',
	inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'AI SEO Glossary', url: `${SITE_URL}/glossary/` },
};

const faqs = [
	{
		q: 'What is Perplexity SEO?',
		a: 'Perplexity SEO is the practice of optimizing content so Perplexity cites it inside answers. Perplexity is the most citation-heavy of the major AI engines, showing 5-15 numbered footnotes per answer. Being one of those citations is the optimization target.',
	},
	{
		q: 'How does Perplexity retrieve content?',
		a: 'Perplexity uses its own retrieval stack: PerplexityBot crawls the web continuously and builds the long-term index, while Perplexity-User fetches pages live in response to user queries. Perplexity also pulls from third-party APIs (Reddit, Wikipedia, news) for high-recency results.',
	},
	{
		q: 'Which Perplexity bots should I allow in robots.txt?',
		a: 'Both PerplexityBot (index crawler) and Perplexity-User (per-query live fetcher). If either is blocked, your content will be invisible to Perplexity for the corresponding retrieval mode. Explicit Allow rules above the wildcard are the safest pattern.',
	},
	{
		q: 'What kind of content does Perplexity cite most?',
		a: 'Recent (within 30-90 days), specific, well-structured pages with clear authorship. Perplexity weights freshness heavily; old pages without an updated date often lose to newer competitors. Pages with FAQ schema, named human bylines, and inline statistics cited from primary sources do best.',
	},
	{
		q: 'Is Reddit important for Perplexity SEO?',
		a: 'Yes. Perplexity disproportionately pulls from Reddit threads, and an analysis cited across SEO publications in 2025 found roughly 5% of all Perplexity citations come from Reddit. Real subreddit presence and discussion of your brand and product can directly drive Perplexity citations.',
	},
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': `${canonical}#article`,
	headline: 'Perplexity SEO: How to Get Cited by Perplexity',
	description: 'Complete guide to Perplexity SEO in 2026: how Perplexity retrieves content, which bots to allow, what gets cited, and the optimization playbook.',
	url: canonical,
	mainEntityOfPage: canonical,
	datePublished: pubDate.toISOString(),
	dateModified: pubDate.toISOString(),
	inLanguage: 'en-US',
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
	about: { '@id': `${canonical}#defined` },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${canonical}#faq`,
	isPartOf: { '@id': `${canonical}#article` },
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'Perplexity SEO', item: canonical },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Perplexity SEO: How to Get Cited by Perplexity (2026) | ${SITE_TITLE}`}
			description="Perplexity SEO is how you get cited by Perplexity AI. Full guide: PerplexityBot retrieval, robots.txt rules, freshness weighting, Reddit signal, and the 2026 playbook."
			canonical={canonical}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={pubDate.toISOString()}
			structuredData={[articleSchema, definedTermSchema, faqSchema, breadcrumbSchema]}
		/>
		<style>
			.engine-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }
			.engine-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.engine-hero .kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); margin: 0; }
			.engine-hero h1 { font-size: clamp(2.4rem, 5vw, 4.4rem); line-height: 0.98; letter-spacing: -0.032em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 14ch; }
			.engine-hero h1 em { font-style: italic; font-weight: 400; color: var(--signal-deep); }
			.engine-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0 0 var(--space-4); }
			.engine-svg { margin: var(--space-7) 0 0; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); overflow: hidden; }
			.engine-svg svg { display: block; width: 100%; height: auto; }
			.engine-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.engine-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 22ch; }
			.engine-section p { font-size: 1.05rem; line-height: 1.7; color: rgba(var(--ink), 0.85); margin: 0 0 var(--space-4); max-width: var(--measure); }
			.engine-callout { margin: var(--space-6) 0; padding: var(--space-5) var(--space-6); background: rgb(var(--paper-strong)); border: 1px solid var(--line); border-left: 3px solid var(--signal); border-radius: var(--radius-md); }
			.engine-callout p { margin: 0; font-size: 1rem; line-height: 1.65; }
			.engine-callout strong { font-weight: 700; }
			.chapters-strip { margin: var(--space-5) 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; padding: 0; list-style: none; }
			.chapters-strip li { margin: 0; }
			.chapters-strip a { display: inline-flex; padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid var(--line-strong); background: rgb(var(--paper)); color: rgb(var(--ink)); text-decoration: none; font-size: 0.82rem; font-weight: 600; line-height: 1; }
			.chapters-strip a:hover { color: var(--signal-deep); border-color: var(--signal); }
			.faq-shell { border-top: 1px solid var(--line-strong); margin-top: var(--space-4); }
			.faq-item { border-bottom: 1px solid var(--line); padding: var(--space-5) 0; }
			.faq-item summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; font-size: 1.15rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.012em; color: rgb(var(--ink)); }
			.faq-item summary::-webkit-details-marker { display: none; }
			.faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--signal-deep); }
			.faq-item[open] summary::after { content: '−'; }
			.faq-answer { margin: var(--space-3) 0 0; font-size: 1rem; line-height: 1.7; color: rgba(var(--ink), 0.85); max-width: 60ch; }
			.engine-author { display: inline-flex; align-items: center; gap: 0.75rem; margin: var(--space-4) 0 0; text-decoration: none; color: rgb(var(--ink)); }
			.engine-author img { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); }
			.engine-author-text { display: inline-flex; flex-direction: column; line-height: 1.25; font-size: 0.85rem; }
			.engine-author-name { font-weight: 700; }
			.engine-author-role { color: var(--ink-muted); font-size: 0.75rem; }
			@media (max-width: 860px) { .engine-hero { grid-template-columns: 1fr; gap: var(--space-5); } }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="engine-page">
			<section class="engine-hero">
				<div>
					<p class="kicker">AISEOShift · Engine Hub</p>
					<h1>Perplexity SEO. Win the <em>footnotes.</em></h1>
				</div>
				<div class="engine-hero-lede">
					<p>
						Perplexity is the most citation-heavy AI engine. Every answer shows 5 to 15
						numbered source footnotes. Perplexity SEO is the discipline of being one of those numbers,
						using its own retrieval stack (PerplexityBot + Perplexity-User) and its strong freshness bias.
					</p>
					<a class="engine-author" href={AUTHOR_PROFILE_URL} rel="author">
						<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="40" height="40" />
						<span class="engine-author-text">
							<span class="engine-author-name">By {AUTHOR_NAME}</span>
							<span class="engine-author-role">{AUTHOR_ROLE}</span>
						</span>
					</a>
				</div>
			</section>

			<div class="engine-svg" aria-hidden="true">
				<svg viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
					<rect width="800" height="220" fill="rgb(246,245,240)" />
					<g font-family="system-ui, sans-serif" font-size="10" letter-spacing="2.4" fill="rgb(14,17,22)" fill-opacity="0.6">
						<text x="60" y="36">USER QUERY</text>
						<text x="320" y="36">PERPLEXITY</text>
						<text x="600" y="36">FOOTNOTED ANSWER</text>
					</g>
					<g transform="translate(40 60)">
						<rect width="200" height="80" rx="3" fill="none" stroke="rgb(14,17,22)" stroke-opacity="0.45" />
						<text x="20" y="34" font-family="Figtree, system-ui, sans-serif" font-style="italic" font-size="13" fill="rgb(14,17,22)">"latest research on</text>
						<text x="20" y="54" font-family="Figtree, system-ui, sans-serif" font-style="italic" font-size="13" fill="rgb(14,17,22)">AI search citations"</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 250 100 C 280 100, 290 100, 320 100" />
						<polyline points="310,94 320,100 310,106" />
					</g>
					<g transform="translate(320 60)">
						<rect width="220" height="80" rx="3" fill="rgb(14,17,22)" />
						<text x="110" y="34" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="rgb(250,250,247)">PERPLEXITYBOT</text>
						<text x="110" y="56" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="rgb(250,250,247)">PERPLEXITY-USER · REDDIT</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 550 100 C 580 100, 590 100, 620 100" />
						<polyline points="610,94 620,100 610,106" />
					</g>
					<g transform="translate(620 60)" font-family="Figtree, system-ui, sans-serif" font-style="italic" font-size="11" fill="rgb(184,85,46)">
						<text x="0" y="14">[1] aiseoshift.com</text>
						<text x="0" y="32">[2] reddit.com/r/seo</text>
						<text x="0" y="50">[3] searchengineland.com</text>
						<text x="0" y="68">[4] ...</text>
					</g>
					<text x="400" y="190" text-anchor="middle" font-family="Figtree, system-ui, sans-serif" font-style="italic" font-size="13" fill="rgb(14,17,22)" fill-opacity="0.7">Numbered citations are the unit of value. Perplexity shows 5 to 15 per answer.</text>
				</svg>
			</div>

			<section class="engine-section">
				<h2>Definition: what Perplexity SEO means</h2>
				<p>
					<strong>Perplexity SEO</strong> is the practice of optimizing web content so it appears as a numbered footnote citation inside Perplexity-generated answers. Perplexity is the most citation-heavy major AI engine: every answer shows 5 to 15 numbered sources, more than ChatGPT or Claude typically display, with each citation a clickable link to the underlying page.
				</p>
				<p>
					Perplexity runs its own retrieval stack rather than relying on Bing or Google. PerplexityBot crawls the web for the long-term index. Perplexity-User fetches specific pages live when a user query needs current information. Perplexity also pulls heavily from Reddit, Wikipedia, and news APIs for high-recency answers.
				</p>
				<div class="engine-callout">
					<p><strong>The shortest version.</strong> Be fresh, be specific, be cited. Perplexity rewards recently-updated pages with named authors that cite their own primary sources.</p>
				</div>
			</section>

			<section class="engine-section">
				<h2>How Perplexity selects citations</h2>
				<p>The selection mechanic:</p>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Decompose the query.</strong> Perplexity often splits a question into sub-questions and runs separate retrievals for each.</li>
					<li><strong>Retrieve from many surfaces.</strong> Web (PerplexityBot index), live fetch (Perplexity-User), Reddit, Wikipedia, news APIs, and academic sources for some queries.</li>
					<li><strong>Score for recency and specificity.</strong> Perplexity heavily weights freshness. A page updated last month outranks the same page updated three years ago.</li>
					<li><strong>Apply E-E-A-T filtering.</strong> Named authors, Person schema, and citations-to-citations all increase the trust score.</li>
					<li><strong>Generate with footnotes.</strong> Synthesize the answer and emit 5-15 numbered citations, each linked to the source page.</li>
				</ol>
			</section>

			<section class="engine-section">
				<h2>The 2026 Perplexity SEO playbook</h2>
				<ol style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Update your highest-traffic pages quarterly.</strong> Perplexity weights freshness more than any other engine. A visible <em>Updated</em> date and refreshed content moves you up.</li>
					<li><strong>Allow PerplexityBot AND Perplexity-User.</strong> Both. Blocking either makes you invisible to one retrieval mode.</li>
					<li><strong>Cite your own primary sources inline.</strong> Perplexity favors pages that themselves cite — it is the citation pattern Perplexity uses, so reciprocity matters.</li>
					<li><strong>Engage in relevant subreddits.</strong> Roughly 5% of Perplexity citations come from Reddit. Genuine participation in your niche subreddits drives Perplexity citations.</li>
					<li><strong>Add FAQPage schema and DefinedTerm where appropriate.</strong> Structured Q&A and definitions are disproportionately quoted. See our <a href="/seo/schema-markup/">schema chapter</a> and <a href="/glossary/">glossary</a> for examples.</li>
				</ol>
			</section>

			<section class="engine-section">
				<h2>How Perplexity differs from ChatGPT and Gemini</h2>
				<p>Three structural differences make Perplexity SEO its own distinct discipline:</p>
				<ul style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Volume of citations:</strong> Perplexity shows 5 to 15 numbered footnotes per answer. ChatGPT shows 3 to 8. Claude shows 2 to 5. More citation slots mean more opportunities to appear per query, and Perplexity&rsquo;s explicit numbered format makes each source link more visible to users.</li>
					<li><strong>Freshness weighting:</strong> Perplexity weights recency more aggressively than any other major AI engine. A page updated within the last 90 days frequently outranks a years-old page with more backlinks on the same topic. Visible updated dates and quarterly content refreshes are the highest-leverage Perplexity-specific tactic.</li>
					<li><strong>Reddit and community signal:</strong> Perplexity pulls disproportionately from Reddit threads. Roughly 5% of all Perplexity citations come from Reddit, a share no other AI engine approaches. Genuine subreddit presence in your niche directly drives Perplexity citation opportunities.</li>
					<li><strong>Academic mode:</strong> Perplexity Pro includes an Academic search mode pulling from Semantic Scholar and peer-reviewed papers. For research-adjacent topics, citing published studies within your content increases citation probability in this mode significantly.</li>
					<li><strong>Own retrieval stack:</strong> Unlike ChatGPT (which relies heavily on Bing), Perplexity runs PerplexityBot for its long-term index and Perplexity-User for live per-query fetches. Both must be allowed.</li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>What Perplexity cites: the content signals that matter</h2>
				<ul style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Recently updated pages with a visible date.</strong> Perplexity&rsquo;s freshness filter is the single biggest differentiator. Pages with a clear &ldquo;Updated: [recent date]&rdquo; signal outperform static pages consistently.</li>
					<li><strong>Specific over general.</strong> A page answering one narrow question precisely beats a broad guide that touches on the topic loosely. Perplexity&rsquo;s sub-query decomposition means it looks for specific answers to specific sub-questions.</li>
					<li><strong>Pages that cite primary sources inline.</strong> Perplexity follows the same citation-heavy pattern in its own answers. Pages with inline data citations from original studies and reports mirror this pattern and score higher.</li>
					<li><strong>Named human authors with credentials.</strong> Bylines with a role and organization, backed by Person schema and a sameAs link, consistently appear in Perplexity citations at higher rates than anonymous content.</li>
					<li><strong>Reddit threads with genuine discussion.</strong> Not brand-controlled subreddits or obvious marketing, but real community discussion mentioning your product, topic, or methodology. Perplexity surfaces these prominently.</li>
				</ul>
				<div class="engine-callout">
					<p><strong>Freshness test.</strong> Check when your five most important pages were last meaningfully updated. If any are more than 90 days old, refresh the intro, update any statistics, and change the modified date. Perplexity will re-evaluate them within days.</p>
				</div>
			</section>

			<section class="engine-section">
				<h2>How to track your Perplexity citation presence</h2>
				<p>Perplexity has no publisher dashboard equivalent to Google Search Console. Current tracking approaches:</p>
				<ul style="font-size: 1.05rem; line-height: 1.7; padding-left: 1.5rem; max-width: var(--measure);">
					<li><strong>Manual query sampling:</strong> Run your 20 most important target queries in Perplexity weekly. Note which footnotes appear, which competitors are cited, and what content format those cited pages use.</li>
					<li><strong>Referral traffic from perplexity.ai:</strong> Perplexity drives real click-through when it cites a source by numbered footnote. Monitor perplexity.ai as a referral source in your analytics platform.</li>
					<li><strong>Brand mention monitoring:</strong> Tools like Mention, Brand24, or Ahrefs Alerts can detect when your brand appears in publicly indexed Perplexity answer pages.</li>
					<li><strong>Dedicated AI visibility platforms:</strong> Profound, Otterly, and Peec now track Perplexity citations alongside ChatGPT and Gemini monitoring at scale.</li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>From our blog: Perplexity SEO in depth</h2>
				<ul class="chapters-strip">
					<li><a href="/blog/how-to-get-cited-by-ai-search-systems/">How to get cited by AI search systems</a></li>
					<li><a href="/blog/what-is-answer-engine-optimization/">What is answer engine optimization?</a></li>
					<li><a href="/blog/best-google-indexing-tools/">Best indexing tools (includes IndexNow)</a></li>
					<li><a href="/blog/ai-citation-rate-research-2026/">AI citation rate research</a></li>
					<li><a href="/blog/what-is-parasite-seo/">Parasite SEO: Reddit, LinkedIn, YouTube</a></li>
					<li><a href="/blog/web2-sites-for-ai-seo/">Web 2.0 sites for AI SEO citations</a></li>
				</ul>
			</section>

			<section class="engine-section">
				<h2>Related entity hubs and chapters</h2>
				<ul class="chapters-strip">
					<li><a href="/aeo/">AEO entity hub</a></li>
					<li><a href="/geo/">GEO entity hub</a></li>
					<li><a href="/chatgpt-seo/">ChatGPT SEO</a></li>
					<li><a href="/claude-seo/">Claude SEO</a></li>
					<li><a href="/gemini-seo/">Gemini SEO</a></li>
					<li><a href="/seo/ai-citation-building/">AI Citation Building</a></li>
					<li><a href="/seo/schema-markup/">Schema Markup</a></li>
					<li><a href="/seo/eeat/">E-E-A-T</a></li>
					<li><a href="/glossary/">AI SEO Glossary</a></li>
				</ul>
			</section>

			<section class="engine-section" id="faq">
				<h2>Frequently asked questions</h2>
				<div class="faq-shell">
					{faqs.map((f, i) => (
						<details class="faq-item" open={i === 0}>
							<summary>{f.q}</summary>
							<p class="faq-answer">{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
