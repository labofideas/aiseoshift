---
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import imageManifest from '../data/image-manifest.json';
import { SITE_URL } from '../consts';
import { sortPostsByDate } from '../utils/blog';

const guide = await getEntry('blog', 'ai-seo-shift');
if (!guide) throw new Error('Missing required guide: ai-seo-shift');

const posts = sortPostsByDate(await getCollection('blog', ({ data }) => !data.draft));
const latestPosts = posts.filter((post) => post.id !== guide.id).slice(0, 6);
const featuredTopics = [
	{ href: '/blog/what-is-answer-engine-optimization/', label: 'What is Answer Engine Optimization?', kicker: 'AEO' },
	{ href: '/blog/geo-vs-aeo-vs-seo/', label: 'GEO vs AEO vs SEO: What Actually Changed?', kicker: 'Framework' },
	{ href: '/blog/how-to-measure-ai-visibility/', label: 'How to Measure AI Visibility', kicker: 'Measurement' },
];
const commercialLinks = [
	{
		href: '/ai-seo-services/',
		kicker: 'AI SEO Services',
		title: 'Get help with AI SEO strategy, audits, and ongoing growth',
		copy: 'For businesses that need stronger visibility in Google, AI Overviews, ChatGPT, Perplexity, and other AI search surfaces.',
	},
	{
		href: '/ai-seo-tools/',
		kicker: 'AI SEO Tools',
		title: 'Use free AI SEO tools to review pages, metadata, and structure',
		copy: 'Browser-based tools to check on-page SEO, content structure, heading hierarchy, keyword usage, and image optimization.',
	},
];
const homepageSections = [
	{
		title: 'What the AI SEO Shift means',
		body: 'The AI SEO Shift is the move from chasing rankings alone to building visibility inside AI-generated answers, citations, and recommendation systems. SEO still matters, but it now works alongside answer engine optimization and generative engine optimization.',
	},
	{
		title: 'Why this matters now',
		body: 'Users increasingly discover brands through Google AI Overviews, ChatGPT, Claude, and Perplexity before they ever click a website. That means authority, structure, attribution, and topical depth now shape how your brand appears in search.',
	},
	{
		title: 'How to adapt',
		body: 'Winning this shift requires strong technical SEO, direct answer-first content, clear entity signals, and supporting topic clusters that help AI systems understand what your site covers and why it should be trusted.',
	},
];
const guideImage = imageManifest[guide.id as keyof typeof imageManifest]?.hero;

const faqs = [
	{
		q: 'What is the AI SEO Shift?',
		a: 'The AI SEO Shift is the move from optimizing for blue-link rankings to optimizing for AI answer citations. It combines classical SEO (Google rankings) with AEO (Answer Engine Optimization) for ChatGPT, Claude, and Perplexity, and GEO (Generative Engine Optimization) for Google AI Overviews. Brands that adapt get cited inside AI answers; brands that do not lose visibility as users stop clicking through to websites.',
	},
	{
		q: "What's the difference between SEO, AEO, and GEO?",
		a: 'SEO optimizes content to rank in Google’s organic results. AEO (Answer Engine Optimization) optimizes content to be cited inside answers from ChatGPT, Claude, and Perplexity. GEO (Generative Engine Optimization) optimizes content to appear in Google AI Overviews and Gemini. All three are needed in 2026: they share fundamentals like structured content and E-E-A-T, but differ in format, citation mechanics, and measurement.',
	},
	{
		q: 'How do I get cited by ChatGPT, Claude, and Perplexity?',
		a: 'AI engines cite content that is structured, authoritative, and unambiguous. Five high-leverage moves: (1) add direct one-paragraph answers under every H2; (2) implement FAQ, HowTo, and Organization schema; (3) include cited statistics and named entities; (4) maintain consistent author bylines and E-E-A-T signals; (5) ensure your robots.txt and llms.txt explicitly allow assistant crawlers.',
	},
	{
		q: 'Does ChatGPT use Google?',
		a: 'ChatGPT does not use Google. ChatGPT Search uses Microsoft Bing and OpenAI’s own crawler (OAI-SearchBot) to retrieve sources. Perplexity uses its own crawler (PerplexityBot) plus partnerships. Google AI Overviews uses Google’s own index. Optimizing for one does not automatically optimize for the others: each has its own crawler, ranking signals, and citation behavior.',
	},
	{
		q: 'Is SEO dead in 2026?',
		a: 'SEO is not dead: it has expanded. Classical Google rankings still drive significant traffic, but they now compete with AI Overviews, ChatGPT Search, and direct AI assistant answers. The discipline has grown from "rank in Google" to "be discoverable, retrievable, and citable across every surface where your audience searches." Brands abandoning SEO are losing ground; brands extending SEO into AEO and GEO are gaining.',
	},
	{
		q: 'How do I optimize for Google AI Overviews?',
		a: 'AI Overviews extract concise, factual answers from pages that already rank well in classical Google. To be the source: (1) put a direct 1-3 sentence answer immediately under the H1 or relevant H2; (2) use clear, scannable structure (lists, tables, definitions); (3) implement FAQPage and HowTo schema; (4) build topical authority through clusters rather than isolated posts; (5) cite primary sources to demonstrate the trust signals AI Overviews look for.',
	},
];

const homepageStructuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${SITE_URL}/#webpage`,
		name: 'AI SEO Shift',
		url: SITE_URL,
		description: guide.data.description,
		isPartOf: { '@id': `${SITE_URL}/#website` },
		about: ['AI SEO', 'Answer Engine Optimization', 'Generative Engine Optimization', 'AI visibility'],
		primaryImageOfPage: { '@id': `${SITE_URL}/#logo` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': `${SITE_URL}/#faq`,
		isPartOf: { '@id': `${SITE_URL}/#webpage` },
		mainEntity: faqs.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.a,
			},
		})),
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO Shift | AISEOShift`}
			description="AI SEO Shift explained: how AI visibility, AEO, GEO, citations, and answer engine search are changing SEO, and what to do next."
			structuredData={homepageStructuredData}
			preloadHero={guideImage?.src}
		/>
		<style>
			.home-shell {
				width: min(1180px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 1.4rem 0 4rem;
			}

			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
				gap: 1.5rem;
				align-items: stretch;
				margin: 1rem 0 1.5rem;
			}

			.hero-panel,
			.hero-visual,
			.topic-card,
			.post-card,
			.summary-shell,
			.guide-shell {
				border: 1px solid var(--line);
				border-radius: 26px;
				background: rgba(var(--paper-strong), 0.7);
				box-shadow: var(--shadow-soft);
			}

			.hero-panel {
				padding: 1.6rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--signal-deep);
			}

			.hero-panel h1 {
				font-size: clamp(2.4rem, 5vw, 4.8rem);
				line-height: 0.94;
				letter-spacing: -0.05em;
				margin-bottom: 1rem;
			}

			.hero-panel p {
				max-width: 40rem;
				font-size: 1rem;
				line-height: 1.72;
				color: rgba(var(--ink), 0.84);
			}

			.hero-actions,
			.hero-metrics,
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
			}

			.hero-actions {
				margin-top: 1.4rem;
			}

			.hero-actions a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.88rem 1.2rem;
				border-radius: 999px;
				text-decoration: none;
				font-size: 0.76rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
			}

			.hero-actions .primary-action {
				background: var(--signal-deep);
				color: #fff4ee;
			}

			.hero-actions .secondary-action {
				border: 1px solid rgba(var(--ink), 0.14);
				color: rgb(var(--ink));
			}

			.hero-metrics {
				margin-top: 1.5rem;
			}

			.metric {
				flex: 1 1 180px;
				padding: 0.9rem 1rem;
				border-radius: 18px;
				background: rgba(var(--paper), 0.8);
				border: 1px solid rgba(var(--ink), 0.08);
			}

			.metric strong {
				display: block;
				font-size: 1.35rem;
				letter-spacing: -0.03em;
				margin-bottom: 0.2rem;
			}

			.metric span {
				display: block;
				font-size: 0.82rem;
				line-height: 1.45;
				color: rgba(var(--ink), 0.74);
			}

			.hero-visual {
				padding: 1rem;
				display: grid;
				gap: 1rem;
			}

			.hero-visual img {
				width: 100%;
				aspect-ratio: 16 / 10;
				object-fit: cover;
				border-radius: 18px;
			}

			.hero-caption {
				font-size: 0.88rem;
				line-height: 1.55;
				color: rgba(var(--ink), 0.72);
			}

			.section-head {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin: 2.5rem 0 1rem;
			}

			.section-head h2 {
				margin: 0;
				font-size: clamp(1.5rem, 2vw, 2rem);
				letter-spacing: -0.03em;
			}

			.section-head p,
			.section-head a {
				margin: 0;
				font-size: 0.9rem;
				color: rgba(var(--ink), 0.72);
			}

			.section-head a {
				font-weight: 700;
				text-decoration: none;
				color: var(--signal-deep);
			}

			.topic-grid,
			.posts-grid,
			.summary-grid {
				display: grid;
				gap: 1rem;
			}

			.topic-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}

			.topic-card {
				padding: 1.2rem;
				text-decoration: none;
				color: inherit;
			}

			.topic-card:hover,
			.post-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 14px 34px rgba(var(--ink), 0.08);
			}

			.topic-card span {
				display: block;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--signal-deep);
				margin-bottom: 0.5rem;
			}

			.topic-card strong {
				display: block;
				font-size: 1.15rem;
				line-height: 1.2;
			}

			.topic-card p {
				margin: 0.7rem 0 0;
				font-size: 0.9rem;
				line-height: 1.58;
				color: rgba(var(--ink), 0.76);
			}

			.summary-shell {
				padding: 1.35rem;
			}

			.summary-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}

			.summary-card {
				padding: 1rem 0.2rem;
				border-top: 1px solid rgba(var(--ink), 0.08);
			}

			.summary-card:first-child {
				border-top: none;
				padding-top: 0;
			}

			.summary-card h3 {
				font-size: 1.15rem;
				line-height: 1.2;
				margin-bottom: 0.6rem;
			}

			.summary-card p {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.68;
				color: rgba(var(--ink), 0.78);
			}

			.summary-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.85rem;
				margin-top: 1.4rem;
				padding-top: 1rem;
				border-top: 1px solid rgba(var(--ink), 0.08);
			}

			.summary-actions a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.82rem 1.15rem;
				border-radius: 999px;
				text-decoration: none;
				font-size: 0.76rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
			}

			.summary-actions .primary-action {
				background: var(--signal-deep);
				color: #fff4ee;
			}

			.summary-actions .secondary-action {
				border: 1px solid rgba(var(--ink), 0.14);
				color: rgb(var(--ink));
			}

			.guide-shell {
				padding: 1.4rem;
				margin-top: 1.1rem;
			}

			.guide-meta {
				padding: 1.15rem;
				border-radius: 20px;
				background: rgba(var(--paper), 0.9);
				border: 1px solid rgba(var(--ink), 0.08);
			}

			.guide-meta h3 {
				font-size: 1rem;
				margin-bottom: 0.8rem;
			}

			.guide-meta p,
			.guide-meta li {
				font-size: 0.9rem;
				line-height: 1.6;
				color: rgba(var(--ink), 0.78);
			}

			.guide-meta ul {
				margin: 0.85rem 0 0;
			}

			.posts-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}

			.post-card {
				overflow: hidden;
				text-decoration: none;
				color: inherit;
			}

			.post-card img {
				width: 100%;
				aspect-ratio: 16 / 10;
				object-fit: cover;
				border-radius: 0;
			}

			.post-copy {
				padding: 1.1rem 1.15rem 1.2rem;
			}

			.post-kicker {
				display: block;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--signal-deep);
				margin-bottom: 0.55rem;
			}

			.post-card h3 {
				font-size: 1.2rem;
				line-height: 1.2;
				margin-bottom: 0.65rem;
			}

			.post-card p {
				margin: 0 0 0.9rem;
				font-size: 0.92rem;
				line-height: 1.62;
				color: rgba(var(--ink), 0.78);
			}

			.post-meta {
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgba(var(--ink), 0.56);
			}

			.faq-shell {
				border: 1px solid var(--line);
				border-radius: 26px;
				background: rgba(var(--paper-strong), 0.7);
				box-shadow: var(--shadow-soft);
				padding: 1.4rem;
			}

			.faq-item {
				border-top: 1px solid rgba(var(--ink), 0.08);
				padding: 1.05rem 0;
			}

			.faq-item:first-child {
				border-top: none;
				padding-top: 0;
			}

			.faq-item:last-child {
				padding-bottom: 0;
			}

			.faq-item summary {
				cursor: pointer;
				list-style: none;
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 1rem;
				font-size: 1.1rem;
				font-weight: 700;
				line-height: 1.3;
				letter-spacing: -0.01em;
				color: rgb(var(--ink));
			}

			.faq-item summary::-webkit-details-marker {
				display: none;
			}

			.faq-item summary::after {
				content: '+';
				font-size: 1.4rem;
				font-weight: 400;
				line-height: 1;
				color: var(--signal-deep);
				transition: transform 0.18s ease;
			}

			.faq-item[open] summary::after {
				content: '−';
			}

			.faq-item summary:hover,
			.faq-item summary:focus-visible {
				color: var(--signal-deep);
			}

			.faq-item .faq-answer {
				margin: 0.85rem 0 0;
				font-size: 0.95rem;
				line-height: 1.7;
				color: rgba(var(--ink), 0.82);
				max-width: 56rem;
			}

			@media (max-width: 1040px) {
				.hero,
					.posts-grid,
					.topic-grid,
					.summary-grid {
						grid-template-columns: 1fr;
					}
				}

			@media (max-width: 720px) {
				.home-shell {
					padding-bottom: 3rem;
				}

				.hero-panel,
				.hero-visual,
				.guide-shell {
					padding: 1rem;
				}

				.hero-panel h1 {
					font-size: clamp(2.1rem, 11vw, 3.2rem);
				}

				.section-head {
					align-items: start;
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="home-shell">
				<section class="hero" aria-labelledby="homepage-title">
					<div class="hero-panel">
						<p class="eyebrow">AISEOShift</p>
						<h1 id="homepage-title">AI SEO Shift</h1>
						<p>AI SEO Shift is the move from ranking-first SEO to visibility across AI answers, citations, and search systems like Google AI Overviews, ChatGPT, Claude, and Perplexity.</p>
						<div class="hero-actions">
							<a class="primary-action" href="#guide">Read the guide</a>
							<a class="secondary-action" href="#latest">Latest posts</a>
						</div>
						<div class="hero-metrics" aria-label="Core homepage highlights">
							<div class="metric">
								<strong>AI SEO</strong>
								<span>Understand how traditional SEO now overlaps with AI visibility, citations, and answer engines.</span>
							</div>
							<div class="metric">
								<strong>AEO + GEO</strong>
								<span>Learn how to structure content so ChatGPT, Google AI Overviews, Claude, and Perplexity can trust it.</span>
							</div>
							<div class="metric">
								<strong>Fresh Publishing</strong>
								<span>The homepage stays active with current posts, while the core guide anchors the brand term AI SEO Shift.</span>
							</div>
						</div>
					</div>

					<div class="hero-visual">
						{guideImage && <img src={guideImage.src} alt={guideImage.alt} loading="eager" />}
						<div class="hero-caption">
							<strong>AISEOShift is built around one core topic: the AI SEO Shift.</strong>
							<div>
								This homepage explains the topic clearly, links to the supporting guides that define it,
								and surfaces the latest reporting underneath.
							</div>
						</div>
					</div>
				</section>

				<section aria-labelledby="core-topics">
					<div class="section-head">
						<div>
							<p class="eyebrow">Core Topics</p>
							<h2 id="core-topics">Core guides that define the AI SEO Shift</h2>
						</div>
						<p>These pages support the homepage with definitions, frameworks, and measurement.</p>
					</div>
					<div class="topic-grid">
						{featuredTopics.map((topic) => (
							<a class="topic-card" href={topic.href}>
								<span>{topic.kicker}</span>
								<strong>{topic.label}</strong>
							</a>
						))}
					</div>
				</section>

				<section aria-labelledby="services-tools">
					<div class="section-head">
						<div>
							<p class="eyebrow">Explore More</p>
							<h2 id="services-tools">AI SEO services and AI SEO tools</h2>
						</div>
						<p>Two clear paths for visitors who want expert help or want to self-audit.</p>
					</div>
					<div class="topic-grid">
						{commercialLinks.map((item) => (
							<a class="topic-card" href={item.href}>
								<span>{item.kicker}</span>
								<strong>{item.title}</strong>
								<p>{item.copy}</p>
							</a>
						))}
					</div>
				</section>

				<section id="guide" aria-labelledby="guide-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Start Here</p>
							<h2 id="guide-title">Understand the AI SEO Shift quickly</h2>
						</div>
						<a href="/ai-seo-shift/">Read the full guide</a>
					</div>
					<div class="guide-shell">
						<div class="guide-meta">
							<p class="eyebrow">Guide Snapshot</p>
							<h3>{guide.data.title}</h3>
							<p>{guide.data.description}</p>
							<ul>
								<li>Published: <FormattedDate date={guide.data.pubDate} /></li>
								<li>Category: {guide.data.category}</li>
								<li>Author: {guide.data.author}</li>
							</ul>
						</div>
						<div class="summary-shell">
							<div class="summary-grid">
								{homepageSections.map((section) => (
									<article class="summary-card">
										<h3>{section.title}</h3>
										<p>{section.body}</p>
									</article>
								))}
							</div>
							<div class="summary-actions">
								<a class="primary-action" href="/ai-seo-shift/">Read the full guide</a>
								<a class="secondary-action" href="#core-topics">Explore related topics</a>
							</div>
						</div>
					</div>
				</section>

				<section id="latest" aria-labelledby="latest-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Latest Posts</p>
							<h2 id="latest-title">Latest AI visibility and search strategy posts</h2>
						</div>
						<a href="/blog/">View all posts</a>
					</div>
					<div class="posts-grid">
						{latestPosts.map((post) => {
							const cardImage = imageManifest[post.id as keyof typeof imageManifest]?.hero;
							return (
								<a class="post-card" href={`/blog/${post.id}/`}>
									{cardImage && <img src={cardImage.src} alt={cardImage.alt} loading="lazy" />}
									<div class="post-copy">
										<span class="post-kicker">{post.data.category}</span>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
										<div class="post-meta">
											<span><FormattedDate date={post.data.pubDate} /></span>
											<span>{post.data.author}</span>
										</div>
									</div>
								</a>
							);
						})}
					</div>
				</section>

				<section id="faq" aria-labelledby="faq-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">FAQ</p>
							<h2 id="faq-title">AI SEO, AEO, and GEO: the questions people ask first</h2>
						</div>
						<p>Direct answers to the most common questions about the AI SEO Shift.</p>
					</div>
					<div class="faq-shell">
						{faqs.map((item, i) => (
							<details class="faq-item" open={i === 0}>
								<summary>{item.q}</summary>
								<p class="faq-answer">{item.a}</p>
							</details>
						))}
					</div>
				</section>

				<section aria-labelledby="about-brand">
					<div class="section-head">
