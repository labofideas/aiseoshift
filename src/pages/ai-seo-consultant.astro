---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const CALENDLY_URL = 'https://calendly.com/shashank19/15min';
const WEB3FORMS_ACCESS_KEY = 'd165756b-c4fc-484f-9914-97af89d0421e';

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		provider: { '@type': 'Organization', name: SITE_TITLE },
		areaServed: 'Worldwide',
		serviceType: 'AI SEO Consulting',
		description:
			'Independent AI SEO consulting for teams that need AI visibility, answer engine optimization, and generative engine optimization work done by the person who diagnosed the problem.',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
				{
					'@type': 'Question',
					name: 'What does an AI SEO consultant cost?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Audits are fixed-scope and typically run $1,500 to $6,000 depending on site size and how many categories need prompt testing. Implementation partnerships and retained advisory run $2,000 to $9,000 per month based on hours and scope. Everything is quoted before work starts, and the audit stands alone if you want to take the roadmap elsewhere.',
					},
				},
				{
					'@type': 'Question',
					name: 'How is this different from regular SEO consulting?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'The technical foundation overlaps heavily. Crawlability, structure, and content quality still matter, and anyone selling AI SEO as a clean break from SEO is selling you something. What is genuinely different is the target: you are optimizing to be quoted rather than to be clicked, which changes how you structure answers, how much evidence a claim needs, and how you measure whether it worked.',
					},
				},
				{
					'@type': 'Question',
					name: 'Who will actually do the work?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'I will. That is the entire argument for hiring a consultant instead of an agency. If a piece of work needs a specialist I do not have, I say so and help you find one rather than quietly subcontracting it.',
					},
				},
				{
					'@type': 'Question',
					name: 'How long until we see results?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Citation visibility can move within weeks when the blocker is technical, because answer engines re-crawl and re-evaluate far more often than Google re-ranks. When the blocker is authority or evidence, expect four to nine months of real work. Anyone promising a fixed timeline before seeing your site is guessing.',
					},
				},
				{
					'@type': 'Question',
					name: 'Do you work with clients outside India?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Most of the work is outside India. Engagements run remotely across US, UK, European, and Australian time zones, with calls scheduled in your working hours rather than mine. The registered office is in Lucknow and it has never determined who the client is.',
					},
				},
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO Consultant | ${SITE_TITLE}`}
			description="Work directly with an AI SEO consultant on AI visibility, AEO, and GEO. No account manager, no junior handoff. Audits, implementation plans, and retained advisory."
			structuredData={structuredData}
		/>
		<style>
			.svc-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-7) 0 var(--space-9); }

			.svc-hero { padding: var(--space-7) 0 var(--space-8); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: end; }
			.svc-kicker { display: inline-flex; padding: 0; color: var(--ink-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
			.svc-hero h1 { font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1; letter-spacing: -0.03em; font-weight: 600; margin: var(--space-4) 0 0; max-width: 16ch; }
			.svc-hero-lede p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: 0; }

			.svc-cta-row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-5); }
			.svc-btn { display: inline-flex; align-items: center; padding: 0.85rem 1.4rem; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
			.svc-btn-primary { background: rgb(var(--ink)); color: rgb(var(--paper)); }
			.svc-btn-primary:hover { background: var(--signal-deep); }
			.svc-btn-secondary { background: transparent; color: rgb(var(--ink)); border: 1px solid var(--line-strong); }
			.svc-btn-secondary:hover { border-color: rgb(var(--ink)); }

			.svc-section { padding: var(--space-8) 0; border-bottom: 1px solid var(--line); }
			.svc-section h2 { font-size: clamp(1.85rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -0.024em; font-weight: 600; margin: 0 0 var(--space-5); max-width: 18ch; }
			.svc-section > p { font-size: 1.05rem; line-height: 1.65; color: rgba(var(--ink), 0.82); max-width: var(--measure); margin: 0 0 var(--space-6); }

			.svc-list { list-style: none; margin: 0; padding: 0; }
			.svc-list li { margin: 0; }
			.svc-row { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-6); align-items: baseline; padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.svc-list li:last-child .svc-row { border-bottom: 1px solid var(--line); }
			.svc-row-num { font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-style: italic; font-weight: 400; font-size: 1.1rem; color: var(--ink-muted); }
			.svc-row h3 { font-size: 1.3rem; line-height: 1.2; margin: 0 0 var(--space-2); letter-spacing: -0.018em; font-weight: 600; }
			.svc-row p { font-size: 0.95rem; line-height: 1.55; color: var(--ink-muted); margin: 0 0 var(--space-3); max-width: 52ch; }
			.svc-row ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
			.svc-row ul li { font-size: 0.82rem; color: var(--ink-muted); }
			.svc-row ul li + li::before { content: '·'; margin-right: var(--space-3); color: var(--line-strong); }

			.outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; }
			.outcome { padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
			.outcome strong { display: block; font-family: 'Figtree', system-ui, -apple-system, sans-serif; font-style: italic; font-weight: 400; font-size: 1.15rem; color: rgb(var(--ink)); margin-bottom: var(--space-3); }
			.outcome span { font-size: 0.95rem; color: var(--ink-muted); line-height: 1.55; }

			.contact-block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-7); margin: var(--space-5) 0 0; align-items: start; }
			@media (max-width: 860px) { .svc-hero, .outcomes, .contact-block { grid-template-columns: 1fr; } .svc-row { grid-template-columns: 1fr; gap: var(--space-3); } }

			.contact-card { padding: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); }
			.contact-card h3 { font-size: 1.25rem; margin: 0 0 var(--space-3); letter-spacing: -0.015em; font-weight: 600; }
			.contact-card > p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); margin: 0 0 var(--space-5); }
			.contact-form { display: flex; flex-direction: column; gap: var(--space-3); }
			.contact-form label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; color: rgba(var(--ink), 0.85); text-transform: uppercase; }
			.contact-form .req { color: var(--signal-deep); margin-left: 0.15rem; }
			.contact-form input:focus-visible, .contact-form select:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; border-color: rgb(var(--ink)); }
			.contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 0.7rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font-size: 0.95rem; font-family: inherit; background: rgb(var(--paper)); color: rgb(var(--ink)); box-sizing: border-box; }
			.contact-form textarea { min-height: 120px; resize: vertical; }
			.contact-form button { margin-top: var(--space-3); padding: 0.85rem 1rem; background: rgb(var(--ink)); color: rgb(var(--paper)); font-weight: 600; font-size: 0.95rem; border: none; border-radius: var(--radius-sm); cursor: pointer; }
			.contact-form button:hover { background: var(--signal-deep); }
			.form-status { margin-top: var(--space-3); font-size: 0.9rem; display: none; }
			.form-status.success { display: block; color: #047857; }
			.form-status.error { display: block; color: #b91c1c; }

			.faq-list { margin: 0; padding: 0; list-style: none; }
			.faq-list li { padding: var(--space-5) 0; border-top: 1px solid var(--line); }
			.faq-list li:last-child { border-bottom: 1px solid var(--line); }
			.faq-list h3 { font-size: 1.1rem; margin: 0 0 var(--space-2); letter-spacing: -0.012em; font-weight: 600; }
			.faq-list p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); max-width: 56ch; }

			.svc-figure { margin: var(--space-6) 0 0; padding: 0; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgb(var(--paper-strong)); overflow: hidden; }
			.svc-figure svg { display: block; width: 100%; height: auto; }
			.svc-figure figcaption { padding: 0.75rem 1rem; border-top: 1px solid var(--line); font-size: 0.85rem; line-height: 1.55; font-style: italic; color: var(--ink-muted); }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="svc-page">
			<section class="svc-hero">
				<div>
					<span class="svc-kicker">AI SEO consulting</span>
					<h1>AI SEO Consultant, Not an Account Manager</h1>
				</div>
				<div class="svc-hero-lede">
					<p>
						Most SEO engagements go the same way. A senior person wins the work, and a junior one does it. That gap is survivable when the job is publishing blog posts on a schedule. It is not survivable when the job is figuring out why ChatGPT cites your competitor and not you, because the diagnosis and the fix are the same piece of thinking.
					</p>
					<div class="svc-cta-row">
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min call &rarr;</a>
						<a class="svc-btn svc-btn-secondary" href="#quote">Request a quote</a>
					</div>
				</div>
			</section>

			<figure class="svc-figure" aria-labelledby="svc-figure-caption">
				<svg viewBox="0 0 1080 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="What an AI SEO consultant does: diagnosis, entity and schema architecture, citation-earning content, and honest measurement feeding AI engines that cite the brand">
					<rect width="1080" height="360" fill="rgb(246,245,240)" />
					<g stroke="rgb(14,17,22)" stroke-opacity="0.06"><line x1="0" y1="48" x2="1080" y2="48" /><line x1="0" y1="312" x2="1080" y2="312" /></g>
					<text x="48" y="32" font-family="system-ui, sans-serif" font-size="12" letter-spacing="3" fill="rgb(14,17,22)" fill-opacity="0.6">INPUT SIGNALS</text>
					<text x="540" y="32" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" letter-spacing="3" fill="rgb(14,17,22)" fill-opacity="0.6">AI SYNTHESIS</text>
					<text x="1032" y="32" text-anchor="end" font-family="system-ui, sans-serif" font-size="12" letter-spacing="3" fill="rgb(184,85,46)">CITED OUTCOME</text>
					<g font-family="system-ui, sans-serif" font-size="13" fill="rgb(14,17,22)">
						<g transform="translate(48 80)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">AI visibility diagnosis</text></g>
						<g transform="translate(48 132)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">Entity + schema architecture</text></g>
						<g transform="translate(48 184)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">Citation-earning content</text></g>
						<g transform="translate(48 236)"><rect width="240" height="40" fill="rgb(250,250,247)" stroke="rgb(14,17,22)" stroke-opacity="0.15" rx="4" /><text x="16" y="26" font-weight="600">Measurement that holds up</text></g>
					</g>
					<g stroke="rgb(14,17,22)" stroke-opacity="0.2" fill="none">
						<path d="M 288 100 C 360 100, 380 178, 440 178" /><path d="M 288 152 C 360 152, 380 178, 440 178" /><path d="M 288 204 C 360 204, 380 178, 440 178" /><path d="M 288 256 C 360 256, 380 178, 440 178" />
					</g>
					<g transform="translate(440 130)">
						<rect width="200" height="100" fill="rgb(14,17,22)" rx="6" />
						<text x="100" y="42" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" letter-spacing="2" fill="rgb(250,250,247)" fill-opacity="0.6">AI ENGINES</text>
						<text x="100" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="rgb(250,250,247)">ChatGPT · Perplexity</text>
						<text x="100" y="86" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="rgb(250,250,247)">Claude · AI Overviews</text>
					</g>
					<g stroke="rgb(184,85,46)" stroke-width="1.5" fill="none" stroke-linecap="round">
						<path d="M 640 180 C 700 180, 760 180, 820 180" />
						<polyline points="810,174 820,180 810,186" />
					</g>
					<g transform="translate(820 110)">
						<rect width="212" height="140" fill="rgb(250,250,247)" stroke="rgb(184,85,46)" stroke-width="1.5" rx="6" />
						<circle cx="32" cy="38" r="18" fill="rgb(184,85,46)" />
						<text x="32" y="44" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" font-weight="700" fill="rgb(250,250,247)">01</text>
						<text x="62" y="36" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="rgb(14,17,22)">Cited by name</text>
						<text x="62" y="54" font-family="system-ui, sans-serif" font-size="11" fill="rgb(14,17,22)" fill-opacity="0.6">in the answers buyers read</text>
						<rect x="20" y="76" width="172" height="6" rx="1" fill="rgb(14,17,22)" fill-opacity="0.75" />
						<rect x="20" y="88" width="140" height="4" rx="1" fill="rgb(14,17,22)" fill-opacity="0.35" />
						<rect x="20" y="98" width="156" height="4" rx="1" fill="rgb(14,17,22)" fill-opacity="0.35" />
						<rect x="20" y="108" width="120" height="4" rx="1" fill="rgb(14,17,22)" fill-opacity="0.35" />
					</g>
					<text id="svc-figure-caption" x="540" y="340" text-anchor="middle" font-family="Figtree, system-ui, sans-serif" font-style="italic" font-size="13" fill="rgb(14,17,22)" fill-opacity="0.7">Four pieces of work, one person accountable for whether they add up.</text>
				</svg>
			</figure>

			<section class="svc-section">
				<h2>What an AI SEO consultant actually does</h2>
				<p>The title is new and the work is mostly not. What changed is where the decision happens. Rankings used to be the product. Now the product is whether an answer engine names you when someone describes their problem, and getting there needs judgment about entities, evidence, and structure more than it needs volume.</p>
				<div class="outcomes">
					<div class="outcome"><strong>Diagnosis first, always</strong><span>Running the prompts your buyers run, across ChatGPT, Perplexity, Claude, and AI Overviews, and finding out who gets named and what evidence they are named on. Everything else is guessing.</span></div>
					<div class="outcome"><strong>Architecture over output</strong><span>Entity clarity, schema that matches reality, internal linking that tells a machine what you are the authority on. This is where most of the gap sits, and it is not a content-volume problem.</span></div>
					<div class="outcome"><strong>Measurement that survives scrutiny</strong><span>Citation share, assisted conversions, branded query lift. Not a screenshot of one good ChatGPT answer, which anyone can produce on any given day.</span></div>
				</div>
			</section>

			<section class="svc-section">
				<h2>Three ways to work together</h2>
				<p>Scoped small enough that you can judge the work before committing to more of it.</p>
				<ol class="svc-list">
					<li>
						<div class="svc-row">
							<span class="svc-row-num">01</span>
							<div>
								<h3>AI Visibility Audit</h3>
								<p>A fixed-scope diagnosis. I run your category prompts across the major answer engines, record who gets cited and why, and trace every gap back to something specific on your site: a missing entity signal, a schema mismatch, content that answers nothing an engine can quote. You get a prioritized fix list with effort estimates, and a walkthrough call to argue with it.</p>
								<ul><li>Prompt testing across ChatGPT, Perplexity, Claude, AI Overviews</li><li>Competitor citation-share benchmark</li><li>Entity and <a href="/seo/schema-markup/">schema</a> architecture review</li><li>Content <a href="/blog/ai-seo-audit-checklist/">gap analysis</a> against cited sources</li><li>Technical review of AI crawler access</li><li>Prioritized roadmap with effort and impact estimates</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">02</span>
							<div>
								<h3>Implementation Partnership</h3>
								<p>For teams that have the diagnosis and need someone to drive the fix. I work alongside your writers and developers: specifying schema, reviewing content against what actually earns citations, and handling the technical work your team does not want to own. Your people keep the context. I keep the standard.</p>
								<ul><li>Schema specification and review</li><li>Content briefs written for citation, not word count</li><li>Editorial review against AI-visibility criteria</li><li>Technical implementation with your dev team</li><li>Internal linking and topical architecture</li><li>Training so the standard outlives the engagement</li></ul>
							</div>
						</div>
					</li>
					<li>
						<div class="svc-row">
							<span class="svc-row-num">03</span>
							<div>
								<h3>Retained Advisory</h3>
								<p>A standing arrangement for teams that want senior judgment on tap without a full retainer. Monthly working sessions, async access for decisions that cannot wait, and quarterly re-testing so you find out about a visibility drop from me rather than from a sales report.</p>
								<ul><li>Monthly working sessions with your team</li><li>Async access for in-flight decisions</li><li>Quarterly citation re-testing and reporting</li><li>Content and technical review on request</li><li>Early read on engine and algorithm changes</li><li>Escalation path when something breaks</li></ul>
							</div>
						</div>
					</li>
				</ol>
			</section>

			<section class="svc-section">
				<h2>Consultant, agency, or in-house</h2>
				<p>These are not competing products, they are different stages. Picking wrong is expensive in both directions, so here is the honest version.</p>
				<div class="outcomes">
					<div class="outcome"><strong>A consultant fits when the problem is judgment</strong><span>You need to know what is wrong and what to do about it, and you have people who can execute once someone tells them what matters. Diagnosis, architecture, and standards are the deliverable.</span></div>
					<div class="outcome"><strong>An agency fits when the problem is throughput</strong><span>You know the plan and you need forty pieces of content, ongoing technical work, and a team to run it. Buying judgment by the hour when you need volume is the wrong shape.</span></div>
					<div class="outcome"><strong>In-house fits when it is core</strong><span>If organic and AI visibility are your primary acquisition channel, own it. Use a consultant to set the standard and train the team, then stop paying for it.</span></div>
				</div>
			</section>

			<section class="svc-section" id="quote">
				<h2>Start with a conversation</h2>
				<p>Book a free 15-minute strategy call or send a quote request below. We respond within one business day.</p>
				<div class="contact-block">
					<div class="contact-card">
						<h3>Book a strategy call</h3>
						<p>Fifteen minutes. Bring one category prompt you care about and we will run it live, then talk about what the answer tells us.</p>
						<a class="svc-btn svc-btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Open Calendly &rarr;</a>
					</div>
					<div class="contact-card">
						<h3 id="quote-form-heading">Request a quote by form</h3>
						<p>Tell me about your site, your category, and what you are trying to change. I reply personally within one business day.</p>
						<form class="contact-form" id="quote-form" aria-labelledby="quote-form-heading">
							<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
							<input type="hidden" name="subject" value="AI SEO consulting enquiry from aiseoshift.com" />
							<input type="hidden" name="from_name" value="AISEOShift Consulting Enquiry Form" />
							<input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
							<label for="q-name">Name <span class="req" aria-hidden="true">*</span></label>
							<input id="q-name" type="text" name="name" required aria-required="true" autocomplete="name" />
							<label for="q-email">Email <span class="req" aria-hidden="true">*</span></label>
							<input id="q-email" type="email" name="email" required aria-required="true" autocomplete="email" />
							<label for="q-company">Company / website</label>
							<input id="q-company" type="text" name="company" autocomplete="organization" />
							<label for="q-service">Service interested in <span class="req" aria-hidden="true">*</span></label>
							<select id="q-service" name="service" required aria-required="true">
								<option value="">Select a service…</option>
									<option value="AI Visibility Audit">AI Visibility Audit</option>
									<option value="Implementation Partnership">Implementation Partnership</option>
									<option value="Retained Advisory">Retained Advisory</option>
								<option value="Not sure yet">Not sure yet</option>
							</select>
							<label for="q-message">What are you trying to change <span class="req" aria-hidden="true">*</span></label>
							<textarea id="q-message" name="message" required aria-required="true" placeholder="Your site, your category, your main competitors, and what prompted you to look into this now."></textarea>
							<button type="submit">Send quote request</button>
							<div class="form-status" id="form-status" role="status" aria-live="polite"></div>
						</form>
					</div>
				</div>
			</section>

			<section class="svc-section">
				<h2>AI SEO consulting FAQs</h2>
				<ul class="faq-list">
					<li>
						<h3>What does an AI SEO consultant cost?</h3>
						<p>Audits are fixed-scope and typically run $1,500 to $6,000 depending on site size and how many categories need prompt testing. Implementation partnerships and retained advisory run $2,000 to $9,000 per month based on hours and scope. Everything is quoted before work starts, and the audit stands alone if you want to take the roadmap elsewhere.</p>
					</li>
					<li>
						<h3>How is this different from regular SEO consulting?</h3>
