---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	SITE_TITLE,
	SITE_URL,
	AUTHOR_PROFILE_URL,
	AUTHOR_NAME,
	AUTHOR_IMAGE,
	AUTHOR_ROLE,
} from '../consts';

const canonical = new URL('/ai-seo-by-industry/', SITE_URL).toString();
const pubDate = new Date('2026-06-15');
const now = new Date();

// Vertical playbooks grouped by sector. Slugs omit the shared "ai-seo-for-"
// prefix; titles are pulled live from the blog collection (published only).
const groups: { sector: string; slugs: string[] }[] = [
	{
		sector: 'Healthcare and wellness',
		slugs: [
			'medical-practices', 'dental-practices', 'chiropractors', 'dermatologists',
			'optometrists', 'pediatricians', 'physical-therapists', 'mental-health-therapists',
			'urgent-care-centers', 'veterinarians', 'pharmacies', 'senior-care-assisted-living',
			'home-care', 'med-spas', 'plastic-surgeons', 'addiction-treatment-centers',
		],
	},
	{
		sector: 'Legal',
		slugs: [
			'law-firms', 'personal-injury-lawyers', 'criminal-defense-attorneys',
			'family-law-attorneys', 'estate-planning-attorneys', 'immigration-lawyers',
		],
	},
	{
		sector: 'Financial and professional services',
		slugs: [
			'cpa-firms', 'accountants', 'tax-preparation-services', 'financial-advisors',
			'mortgage-brokers', 'insurance-agents', 'it-services',
		],
	},
	{
		sector: 'Home services',
		slugs: [
			'plumbers-electricians-hvac', 'roofing-companies', 'landscaping-companies',
			'pest-control-companies', 'moving-companies', 'solar-installers',
		],
	},
	{
		sector: 'Local and consumer',
		slugs: [
			'restaurants', 'auto-dealers', 'auto-shops', 'tire-dealers', 'real-estate-agents',
			'beauty-salons-spas', 'gyms-fitness-centers', 'yoga-pilates-studios',
			'photography-studios', 'wedding-venues-planners', 'tutoring-learning-centers',
			'language-schools',
		],
	},
	{
		sector: 'B2B, tech, and organizations',
		slugs: ['saas', 'b2b-saas', 'startups', 'agencies', 'ecommerce-brands', 'nonprofits'],
	},
];

const posts = await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= now);
const byId = new Map(posts.map((p) => [p.id, p]));

const rendered = groups
	.map((g) => ({
		sector: g.sector,
		items: g.slugs
			.map((s) => byId.get(`ai-seo-for-${s}`))
			.filter((p): p is (typeof posts)[number] => Boolean(p))
			.map((p) => ({ slug: p.id, title: p.data.title, description: p.data.description })),
	}))
	.filter((g) => g.items.length > 0);

const total = rendered.reduce((n, g) => n + g.items.length, 0);

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'AI SEO by Industry', item: canonical },
	],
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	'@id': `${canonical}#playbooks`,
	name: 'AI SEO playbooks by industry',
	itemListElement: rendered
		.flatMap((g) => g.items)
		.map((it, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: it.title,
			url: new URL(`/blog/${it.slug}/`, SITE_URL).toString(),
		})),
};

const collectionPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'@id': `${canonical}#page`,
	name: 'AI SEO by Industry',
	url: canonical,
	description:
		'AI SEO playbooks for specific industries: healthcare, legal, financial, home services, local businesses, and B2B.',
	isPartOf: { '@id': `${SITE_URL}/#website` },
	datePublished: pubDate.toISOString(),
	dateModified: now.toISOString(),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`AI SEO by Industry: ${total}+ Vertical Playbooks | ${SITE_TITLE}`}
			description="AI SEO playbooks for specific industries, from medical practices and law firms to restaurants, home services, and SaaS. Each playbook covers the pillars, AI verification signals, and queries that win clients."
			canonical={canonical}
			ogType="website"
			structuredData={[collectionPageSchema, itemListSchema, breadcrumbSchema]}
		/>
		<style>
			.hub-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-6) 0 var(--space-9); }
			.hub-crumbs { display: flex; gap: 0.4rem; font-size: 0.8rem; color: var(--ink-muted); padding: var(--space-5) 0; }
			.hub-crumbs a { color: var(--ink-muted); text-decoration: none; }
			.hub-crumbs a:hover { color: var(--signal-deep); }
			.hub-hero { padding: var(--space-5) 0 var(--space-7); border-bottom: 1px solid var(--line); }
			.hub-hero .kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); margin: 0; }
			.hub-hero h1 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 600; margin: var(--space-3) 0 0; max-width: 18ch; }
			.hub-hero p { font-size: 1.1rem; line-height: 1.6; color: rgba(var(--ink), 0.78); max-width: var(--measure); margin: var(--space-4) 0 0; }
			.hub-author { display: inline-flex; align-items: center; gap: 0.7rem; margin: var(--space-5) 0 0; text-decoration: none; color: rgb(var(--ink)); }
			.hub-author img { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line-strong); }
			.hub-author-text { display: inline-flex; flex-direction: column; line-height: 1.25; font-size: 0.82rem; }
			.hub-author-name { font-weight: 700; }
			.hub-author-role { color: var(--ink-muted); font-size: 0.72rem; }
			.hub-cat { padding: var(--space-6) 0; border-bottom: 1px solid var(--line); }
			.hub-cat h2 { font-size: clamp(1.4rem, 2.4vw, 1.85rem); letter-spacing: -0.02em; font-weight: 600; margin: 0 0 var(--space-4); }
			.hub-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-4); }
			.hub-grid a { display: flex; flex-direction: column; gap: 0.35rem; height: 100%; padding: var(--space-4); border: 1px solid var(--line-strong); border-radius: 8px; background: rgb(var(--paper)); text-decoration: none; color: rgb(var(--ink)); transition: border-color 0.15s ease; }
			.hub-grid a:hover { border-color: var(--signal); }
			.hub-grid .t { font-family: 'Iowan Old Style', Georgia, serif; font-size: 1.02rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; }
			.hub-grid .d { font-size: 0.85rem; line-height: 1.5; color: rgba(var(--ink), 0.72); }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="hub-page">
			<nav class="hub-crumbs" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">AI SEO by Industry</span>
			</nav>

			<section class="hub-hero">
				<p class="kicker">AISEOShift · Industry Playbooks</p>
				<h1>AI SEO playbooks, by industry.</h1>
				<p>
					{total}+ playbooks for winning AI search visibility in specific industries.
					Each one covers the pillars that matter for that vertical, the signals AI
					engines verify before recommending a business, and the queries that actually
					bring in clients.
				</p>
				<a class="hub-author" href={AUTHOR_PROFILE_URL} rel="author">
					<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="38" height="38" />
					<span class="hub-author-text">
						<span class="hub-author-name">By {AUTHOR_NAME}</span>
						<span class="hub-author-role">{AUTHOR_ROLE}</span>
					</span>
				</a>
			</section>

			{rendered.map((g) => (
				<section class="hub-cat">
					<h2>{g.sector}</h2>
					<ul class="hub-grid">
						{g.items.map((it) => (
							<li>
								<a href={`/blog/${it.slug}/`}>
									<span class="t">{it.title}</span>
									<span class="d">{it.description}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
