---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import EditorialImage from '../components/EditorialImage.astro';
import EmailSubscribe from '../components/EmailSubscribe.astro';
import ServiceCTA from '../components/ServiceCTA.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostEngagement from '../components/PostEngagement.astro';
import AuthorBio from '../components/AuthorBio.astro';
import {
	SITE_AUTHOR,
	SITE_TITLE,
	SITE_URL,
	AUTHOR_NAME,
	AUTHOR_ROLE,
	AUTHOR_IMAGE,
	AUTHOR_PROFILE_URL,
} from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
	headings?: Array<{ depth: number; slug: string; text: string }>;
	relatedPosts?: CollectionEntry<'blog'>[];
	imageManifest?: Record<string, any>;
	ogImage?: { src: string; width?: number; height?: number };
};

const {
	title, description, deck, pubDate, updatedDate, category, tags, author,
	slug, heroImage, ogImage, headings = [], relatedPosts = [], imageManifest = {}, faqs,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const descWords = description.split(/\s+/).length;
const deckWords = deck.split(/\s+/).length;
const readTime = Math.max(3, Math.round((descWords * 20 + deckWords * 8) / 200));
const tocHeadings = headings.filter((h) => h.depth <= 3 && h.text !== 'Related reading' && h.text !== 'References');

const heroImageAbs = heroImage?.src ? new URL(heroImage.src, SITE_URL).toString() : undefined;
const ogImageAbs = ogImage?.src ? new URL(ogImage.src, SITE_URL).toString() : heroImageAbs;

const articleSchema: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: canonical,
	inLanguage: 'en-US',
	articleSection: category,
	speakable: {
		'@type': 'SpeakableSpecification',
		cssSelector: ['.deck', '.prose > p:first-of-type'],
	},
};
if (heroImageAbs) articleSchema.image = heroImageAbs;

const toolHeadings = headings.filter((h) => h.depth === 3 && /^\d+\.\s/.test(h.text));
const itemListSchema = toolHeadings.length >= 5 ? {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: title,
	itemListOrder: 'https://schema.org/ItemListOrderDescending',
	numberOfItems: toolHeadings.length,
	itemListElement: toolHeadings.map((h, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: h.text.replace(/^\d+\.\s*/, '').replace(/\s*[—–-]\s.*$/, ''),
		url: `${canonical}#${h.slug}`,
	})),
} : null;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` },
		{ '@type': 'ListItem', position: 3, name: title, item: canonical },
	],
};

const faqSchema = faqs && faqs.length ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f: { q: string; a: string }) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
} : null;

const structuredData = [articleSchema, itemListSchema, faqSchema, breadcrumbSchema].filter(Boolean);
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			canonical={canonical}
			image={ogImageAbs}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={(updatedDate ?? pubDate).toISOString()}
			articleSection={category}
			articleTags={tags}
			structuredData={structuredData}
			preloadHero={heroImage?.src}
		/>
		<style>
			.article-shell {
				width: min(1240px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 1.6rem 0 3rem;
				overflow-x: hidden;
			}

			.story-grid {
				display: grid;
				grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
				gap: 2rem;
				align-items: start;
			}

			/* ── Sidebar / TOC ── */
			.story-sidebar {
				position: sticky;
				top: 5rem;
				padding: 0.5rem 1.2rem 1rem 0;
				border-right: 1px solid var(--line);
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
			}

			.toc-nav { margin-bottom: 1.5rem; }

			.toc-title,
			.meta-title {
				font-size: 0.78rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: rgba(var(--ink), 0.72);
				margin: 0 0 0.6rem;
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
			}

			.toc-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.toc-item { margin: 0; }
			.toc-h3 { padding-left: 0.75rem; }

			.toc-link {
				display: block;
				padding: 0.28rem 0 0.28rem 0.6rem;
				font-size: 0.82rem;
				line-height: 1.4;
				color: rgba(var(--ink), 0.74);
				text-decoration: none;
				border-left: 2px solid transparent;
				transition: color 140ms ease, border-color 140ms ease;
			}

			.toc-link:hover,
			.toc-link:focus-visible { color: rgb(var(--ink)); }

			.toc-link.active {
				color: var(--signal-deep);
				border-left-color: var(--signal);
				font-weight: 700;
			}

			.meta-block {
				padding-top: 1rem;
				border-top: 1px solid var(--line);
			}

			.meta-block p {
				margin: 0.2rem 0 0;
				font-size: 0.86rem;
				color: rgba(var(--ink), 0.78);
			}

			.meta-block ul {
				padding: 0;
				margin: 0.3rem 0 0;
				list-style: none;
			}

			.meta-block li {
				font-size: 0.82rem;
				color: rgba(var(--ink), 0.74);
				padding: 0.15rem 0;
			}

			.meta-title + p,
			.meta-title + ul { margin-top: 0; }

			.meta-block + .meta-block { margin-top: 0.9rem; }

			/* ── Story Content ── */
			.story {
				max-width: 820px;
				min-width: 0;
			}

			.story-header { margin-bottom: 1.75rem; }

			.breadcrumbs {
				margin: 0 0 1rem;
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: rgba(var(--ink), 0.7);
			}

			.breadcrumbs a {
				text-decoration: none;
				color: inherit;
			}

			.breadcrumbs a:hover { color: var(--signal-deep); }

			.hero-visual { margin: 0 0 1.4rem; }

			.kicker {
				display: inline-flex;
				padding: 0;
				color: var(--ink-muted);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				text-transform: uppercase;
			}

			.story h1 {
				font-family: 'Figtree', 'Atkinson', system-ui, sans-serif;
				font-size: clamp(2.2rem, 4.4vw, 3.6rem);
				line-height: 1;
				letter-spacing: -0.03em;
				font-weight: 600;
				margin: 0.9rem 0 1rem;
				max-width: 18ch;
				color: rgb(var(--ink));
			}

			.deck {
				font-size: 1.1rem;
				line-height: 1.6;
				color: rgba(var(--ink), 0.78);
				max-width: 46rem;
				margin: 0 0 1.2rem;
			}

			.story-byline {
				display: inline-flex;
				align-items: center;
				gap: 0.75rem;
				margin: 0.5rem 0 1.2rem;
				padding: 0.4rem 0;
				text-decoration: none;
				color: rgb(var(--ink));
			}

			.story-byline img {
				width: 44px;
				height: 44px;
				border-radius: 50%;
				border: 1px solid var(--line-strong);
				object-fit: cover;
			}

			.story-byline-text {
				display: inline-flex;
				flex-direction: column;
				gap: 0.1rem;
				line-height: 1.25;
			}

			.story-byline-name {
				font-size: 0.92rem;
				font-weight: 700;
				letter-spacing: -0.005em;
			}

			.story-byline-role {
				font-size: 0.78rem;
				color: var(--ink-muted);
			}

			.story-byline:hover .story-byline-name {
				color: var(--signal-deep);
			}

			.story-dates {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				align-items: center;
				color: rgba(var(--ink), 0.72);
				font-size: 0.86rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--line);
			}

			.header-upvote {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				color: var(--signal-deep);
				font-weight: 700;
			}

			.header-upvote svg {
				color: var(--signal);
			}

			/* ── Prose Typography ── */
			/* Use :global() for child selectors because slotted MDX content
			   does not receive Astro's scoped data-astro-cid attribute. */
			.prose {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: 1rem;
				line-height: 1.78;
				letter-spacing: -0.003em;
				max-width: 70ch;
			}

			.prose > :global(p:first-of-type) {
				font-size: 1.06rem;
				line-height: 1.78;
				color: rgba(var(--ink), 0.88);
			}

			.prose :global(h2) {
				font-family: 'Figtree', system-ui, -apple-system, sans-serif;
				font-size: clamp(1.55rem, 2vw, 2.05rem);
				line-height: 1.18;
				letter-spacing: -0.024em;
				font-weight: 600;
				margin-top: 3.2rem;
				margin-bottom: 0.9rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line);
			}

			.prose :global(h2:first-child) {
				border-top: none;
				padding-top: 0;
			}

			.prose :global(h3) {
				font-family: 'Figtree', system-ui, -apple-system, sans-serif;
				font-size: 1.22rem;
				line-height: 1.3;
				letter-spacing: -0.018em;
				font-weight: 600;
				margin-top: 2.2rem;
				margin-bottom: 0.6rem;
			}

			.prose :global(h2), .prose :global(h3) { scroll-margin-top: 6rem; }

			.prose :global(table) {
				border-collapse: collapse;
				margin: 1.8rem 0;
				font-size: 0.94rem;
				display: block;
				max-width: 100%;
				width: 100%;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
			}

			.prose :global(a) {
				word-break: break-word;
				overflow-wrap: anywhere;
			}

			.prose :global(th),
			.prose :global(td) {
				padding: 0.75rem 0.85rem;
				border: 1px solid rgba(var(--ink), 0.1);
			}

			.prose :global(th) {
				background: rgba(var(--ink), 0.04);
				font-weight: 700;
				text-align: left;
			}

			.prose :global(ul), .prose :global(ol) {
				padding-left: 1.1rem;
				margin: 1rem 0 1.4rem;
			}

			.prose :global(li) {
				padding-left: 0.2rem;
				margin-top: 0.45rem;
			}

			.prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(table), .prose :global(blockquote) {
				margin-bottom: 1.4rem;
			}

			.prose :global(blockquote) {
				font-size: 1rem;
				line-height: 1.75;
				margin: 2rem 0;
			}

			.prose :global(ul + h2), .prose :global(ol + h2), .prose :global(table + h2),
			.prose :global(ul + h3), .prose :global(ol + h3), .prose :global(table + h3) {
				margin-top: 3.2rem;
			}

			.prose :global(hr) {
				margin: 3rem 0;
				border: none;
				border-top: 1px solid var(--line);
			}

			.prose :global(img) { border-radius: 10px; }

			.prose :global(pre) {
				max-width: 100%;
			}

			/* ── Related Posts ── */
			.related-section {
				width: min(1240px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 2.5rem 0 3rem;
				border-top: 1px solid var(--line);
			}

			.related-heading {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: 1.3rem;
				letter-spacing: -0.015em;
				margin: 0 0 1.2rem;
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}

			.related-card {
				text-decoration: none;
				color: inherit;
				padding: 1.15rem;
				border: 1px solid var(--line);
				border-radius: 1.15rem;
				background: rgba(var(--paper-strong), 0.5);
				transition: transform 140ms ease, box-shadow 140ms ease;
				display: block;
			}

			.related-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 8px 24px rgba(var(--ink), 0.08);
			}

			.related-thumb {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 0.7rem;
				margin-bottom: 0.7rem;
			}

			.related-cat {
				font-size: 0.66rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				font-weight: 700;
				color: var(--signal-deep);
			}

			.related-title {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: 1.05rem;
				line-height: 1.28;
				margin: 0.35rem 0 0;
				font-weight: 700;
			}

			/* ── Responsive ── */
			@media (max-width: 900px) {
				.story-grid {
					grid-template-columns: 1fr;
				}

				.story-sidebar {
					position: static;
					order: -1;
					border-right: 0;
					padding-right: 0;
					max-height: none;
					border-bottom: 1px solid var(--line);
					padding-bottom: 1rem;
					margin-bottom: 0.5rem;
				}

				.meta-block { display: none; }

				.toc-list {
					display: flex;
					flex-wrap: wrap;
					gap: 0.3rem 0.8rem;
				}

				.toc-h3 { display: none; }

				.toc-link {
					border-left: none;
					padding-left: 0;
					font-size: 0.74rem;
				}

				.story h1 { max-width: none; }
				.prose { max-width: none; }

				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content" class="article-shell">
			<article class="story-grid">
				<aside class="story-sidebar" aria-label="Table of contents">
					{tocHeadings.length > 0 && (
						<nav class="toc-nav" aria-label="Table of contents">
							<p class="toc-title">In This Article</p>
							<ul class="toc-list">
								{tocHeadings.map((h) => (
									<li class:list={['toc-item', { 'toc-h3': h.depth === 3 }]}>
										<a href={`#${h.slug}`} class="toc-link">{h.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)}
					<div class="meta-block">
						<p class="meta-title">Category</p>
						<p>{category}</p>
					</div>
					<div class="meta-block">
						<p class="meta-title">Published</p>
						<p><FormattedDate date={pubDate} /></p>
					</div>
					{updatedDate && (
						<div class="meta-block">
							<p class="meta-title">Updated</p>
							<p><FormattedDate date={updatedDate} /></p>
						</div>
					)}
					<div class="meta-block">
						<p class="meta-title">Read Time</p>
						<p>{readTime} min</p>
					</div>
					<div class="meta-block">
						<p class="meta-title">Tags</p>
						<ul>
							{tags.map((tag) => <li>{tag}</li>)}
						</ul>
					</div>
				</aside>
				<div class="story">
					<header class="story-header">
						<p class="breadcrumbs"><a href="/">Home</a> / <a href="/blog">Latest</a> / {category}</p>
						<p class="kicker">{category}</p>
						<h1>{title}</h1>
						<p class="deck">{deck}</p>
						<a class="story-byline" href={AUTHOR_PROFILE_URL} rel="author">
							<img src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="44" height="44" loading="eager" />
							<span class="story-byline-text">
								<span class="story-byline-name">By {AUTHOR_NAME}</span>
								<span class="story-byline-role">{AUTHOR_ROLE}</span>
							</span>
						</a>
						<div class="story-dates">
							<span>Published <FormattedDate date={pubDate} /></span>
							{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
							<span class="header-upvote">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M7 10v12" /><path d="M15 5.88L14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88z" />
								</svg>
								<span class="header-upvote-count">—</span> claps
							</span>
						</div>
					</header>
					<EditorialImage image={heroImage} className="hero-visual" loading="eager" />
					<PostEngagement title={title} url={canonical} slug={slug} tags={tags} description={description} image={ogImageAbs} />
					<div class="prose">
						<slot />
					</div>
					<AuthorBio />
					<ServiceCTA variant="audit" />
					<EmailSubscribe
						eyebrow="Keep reading"
						headline="Want this kind of analysis weekly?"
						lede="One short email every Tuesday on AEO, GEO, AI Overviews, and what is actually changing in AI search."
						cta="Subscribe by Email"
					/>
				</div>
			</article>
		</main>

		{relatedPosts.length > 0 && (
			<section class="related-section" aria-label="Related articles">
				<h2 class="related-heading">Continue Reading</h2>
				<div class="related-grid">
					{relatedPosts.map((rp) => (
						<a href={`/blog/${rp.id}/`} class="related-card">
							{imageManifest[rp.id as keyof typeof imageManifest]?.hero && (
								<img
									class="related-thumb"
									src={(imageManifest[rp.id as keyof typeof imageManifest] as any).hero.src}
									alt={(imageManifest[rp.id as keyof typeof imageManifest] as any).hero.alt}
									loading="lazy"
								/>
							)}
							<span class="related-cat">{rp.data.category}</span>
							<h3 class="related-title">{rp.data.title}</h3>
						</a>
					))}
				</div>
			</section>
		)}

		<Footer />

		<script>
			function initToc() {
				const links = document.querySelectorAll('.toc-link');
				if (!links.length) return;

				const ids = Array.from(links).map((l) => l.getAttribute('href')?.slice(1)).filter(Boolean) as string[];
				const targets = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								links.forEach((l) => l.classList.remove('active'));
								const active = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
								if (active) active.classList.add('active');
							}
						});
					},
					{ rootMargin: '-80px 0px -66% 0px', threshold: 0 }
				);

				targets.forEach((t) => observer.observe(t));
			}
			initToc();
		</script>
	</body>
</html>
