---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GuideNav from '../components/GuideNav.astro';
import GuidePrevNext from '../components/GuidePrevNext.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

interface ChapterMeta {
	id: string;
	data: { title: string; chapter: number };
}

interface Props {
	title: string;
	description: string;
	deck: string;
	chapter: number;
	pubDate: Date;
	updatedDate?: Date;
	slug: string;
	headings?: Array<{ depth: number; slug: string; text: string }>;
	allChapters: ChapterMeta[];
}

const {
	title, description, deck, chapter, pubDate, updatedDate,
	slug, headings = [], allChapters,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const tocHeadings = headings.filter((h) => h.depth <= 3 && h.text !== 'Related reading' && h.text !== 'References' && h.text !== 'Go deeper');

const sorted = allChapters.filter((c) => c.data.chapter > 0).sort((a, b) => a.data.chapter - b.data.chapter);
const currentIndex = sorted.findIndex((c) => c.id === slug);
const prevChapter = currentIndex > 0 ? { slug: sorted[currentIndex - 1].id, title: sorted[currentIndex - 1].data.title, chapter: sorted[currentIndex - 1].data.chapter } : undefined;
const nextChapter = currentIndex < sorted.length - 1 ? { slug: sorted[currentIndex + 1].id, title: sorted[currentIndex + 1].data.title, chapter: sorted[currentIndex + 1].data.chapter } : undefined;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
		{ '@type': 'ListItem', position: 2, name: 'SEO Guide', item: `${SITE_URL}/seo/` },
		{ '@type': 'ListItem', position: 3, name: title },
	],
};

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Organization', name: SITE_AUTHOR },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: canonical,
	isPartOf: { '@type': 'WebPage', name: 'The Complete SEO Guide', url: `${SITE_URL}/seo/` },
};

const structuredData = [articleSchema, breadcrumbSchema];
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} | SEO Guide | ${SITE_TITLE}`}
			description={description}
			canonical={canonical}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={(updatedDate ?? pubDate).toISOString()}
			structuredData={structuredData}
		/>
		<style>
			.article-shell {
				width: min(1240px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 1.6rem 0 3rem;
				overflow-x: hidden;
			}

			.story-grid {
				display: grid;
				grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
				gap: 2rem;
				align-items: start;
			}

			.story-sidebar {
				position: sticky;
				top: 5rem;
				padding: 0.5rem 1.2rem 1rem 0;
				border-right: 1px solid var(--line);
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
			}

			.sidebar-divider {
				margin: 1rem 0;
				border: none;
				border-top: 1px solid var(--line);
			}

			.toc-nav { margin-bottom: 0; }

			.toc-title {
				font-size: 0.68rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: rgba(var(--ink), 0.42);
				margin: 0 0 0.6rem;
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
			}

			.toc-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.toc-item { margin: 0; }
			.toc-h3 { padding-left: 0.75rem; }

			.toc-link {
				display: block;
				padding: 0.28rem 0 0.28rem 0.6rem;
				font-size: 0.78rem;
				line-height: 1.35;
				color: rgba(var(--ink), 0.52);
				text-decoration: none;
				border-left: 2px solid transparent;
				transition: color 140ms ease, border-color 140ms ease;
			}

			.toc-link:hover { color: rgb(var(--ink)); }

			.toc-link.active {
				color: var(--signal-deep);
				border-left-color: var(--signal);
				font-weight: 700;
			}

			.story { max-width: 820px; }

			.story-header { margin-bottom: 1.75rem; }

			.breadcrumbs {
				margin: 0 0 1rem;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: rgba(var(--ink), 0.48);
			}

			.breadcrumbs a {
				text-decoration: none;
				color: inherit;
			}

			.breadcrumbs a:hover { color: var(--signal-deep); }

			.kicker {
				display: inline-flex;
				padding: 0.35rem 0.7rem;
				border-bottom: 1px solid rgba(217, 106, 58, 0.25);
				color: var(--signal-deep);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.story h1 {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: clamp(2rem, 3.8vw, 3rem);
				line-height: 1.06;
				letter-spacing: -0.025em;
				margin: 0.85rem 0 0.9rem;
				max-width: 18ch;
			}

			.deck {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: 1.02rem;
				line-height: 1.65;
				color: rgba(var(--ink), 0.7);
				max-width: 46rem;
				margin: 0 0 1rem;
			}

			.story-dates {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				align-items: center;
				color: rgba(var(--ink), 0.58);
				font-size: 0.82rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--line);
			}

			.prose {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: 1rem;
				line-height: 1.78;
				letter-spacing: -0.003em;
				max-width: 70ch;
			}

			.prose > :global(p:first-of-type) {
				font-size: 1.06rem;
				line-height: 1.78;
				color: rgba(var(--ink), 0.88);
			}

			.prose :global(h2) {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: clamp(1.45rem, 1.8vw, 1.9rem);
				line-height: 1.22;
				letter-spacing: -0.02em;
				margin-top: 3.2rem;
				margin-bottom: 0.9rem;
				padding-top: 1.2rem;
				border-top: 1px solid var(--line);
			}

			.prose :global(h2:first-child) {
				border-top: none;
				padding-top: 0;
			}

			.prose :global(h3) {
				font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
				font-size: 1.14rem;
				line-height: 1.35;
				letter-spacing: -0.01em;
				margin-top: 2.2rem;
				margin-bottom: 0.6rem;
			}

			.prose :global(h2), .prose :global(h3) { scroll-margin-top: 6rem; }

			.prose :global(table) {
				border-collapse: collapse;
				margin: 1.8rem 0;
				font-size: 0.94rem;
				display: block;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
			}

			.prose :global(th),
			.prose :global(td) {
				padding: 0.75rem 0.85rem;
				border: 1px solid rgba(var(--ink), 0.1);
			}

			.prose :global(th) {
				background: rgba(var(--ink), 0.04);
				font-weight: 700;
				text-align: left;
			}

			.prose :global(ul), .prose :global(ol) {
				padding-left: 1.1rem;
				margin: 1rem 0 1.4rem;
			}

			.prose :global(li) {
				padding-left: 0.2rem;
				margin-top: 0.45rem;
			}

			.prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(table), .prose :global(blockquote) {
				margin-bottom: 1.4rem;
			}

			.prose :global(blockquote) {
				font-size: 1rem;
				line-height: 1.75;
				margin: 2rem 0;
			}

			.prose :global(hr) {
				margin: 3rem 0;
				border: none;
				border-top: 1px solid var(--line);
			}

			.prose :global(img) { border-radius: 10px; }

			.prose :global(pre) { max-width: 100%; }

			@media (max-width: 900px) {
				.story-grid {
					grid-template-columns: 1fr;
				}

				.story-sidebar {
					position: static;
					order: -1;
					border-right: 0;
					padding-right: 0;
					max-height: none;
					border-bottom: 1px solid var(--line);
					padding-bottom: 1rem;
					margin-bottom: 0.5rem;
				}

				.sidebar-divider { display: none; }

				.toc-list {
					display: flex;
					flex-wrap: wrap;
					gap: 0.3rem 0.8rem;
				}

				.toc-h3 { display: none; }

				.toc-link {
					border-left: none;
					padding-left: 0;
					font-size: 0.74rem;
				}

				.story h1 { max-width: none; }
				.prose { max-width: none; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content" class="article-shell">
			<article class="story-grid">
				<aside class="story-sidebar" aria-label="Guide navigation">
					<GuideNav chapters={allChapters} currentSlug={slug} />
					{tocHeadings.length > 0 && (
						<>
							<hr class="sidebar-divider" />
							<nav class="toc-nav" aria-label="In this chapter">
								<p class="toc-title">In This Chapter</p>
								<ul class="toc-list">
									{tocHeadings.map((h) => (
										<li class:list={['toc-item', { 'toc-h3': h.depth === 3 }]}>
											<a href={`#${h.slug}`} class="toc-link">{h.text}</a>
										</li>
									))}
								</ul>
							</nav>
						</>
					)}
				</aside>
				<div class="story">
					<header class="story-header">
						<p class="breadcrumbs"><a href="/">Home</a> / <a href="/seo/">SEO Guide</a> / Chapter {chapter}</p>
						<p class="kicker">Chapter {chapter} of 12</p>
						<h1>{title}</h1>
						<p class="deck">{deck}</p>
						<div class="story-dates">
							<span>Published <FormattedDate date={pubDate} /></span>
							{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
						</div>
					</header>
					<div class="prose">
						<slot />
					</div>
					<GuidePrevNext prev={prevChapter} next={nextChapter} />
				</div>
			</article>
		</main>
		<Footer />

		<script>
			function initToc() {
				const links = document.querySelectorAll('.toc-link');
				if (!links.length) return;

				const ids = Array.from(links).map((l) => l.getAttribute('href')?.slice(1)).filter(Boolean) as string[];
				const targets = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								links.forEach((l) => l.classList.remove('active'));
								const active = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
								if (active) active.classList.add('active');
							}
						});
					},
					{ rootMargin: '-80px 0px -66% 0px', threshold: 0 }
				);

				targets.forEach((t) => observer.observe(t));
			}
			initToc();
		</script>
	</body>
</html>
