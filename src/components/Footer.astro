<style>
	.site-footer {
		padding: 4rem 0 0;
		border-top: 1px solid rgba(var(--ink), 0.1);
		background:
			linear-gradient(180deg, rgba(var(--ink), 0.02), rgba(var(--ink), 0.05)),
			rgb(var(--paper));
	}

	.footer-inner {
		width: min(1200px, calc(100% - 2rem));
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.6fr 1fr 1.2fr 1fr;
		gap: 3rem;
		padding-bottom: 3rem;
	}

	/* Brand column */
	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-mark {
		margin: 0;
		font-family: 'Georgia', 'Iowan Old Style', serif;
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: rgb(var(--ink));
	}

	.footer-tagline {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: rgba(var(--ink), 0.65);
		max-width: 26ch;
	}

	/* Social links */
	.footer-social {
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-social a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 600;
		color: rgba(var(--ink), 0.7);
		transition: color 0.15s ease;
	}

	.footer-social a:hover,
	.footer-social a:focus-visible {
		color: var(--signal);
	}

	.footer-social svg {
		flex-shrink: 0;
		opacity: 0.8;
	}

	/* Nav columns */
	.footer-col h3.footer-heading {
		margin: 0 0 1rem;
		font-family: 'Georgia', serif;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(var(--ink), 0.4);
	}

	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.footer-col a {
		text-decoration: none;
		font-size: 0.875rem;
		color: rgba(var(--ink), 0.72);
		transition: color 0.15s ease;
	}

	.footer-col a:hover,
	.footer-col a:focus-visible {
		color: var(--signal);
	}

	/* Bottom bar */
	.footer-bottom {
		width: min(1200px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.25rem 0 1.5rem;
		border-top: 1px solid rgba(var(--ink), 0.08);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-copy {
		margin: 0;
		font-size: 0.8rem;
		color: rgba(var(--ink), 0.45);
	}

	.footer-legal {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 1.5rem;
	}

	.footer-legal a {
		text-decoration: none;
		font-size: 0.8rem;
		color: rgba(var(--ink), 0.45);
		transition: color 0.15s ease;
	}

	.footer-legal a:hover,
	.footer-legal a:focus-visible {
		color: var(--signal);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}

		.footer-tagline {
			max-width: 40ch;
		}

		.footer-social {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.75rem 1.5rem;
		}
	}

	@media (max-width: 560px) {
		.site-footer {
			padding-top: 3rem;
		}

		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-brand {
			grid-column: auto;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}
	}
</style>
