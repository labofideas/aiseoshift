---
import { AUTHOR_NAME, AUTHOR_IMAGE, AUTHOR_PROFILE_URL, AUTHOR_SAME_AS } from '../consts';

// A visible author byline + bio block for the end of every post.
// Reinforces the Person schema already attributed sitewide (E-E-A-T).
const linkedin = AUTHOR_SAME_AS.find((u) => u.includes('linkedin.com'));
const x = AUTHOR_SAME_AS.find((u) => u.includes('x.com') || u.includes('twitter.com'));
---

<aside class="author-bio" aria-label="About the author">
	<img class="author-bio-avatar" src={AUTHOR_IMAGE} alt={AUTHOR_NAME} width="72" height="72" loading="lazy" decoding="async" />
	<div class="author-bio-body">
		<p class="author-bio-eyebrow">Written by</p>
		<p class="author-bio-name"><a href={AUTHOR_PROFILE_URL} rel="author">{AUTHOR_NAME}</a> &middot; <span>SEO &amp; AI search expert</span></p>
		<p class="author-bio-text">
			Shashank Dubey is the founder of Wbcom Designs and the lead writer at AISEOShift. Over a decade in SEO and WordPress, he now helps brands become the source AI engines trust and cite, with a focus on AEO, GEO, and AI visibility in trust-sensitive industries.
		</p>
		<p class="author-bio-links">
			<a href={AUTHOR_PROFILE_URL} rel="author">More from Shashank &rarr;</a>
			{linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn</a>}
			{x && <a href={x} target="_blank" rel="noopener noreferrer me">X</a>}
		</p>
	</div>
</aside>

<style>
	.author-bio {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr);
		gap: var(--space-5);
		align-items: start;
		margin: var(--space-7) 0 var(--space-6);
		padding: var(--space-6);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: rgb(var(--paper-strong));
	}
	.author-bio-avatar {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		object-fit: cover;
		border: 1px solid var(--line-strong);
	}
	.author-bio-body { min-width: 0; }
	.author-bio-eyebrow {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.author-bio-name {
		margin: 0.2rem 0 0.5rem;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: rgb(var(--ink));
	}
	.author-bio-name a { color: inherit; text-decoration: none; }
	.author-bio-name a:hover { color: var(--signal-deep); }
	.author-bio-name span { font-weight: 400; color: var(--ink-muted); }
	.author-bio-text {
		margin: 0 0 0.75rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgba(var(--ink), 0.82);
	}
	.author-bio-links {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		font-size: 0.88rem;
		font-weight: 600;
	}
	.author-bio-links a { color: var(--signal-deep); text-decoration: none; }
	.author-bio-links a:hover { text-decoration: underline; }
	@media (max-width: 520px) {
		.author-bio { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-5); }
	}
</style>
