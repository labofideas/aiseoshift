---
interface Props {
	title: string;
	url: string;
	tags?: string[];
	description?: string;
	image?: string;
}

const { title, url, tags = [], description = '', image } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

// Twitter hashtags param expects comma-separated words (no hyphens, no #)
const twitterHashtags = tags
	.slice(0, 4)
	.map(t => t.replace(/-/g, ''))
	.join(',');

const hashtagString = tags
	.slice(0, 5)
	.map(t => `#${t.replace(/-/g, '')}`)
	.join(' ');

const twitterText = encodeURIComponent(title);
const twitterUrl = `https://x.com/intent/tweet?url=${encodedUrl}&text=${twitterText}&hashtags=${twitterHashtags}`;

const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;

const bskyText = encodeURIComponent(`${title}\n\n${url}\n\n${hashtagString}`);
const bskyUrl = `https://bsky.app/intent/compose?text=${bskyText}`;

const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;

// Pinterest: auto-pick heading + description, always append #ai #seo
const pinDescription = encodeURIComponent(
	[title, description].filter(Boolean).join(' — ') + ' #ai #seo'
);
const pinterestUrl = `https://pinterest.com/pin/create/button/?url=${encodedUrl}${image ? `&media=${encodeURIComponent(image)}` : ''}&description=${pinDescription}`;
---

<div class="social-share">
	<a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-x" aria-label="Share on X">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
		</svg>
		Post
	</a>
	<a href={linkedInUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-li" aria-label="Share on LinkedIn">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
		</svg>
		Share
	</a>
	<a href={bskyUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-bsky" aria-label="Share on Bluesky">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.204-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
		</svg>
		Post
	</a>
	<a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-fb" aria-label="Share on Facebook">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
		</svg>
		Share
	</a>
	<a href={pinterestUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-pin" aria-label="Pin on Pinterest">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
		</svg>
		Pin
	</a>
</div>

<style>
	.social-share {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		flex-wrap: wrap;
	}

	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 1.1rem;
		border-radius: 2rem;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition: opacity 140ms ease, transform 100ms ease;
		cursor: pointer;
		font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
	}

	.share-btn:hover {
		opacity: 0.88;
		transform: translateY(-1px);
	}

	.share-x {
		background: rgb(var(--ink));
		color: rgb(var(--paper));
	}

	.share-li {
		background: #0a66c2;
		color: #fff;
	}

	.share-bsky {
		background: #0085ff;
		color: #fff;
	}

	.share-fb {
		background: #1877f2;
		color: #fff;
	}

	.share-pin {
		background: #e60023;
		color: #fff;
	}
</style>
