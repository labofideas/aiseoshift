---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<div class="upvote-wrapper" data-slug={slug}>
	<button class="upvote-btn" aria-label="Upvote this post" disabled>
		<svg class="upvote-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M7 10v12" /><path d="M15 5.88L14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88z" />
		</svg>
		<span class="upvote-label">Upvote</span>
		<span class="upvote-count">—</span>
	</button>
	<p class="upvote-summary" aria-live="polite"></p>
</div>

<script>
	function initUpvote() {
		const wrapper = document.querySelector('.upvote-wrapper') as HTMLElement | null;
		if (!wrapper) return;

		const slug = wrapper.dataset.slug!;
		const btn = wrapper.querySelector('.upvote-btn') as HTMLButtonElement;
		const countEl = wrapper.querySelector('.upvote-count') as HTMLElement;
		const summaryEl = wrapper.querySelector('.upvote-summary') as HTMLElement;

		const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
		const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

		if (!SUPABASE_URL || !SUPABASE_KEY) {
			btn.disabled = false;
			countEl.textContent = '0';
			return;
		}

		const headers: Record<string, string> = {
			apikey: SUPABASE_KEY,
			Authorization: `Bearer ${SUPABASE_KEY}`,
			'Content-Type': 'application/json',
			Prefer: 'return=minimal',
		};

		function getVisitorId(): string {
			const key = 'aiseoshift_vid';
			let vid = localStorage.getItem(key);
			if (!vid) {
				vid = crypto.randomUUID();
				localStorage.setItem(key, vid);
			}
			return vid;
		}

		const visitorId = getVisitorId();
		let hasVoted = localStorage.getItem(`upvote_${slug}`) === '1';

		async function fetchCount() {
			try {
				const res = await fetch(
					`${SUPABASE_URL}/rest/v1/upvotes?post_slug=eq.${encodeURIComponent(slug)}&select=id`,
					{ headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` } }
				);
				if (!res.ok) throw new Error();
				const data = await res.json();
				return data.length;
			} catch {
				return 0;
			}
		}

		async function render() {
			const count = await fetchCount();
			countEl.textContent = count.toLocaleString();
			btn.classList.toggle('voted', hasVoted);
			btn.disabled = false;
			if (count > 0) {
				summaryEl.textContent = `${count.toLocaleString()} visitor${count === 1 ? '' : 's'} upvoted this post.`;
			} else {
				summaryEl.textContent = 'Be the first to upvote this post.';
			}
		}

		btn.addEventListener('click', async () => {
			btn.disabled = true;

			try {
				if (hasVoted) {
					await fetch(
						`${SUPABASE_URL}/rest/v1/upvotes?post_slug=eq.${encodeURIComponent(slug)}&visitor_id=eq.${encodeURIComponent(visitorId)}`,
						{ method: 'DELETE', headers }
					);
					hasVoted = false;
					localStorage.removeItem(`upvote_${slug}`);
				} else {
					await fetch(`${SUPABASE_URL}/rest/v1/upvotes`, {
						method: 'POST',
						headers,
						body: JSON.stringify({ post_slug: slug, visitor_id: visitorId }),
					});
					hasVoted = true;
					localStorage.setItem(`upvote_${slug}`, '1');
				}
			} catch {
				// silently fail
			}

			await render();
		});

		render();
	}
	initUpvote();
</script>

<style>
	.upvote-wrapper {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.upvote-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1.1rem;
		border: 1.5px solid var(--line);
		border-radius: 2rem;
		background: transparent;
		color: rgba(var(--ink), 0.72);
		font-size: 0.82rem;
		font-weight: 700;
		font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
		cursor: pointer;
		transition: all 140ms ease;
	}

	.upvote-btn:hover:not(:disabled) {
		border-color: var(--signal);
		color: var(--signal-deep);
		transform: translateY(-1px);
	}

	.upvote-btn:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.upvote-btn.voted {
		background: var(--signal);
		border-color: var(--signal);
		color: #fff;
	}

	.upvote-btn.voted:hover:not(:disabled) {
		opacity: 0.88;
		color: #fff;
	}

	.upvote-icon {
		flex-shrink: 0;
	}

	.upvote-count {
		padding-left: 0.35rem;
		border-left: 1px solid currentColor;
		opacity: 0.7;
		min-width: 1.2em;
	}

	.upvote-summary {
		margin: 0;
		font-size: 0.82rem;
		color: rgba(var(--ink), 0.52);
	}
</style>
