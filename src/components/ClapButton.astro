---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<div class="clap-wrapper" data-slug={slug}>
	<button class="clap-btn" aria-label="Clap for this post" type="button">
		<span class="clap-burst" aria-hidden="true"></span>
		<svg class="clap-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M11 11.5V6.5a1.5 1.5 0 0 1 3 0v5" />
			<path d="M14 10.5V5a1.5 1.5 0 0 1 3 0v6.5" />
			<path d="M17 11.5V7a1.5 1.5 0 0 1 3 0v6a7 7 0 0 1-7 7h-1.5a6 6 0 0 1-5.16-2.93l-2.1-3.6a1.5 1.5 0 0 1 2.54-1.6L9 12.5" />
			<path d="M11 11.5V4.5a1.5 1.5 0 0 0-3 0v8" />
		</svg>
	</button>
	<span class="clap-count" aria-live="polite">—</span>
</div>

<script>
	function initClaps() {
		const wrapper = document.querySelector('.clap-wrapper') as HTMLElement | null;
		if (!wrapper) return;

		const slug = wrapper.dataset.slug!;
		const btn = wrapper.querySelector('.clap-btn') as HTMLButtonElement;
		const burst = wrapper.querySelector('.clap-burst') as HTMLElement;
		const countEl = wrapper.querySelector('.clap-count') as HTMLElement;
		const headerCount = document.querySelector('.header-upvote-count') as HTMLElement | null;

		const MAX_PER_VISITOR = 50;
		const localKey = `claps_mine_${slug}`;

		let serverCount = 0; // last known total from the server
		let mine = Math.min(MAX_PER_VISITOR, Number(localStorage.getItem(localKey)) || 0);
		let pending = 0; // claps tapped but not yet sent
		let displayed = 0;
		let sendTimer: ReturnType<typeof setTimeout> | null = null;

		function render() {
			displayed = serverCount + pending;
			countEl.textContent = displayed.toLocaleString();
			if (headerCount) headerCount.textContent = displayed.toLocaleString();
			btn.classList.toggle('clapped', mine > 0);
			if (mine >= MAX_PER_VISITOR) btn.classList.add('maxed');
		}

		async function fetchCount() {
			try {
				const res = await fetch(`/api/claps?slug=${encodeURIComponent(slug)}`);
				if (!res.ok) return;
				const data = await res.json();
				serverCount = Number(data.count) || 0;
				render();
			} catch {
				/* leave at 0 */
			}
		}

		async function flush() {
			if (pending <= 0) return;
			const amount = pending;
			pending = 0;
			try {
				const res = await fetch('/api/claps', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ slug, claps: amount }),
				});
				if (res.ok) {
					const data = await res.json();
					if (data.configured) {
						serverCount = Number(data.count) || serverCount + amount;
					} else {
						// backend not wired yet: keep an optimistic local total
						serverCount += amount;
					}
				} else {
					serverCount += amount; // optimistic fallback
				}
			} catch {
				serverCount += amount; // optimistic fallback
			}
			render();
		}

		btn.addEventListener('click', () => {
			if (mine >= MAX_PER_VISITOR) return;
			mine += 1;
			pending += 1;
			localStorage.setItem(localKey, String(mine));

			// pop animation
			btn.classList.remove('pop');
			void btn.offsetWidth;
			btn.classList.add('pop');
			burst.classList.remove('go');
			void burst.offsetWidth;
			burst.classList.add('go');

			render();

			if (sendTimer) clearTimeout(sendTimer);
			sendTimer = setTimeout(flush, 650);
		});

		// flush any unsent claps if the user leaves quickly
		window.addEventListener('pagehide', () => {
			if (pending > 0 && navigator.sendBeacon) {
				navigator.sendBeacon('/api/claps', JSON.stringify({ slug, claps: pending }));
				pending = 0;
			}
		});

		render();
		fetchCount();
	}
	initClaps();
</script>

<style>
	.clap-wrapper {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.clap-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		border: 1.5px solid var(--line);
		background: transparent;
		color: rgba(var(--ink), 0.7);
		cursor: pointer;
		transition: border-color 140ms ease, color 140ms ease, transform 100ms ease;
	}

	.clap-btn:hover {
		border-color: var(--signal);
		color: var(--signal-deep);
		transform: translateY(-1px);
	}

	.clap-btn.clapped {
		border-color: var(--signal-deep);
		color: var(--signal-deep);
	}

	.clap-btn.maxed {
		background: var(--signal-deep);
		border-color: var(--signal-deep);
		color: #fff;
	}

	.clap-btn.pop {
		animation: clap-pop 280ms ease;
	}

	@keyframes clap-pop {
		0% { transform: scale(1); }
		40% { transform: scale(1.18); }
		100% { transform: scale(1); }
	}

	.clap-burst {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		pointer-events: none;
	}

	.clap-burst.go::after {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		border: 2px solid var(--signal);
		animation: clap-ring 480ms ease-out forwards;
	}

	@keyframes clap-ring {
		0% { transform: scale(0.8); opacity: 0.7; }
		100% { transform: scale(1.7); opacity: 0; }
	}

	.clap-count {
		font-size: 0.95rem;
		font-weight: 700;
		font-family: 'Atkinson', 'Trebuchet MS', sans-serif;
		color: rgba(var(--ink), 0.82);
		min-width: 1.4em;
	}

	@media (prefers-reduced-motion: reduce) {
		.clap-btn.pop { animation: none; }
		.clap-burst.go::after { animation: none; }
	}
</style>
