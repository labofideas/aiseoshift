---
import EmailSubscribe from './EmailSubscribe.astro';
import SocialShare from './SocialShare.astro';
import UpvoteButton from './UpvoteButton.astro';

interface Props {
	title: string;
	url: string;
	slug: string;
	tags?: string[];
}

const { title, url, slug, tags = [] } = Astro.props;
---

<aside class="engagement" aria-label="Post engagement">
	<div class="engagement-row">
		<UpvoteButton slug={slug} />
		<SocialShare title={title} url={url} tags={tags} />
	</div>
	<div class="engagement-subscribe">
		<EmailSubscribe />
	</div>
</aside>

<style>
	.engagement {
		margin-top: 3rem;
		padding: 1.8rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.engagement-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.engagement-subscribe {
		margin-top: 1.4rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--line);
	}

	@media (max-width: 520px) {
		.engagement-row {
			flex-direction: column;
		}
	}
</style>
