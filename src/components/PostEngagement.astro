---
import SocialShare from './SocialShare.astro';
import ClapButton from './ClapButton.astro';

interface Props {
	title: string;
	url: string;
	slug: string;
	tags?: string[];
	description?: string;
	image?: string;
}

const { title, url, slug, tags = [], description, image } = Astro.props;
---

<aside class="engagement" aria-label="Post engagement">
	<div class="engagement-row">
		<ClapButton slug={slug} />
		<SocialShare title={title} url={url} tags={tags} description={description} image={image} />
	</div>
</aside>

<style>
	.engagement {
		margin: 0 0 1.6rem;
		padding: 1rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.engagement-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	@media (max-width: 520px) {
		.engagement-row {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
