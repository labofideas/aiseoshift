---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import {
	SITE_TITLE,
	SITE_URL,
	SITE_DESCRIPTION,
	SITE_LOGO,
	SITE_EMAIL,
	SITE_SAME_AS,
	AUTHOR_NAME,
	AUTHOR_ROLE,
	AUTHOR_BIO_SHORT,
	AUTHOR_IMAGE,
	AUTHOR_PROFILE_URL,
	AUTHOR_SAME_AS,
} from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	imageAlt?: string;
	canonical?: string;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	articleSection?: string;
	articleTags?: string[];
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
	preloadHero?: string;
}

const canonicalURL = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

// Keep the SERP <title> from being truncated: drop the " | AISEOShift" brand
// suffix when the full title runs long (social og/twitter titles keep it).
const brandSuffix = ` | ${SITE_TITLE}`;
const seoTitle =
	Astro.props.title.length > 60 && Astro.props.title.endsWith(brandSuffix)
		? Astro.props.title.slice(0, -brandSuffix.length)
		: Astro.props.title;

// Compute a per-page OG card slug from the request path.
// '/' -> 'index'; '/seo/' -> 'seo'; '/blog/foo/' -> 'blog/foo'.
const ogSlug = (() => {
	const trimmed = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
	return trimmed === '' ? 'index' : trimmed;
})();
const defaultOgImage = `/og/${ogSlug}.png`;

const {
	title,
	description,
	image = defaultOgImage,
	imageAlt = `${SITE_TITLE} social preview`,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	articleSection,
	articleTags,
	structuredData,
	preloadHero,
} = Astro.props;

const imageUrl =
	typeof image === 'string' ? new URL(image, Astro.site).toString() : new URL(image.src, Astro.site).toString();
const imageWidth = typeof image === 'string' ? 1200 : image.width;
const imageHeight = typeof image === 'string' ? 630 : image.height;

// Auto-generate a BreadcrumbList for any non-home page that does not already
// supply one (blog posts and the SEO guide bring their own). Centralizes
// breadcrumb schema sitewide without editing every page template.
const SEGMENT_LABELS: Record<string, string> = {
	'ai-seo-services': 'AI SEO Services',
	seo: 'SEO Guide',
	blog: 'Blog',
	tools: 'AI SEO Tools',
	'ai-seo-tools': 'AI SEO Tools',
	glossary: 'Glossary',
	authors: 'Authors',
	geo: 'GEO',
	aeo: 'AEO',
};
const cleanTitle = (t: string) => t.replace(/\s*\|\s*AISEOShift\s*$/i, '').trim();
const labelFor = (seg: string) =>
	SEGMENT_LABELS[seg] ?? seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const sdArray = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
const hasBreadcrumb = sdArray.some(
	(o: any) =>
		o &&
		(o['@type'] === 'BreadcrumbList' ||
			(Array.isArray(o['@graph']) && o['@graph'].some((g: any) => g?.['@type'] === 'BreadcrumbList')))
);
const segs = Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const autoBreadcrumb =
	segs.length > 0 && !hasBreadcrumb
		? {
				'@type': 'BreadcrumbList',
				'@id': `${canonicalURL}#breadcrumb`,
				itemListElement: [
					{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
					...segs.map((seg, i) => {
						const isLast = i === segs.length - 1;
						const url = `${SITE_URL}/${segs.slice(0, i + 1).join('/')}/`;
						return {
							'@type': 'ListItem',
							position: i + 2,
							name: isLast ? cleanTitle(title) : labelFor(seg),
							item: url,
						};
					}),
				],
		  }
		: null;

const globalGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${SITE_URL}/#person`,
			name: AUTHOR_NAME,
			url: AUTHOR_PROFILE_URL,
			image: {
				'@type': 'ImageObject',
				url: AUTHOR_IMAGE,
				caption: AUTHOR_NAME,
			},
			jobTitle: AUTHOR_ROLE,
			description: AUTHOR_BIO_SHORT,
			sameAs: AUTHOR_SAME_AS,
			worksFor: { '@id': `${SITE_URL}/#organization` },
		},
		{
			'@type': 'Organization',
			'@id': `${SITE_URL}/#organization`,
			name: SITE_TITLE,
			alternateName: 'AI SEO Shift',
			url: SITE_URL,
			logo: {
				'@type': 'ImageObject',
				'@id': `${SITE_URL}/#logo`,
				url: SITE_LOGO,
				contentUrl: SITE_LOGO,
				width: 512,
				height: 512,
				caption: SITE_TITLE,
			},
			description: SITE_DESCRIPTION,
			founder: { '@id': `${SITE_URL}/#person` },
			contactPoint: {
				'@type': 'ContactPoint',
				email: SITE_EMAIL,
				contactType: 'customer service',
			},
			sameAs: SITE_SAME_AS,
		},
		{
			'@type': 'WebSite',
			'@id': `${SITE_URL}/#website`,
			url: SITE_URL,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			publisher: { '@id': `${SITE_URL}/#organization` },
			inLanguage: 'en-US',
		},
	],
};
if (autoBreadcrumb) (globalGraph['@graph'] as any[]).push(autoBreadcrumb);
---

<script is:inline>
(function(){var t=localStorage.getItem('theme');if(t){document.documentElement.setAttribute('data-theme',t)}else if(window.matchMedia('(prefers-color-scheme:dark)').matches){document.documentElement.setAttribute('data-theme','dark')}})();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />

<link rel="preload" href="/fonts/atkinson-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" />
{preloadHero && <link rel="preload" href={preloadHero} as="image" fetchpriority="high" />}

<link rel="canonical" href={canonicalURL} />

<title>{seoTitle}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={SITE_TITLE} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && <meta property="article:author" content={AUTHOR_PROFILE_URL} />}
{articleSection && <meta property="article:section" content={articleSection} />}
{articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@ai_seo_shift" />
<meta name="twitter:creator" content="@ai_seo_shift" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(globalGraph)} />
{
	structuredData && (
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	)
}

<script async src="https://www.googletagmanager.com/gtag/js?id=G-G2XXCX5GKK" is:inline></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-G2XXCX5GKK');
</script>
