{
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "name": "aiseoshift-com",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiseoshift-com-claps",
      "database_id": "9c166115-c1ba-4ccd-bfb5-1ff66cc41924"
    }
  ],
  // Astro session store. Pinned so CI deploys never auto-provision a new namespace.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "5dc89cd3973c4e0c82d324d9031fe8af"
    }
  ],
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "TOOL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "DEAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "DEAL_EMAIL",
      "destination_address": "shashank@wbcomdesigns.com"
    }
  ]
}
